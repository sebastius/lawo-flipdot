      0052F7 A4               [48]  641         mul     ab
      0052F8 FB               [12]  642         mov     r3,a
      0052F9 12r54r5D         [24]  643         lcall   getdig
      0052FC 40 46            [24]  644         jc      px_end
      0052FE 2B               [12]  645         add     a,r3
      0052FF FB               [12]  646         mov     r3,a                    ; y
      005300 E0               [24]  647         movx    a,@dptr
      005301 A3               [24]  648         inc     dptr
      005302 64 30            [12]  649         xrl     a,#0x30                 ; '0' -> 0, '1' -> 1
      005304 FA               [12]  650         mov     r2,a
      005305 C3               [12]  651         clr     c
      005306 94 02            [12]  652         subb    a,#2
      005308 50 3A            [24]  653         jnc     px_end
      00530A C0 82            [24]  654         push    dpl
      00530C C0 83            [24]  655         push    dph
