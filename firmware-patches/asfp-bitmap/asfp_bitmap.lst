      0052AA 90 05 5D         [24]  597         mov     dptr,#HEIGHT
      0052AD E0               [24]  598         movx    a,@dptr
      0052AE F9               [12]  599         mov     r1,a
      0052AF EB               [12]  600         mov     a,r3
      0052B0 C3               [12]  601         clr     c
      0052B1 99               [12]  602         subb    a,r1
      0052B2 50 21            [24]  603         jnc     px_skip                 ; y >= hoogte
      0052B4 7E 0E            [12]  604         mov     r6,#>SH
