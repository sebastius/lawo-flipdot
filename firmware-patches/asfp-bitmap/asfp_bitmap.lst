                                    681 ; ---------- bitmapmodus starten: schaduw := getoond beeld ----------
                                    682 ; blokkopie FB_OLD -> SH (2 * breedte bytes): bron via DPTR, doel via P2:R0 (MOVX @R0)
      00531B                        683 bm_enter:
      00531B 90 0E 00         [24]  684         mov     dptr,#BM_FLAG
      00531E E0               [24]  685         movx    a,@dptr
      00531F 70 2D            [24]  686         jnz     be_done
      005321 74 01            [12]  687         mov     a,#1
      005323 F0               [24]  688         movx    @dptr,a
      005324 90 05 5C         [24]  689         mov     dptr,#WIDTH
      005327 E0               [24]  690         movx    a,@dptr
      005328 60 24            [24]  691         jz      be_done
      00532A 25 E0            [12]  692         add     a,acc
      00532C FB               [12]  693         mov     r3,a                    ; aantal bytes, laag
      00532D E4               [12]  694         clr     a
      00532E 33               [12]  695         rlc     a
      00532F FA               [12]  696         mov     r2,a                    ; aantal bytes, hoog
      005330 C0 A0            [24]  697         push    P2
      005332 75 A0 0E         [24]  698         mov     P2,#>SH
      005335 78 10            [12]  699         mov     r0,#<SH
      005337 90 07 AE         [24]  700         mov     dptr,#FB_OLD
      00533A                        701 be_copy:
      00533A E0               [24]  702         movx    a,@dptr
      00533B F2               [24]  703         movx    @r0,a
      00533C A3               [24]  704         inc     dptr
