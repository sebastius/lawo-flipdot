      0053FC 75 F0 64         [24]  867         mov     b,#100
      0053FF A4               [48]  868         mul     ab
      005400 F8               [12]  869         mov     r0,a
      005401 E5 F0            [12]  870         mov     a,b
      005403 70 14            [24]  871         jnz     gn_bad
      005405 12r53rE9         [24]  872         lcall   getdig
      005408 40 0F            [24]  873         jc      gn_bad
      00540A 75 F0 0A         [24]  874         mov     b,#10
      00540D A4               [48]  875         mul     ab
      00540E 28               [12]  876         add     a,r0
      00540F 40 08            [24]  877         jc      gn_bad
      005411 F8               [12]  878         mov     r0,a
