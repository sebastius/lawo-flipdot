      0052DF FB               [12]  624         mov     r3,a
      0052E0 12r54r15         [24]  625         lcall   gethex
      0052E3 40 2F            [24]  626         jc      bm_end
      0052E5 4B               [12]  627         orl     a,r3
      0052E6 FB               [12]  628         mov     r3,a                    ; hoge byte (rij 8-15)
      0052E7 12r54r15         [24]  629         lcall   gethex
      0052EA 40 28            [24]  630         jc      bm_end
      0052EC C4               [12]  631         swap    a
      0052ED FA               [12]  632         mov     r2,a
      0052EE 12r54r15         [24]  633         lcall   gethex
      0052F1 40 21            [24]  634         jc      bm_end
      0052F3 4A               [12]  635         orl     a,r2
      0052F4 FA               [12]  636         mov     r2,a                    ; lage byte (rij 0-7)
      0052F5 C0 82            [24]  637         push    dpl
      0052F7 C0 83            [24]  638         push    dph
      0052F9 12r53rCC         [24]  639         lcall   x_lt_width
      0052FC 50 0F            [24]  640         jnc     bm_skip
      0052FE 7E 0E            [12]  641         mov     r6,#>SH
      005300 7F 10            [12]  642         mov     r7,#<SH
      005302 12r53rD5         [24]  643         lcall   colptr
      005305 EB               [12]  644         mov     a,r3
      005306 F0               [24]  645         movx    @dptr,a
      005307 A3               [24]  646         inc     dptr
      005308 EA               [12]  647         mov     a,r2
      005309 F0               [24]  648         movx    @dptr,a
      00530A 12r53rAA         [24]  649         lcall   mark_dirty
      00530D                        650 bm_skip:
      00530D D0 83            [24]  651         pop     dph
      00530F D0 82            [24]  652         pop     dpl
      005311 0C               [12]  653         inc     r4
      005312 80 C0            [24]  654         sjmp    bm_loop
      005314                        655 bm_end:
      005314 22               [24]  656         ret
