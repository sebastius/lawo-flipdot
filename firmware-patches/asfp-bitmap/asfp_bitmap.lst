      0053D6 2C               [12]  815         add     a,r4
      0053D7 F8               [12]  816         mov     r0,a
      0053D8 E4               [12]  817         clr     a
      0053D9 33               [12]  818         rlc     a
      0053DA C8               [12]  819         xch     a,r0                    ; a = laag, r0 = hoog
      0053DB 2F               [12]  820         add     a,r7
      0053DC F5 82            [12]  821         mov     dpl,a
      0053DE E8               [12]  822         mov     a,r0
      0053DF 3E               [12]  823         addc    a,r6
      0053E0 F5 83            [12]  824         mov     dph,a
      0053E2 22               [24]  825         ret
