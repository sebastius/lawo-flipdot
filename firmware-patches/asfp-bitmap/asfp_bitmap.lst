      0052F9 12r54r20         [24]  649         lcall   gethex
      0052FC 40 21            [24]  650         jc      bm_end
      0052FE 4A               [12]  651         orl     a,r2
      0052FF FA               [12]  652         mov     r2,a                    ; lage byte (rij 0-7)
      005300 C0 82            [24]  653         push    dpl
      005302 C0 83            [24]  654         push    dph
      005304 12r53rD7         [24]  655         lcall   x_lt_width
      005307 50 0F            [24]  656         jnc     bm_skip
      005309 7E 0E            [12]  657         mov     r6,#>SH
      00530B 7F 10            [12]  658         mov     r7,#<SH
      00530D 12r53rE0         [24]  659         lcall   colptr
      005310 EB               [12]  660         mov     a,r3
      005311 F0               [24]  661         movx    @dptr,a
      005312 A3               [24]  662         inc     dptr
      005313 EA               [12]  663         mov     a,r2
      005314 F0               [24]  664         movx    @dptr,a
      005315 12r53rB5         [24]  665         lcall   mark_dirty
      005318                        666 bm_skip:
      005318 D0 83            [24]  667         pop     dph
      00531A D0 82            [24]  668         pop     dpl
      00531C 0C               [12]  669         inc     r4
      00531D 80 C0            [24]  670         sjmp    bm_loop
