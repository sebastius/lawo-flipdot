      0053AF EC               [12]  776         mov     a,r4
      0053B0 C3               [12]  777         clr     c
      0053B1 98               [12]  778         subb    a,r0
      0053B2 50 02            [24]  779         jnc     md_max                  ; r4 >= min
      0053B4 EC               [12]  780         mov     a,r4
      0053B5 F0               [24]  781         movx    @dptr,a
      0053B6 A3               [24]  782 md_max: inc     dptr                    ; DIRTY_MAX
      0053B7 E0               [24]  783         movx    a,@dptr
      0053B8 C3               [12]  784         clr     c
      0053B9 9C               [12]  785         subb    a,r4
      0053BA 50 02            [24]  786         jnc     md_end                  ; max >= r4
      0053BC EC               [12]  787         mov     a,r4
      0053BD F0               [24]  788         movx    @dptr,a
      0053BE 22               [24]  789 md_end: ret
                                    790 
                                    791 ; C = 1 als r4 <= DIRTY_MAX en r4 < breedte
      0053BF                        792 in_range:
      0053BF 90 0E 06         [24]  793         mov     dptr,#DIRTY_MAX
      0053C2 E0               [24]  794         movx    a,@dptr
      0053C3 C3               [12]  795         clr     c
      0053C4 9C               [12]  796         subb    a,r4
      0053C5 40 03            [24]  797         jc      ir_no
      0053C7 02r53rCC         [24]  798         ljmp    x_lt_width
      0053CA C3               [12]  799 ir_no:  clr     c
      0053CB 22               [24]  800         ret
                                    801 
                                    802 ; C = 1 als r4 < breedte (gebruikt dptr, r1)
      0053CC                        803 x_lt_width:
      0053CC 90 05 5C         [24]  804         mov     dptr,#WIDTH
