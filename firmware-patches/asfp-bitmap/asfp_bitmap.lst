                                    879 ; hexteken op @dptr -> a (0..15), dptr++; C = 1 als ongeldig
      005420                        880 gethex:
      005420 E0               [24]  881         movx    a,@dptr
      005421 A3               [24]  882         inc     dptr
      005422 C3               [12]  883         clr     c
      005423 94 30            [12]  884         subb    a,#0x30
      005425 40 1D            [24]  885         jc      gh_bad
      005427 B4 0A 00         [24]  886         cjne    a,#10,gh_c1
      00542A 40 16            [24]  887 gh_c1:  jc      gh_ok                   ; '0'..'9'
      00542C C3               [12]  888         clr     c
      00542D 94 11            [12]  889         subb    a,#17                   ; 'A' -> 0
      00542F 40 13            [24]  890         jc      gh_bad
      005431 B4 06 00         [24]  891         cjne    a,#6,gh_c2
      005434 40 0A            [24]  892 gh_c2:  jc      gh_let                  ; 'A'..'F'
      005436 C3               [12]  893         clr     c
      005437 94 20            [12]  894         subb    a,#32                   ; 'a' -> 0
      005439 40 09            [24]  895         jc      gh_bad
      00543B B4 06 00         [24]  896         cjne    a,#6,gh_c3
      00543E 50 04            [24]  897 gh_c3:  jnc     gh_bad
      005440 24 0A            [12]  898 gh_let: add     a,#10
      005442 C3               [12]  899 gh_ok:  clr     c
      005443 22               [24]  900         ret
      005444 D3               [12]  901 gh_bad: setb    c
      005445 22               [24]  902         ret
