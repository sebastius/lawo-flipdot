      0052E6                        633 px_go:
      0052E6 12r54r6B         [24]  634         lcall   getnum3
      0052E9 40 59            [24]  635         jc      px_end
      0052EB 12r55rA0         [24]  636         lcall   add_xoff
      0052EE FC               [12]  637         mov     r4,a                    ; x (+ verschuiving)
      0052EF 12r54r5D         [24]  638         lcall   getdig
      0052F2 40 50            [24]  639         jc      px_end
