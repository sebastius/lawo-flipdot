      005253 12r52rDC         [24]  544         lcall   do_bitmap
      005256 80 0F            [24]  545         sjmp    qp_next
      005258 90 0E 01         [24]  546 qp_2:   mov     dptr,#FULL_REQ          ; 'U': alles, over de hele breedte
      00525B 74 01            [12]  547         mov     a,#1
      00525D F0               [24]  548         movx    @dptr,a
      00525E 90 0E 05         [24]  549         mov     dptr,#DIRTY_MIN
      005261 E4               [12]  550         clr     a
      005262 F0               [24]  551         movx    @dptr,a
      005263 A3               [24]  552         inc     dptr                    ; DIRTY_MAX
      005264 74 FE            [12]  553         mov     a,#0xFE
      005266 F0               [24]  554         movx    @dptr,a
      005267                        555 qp_next:
      005267 90 0E 08         [24]  556         mov     dptr,#CNT_ITEMS
      00526A 12r54r70         [24]  557         lcall   inc_x
      00526D ED               [12]  558         mov     a,r5
      00526E 04               [12]  559         inc     a
      00526F 54 03            [12]  560         anl     a,#3
      005271 90 0E 03         [24]  561         mov     dptr,#Q_TAIL
      005274 F0               [24]  562         movx    @dptr,a
      005275 80 AB            [24]  563         sjmp    q_process
      005277                        564 qp_end:
      005277 22               [24]  565         ret
