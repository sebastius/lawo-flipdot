                                   1025 ; volgorde van de 28 bytes in het aD-antwoord (zie README)
      0054F2                       1026 diag_tab:
      0054F2 0E 02 0E 03           1027         .db     >Q_HEAD, <Q_HEAD,       >Q_TAIL, <Q_TAIL
      0054F6 0E 00 0E 01           1028         .db     >BM_FLAG, <BM_FLAG,     >FULL_REQ, <FULL_REQ
      0054FA 0E 05 0E 06           1029         .db     >DIRTY_MIN, <DIRTY_MIN, >DIRTY_MAX, <DIRTY_MAX
      0054FE 05 71 05 54           1030         .db     >REQ, <REQ,             >DISP_BUSY, <DISP_BUSY
      005502 0E 07 0E 08           1031         .db     >CNT_POLL5, <CNT_POLL5, >CNT_ITEMS, <CNT_ITEMS
      005506 0E 09 0E 0A 0E 0B     1032         .db     >CNT_FR, <CNT_FR,       >CNT_DOT_H, <CNT_DOT_H, >CNT_DOT_L, <CNT_DOT_L
      00550C FE 10 FE 11           1033         .db     0xFE, 0x10,  0xFE, 0x11                         ; rijmasker-pointer
      005510 FE 20 FE 21 FE 22     1034         .db     0xFE, 0x20,  0xFE, 0x21,  0xFE, 0x22            ; bitvariabelen
      005516 FD 00                 1035         .db     0xFD, 0x00                                      ; P1
      005518 05 5C 05 5D           1036         .db     >WIDTH, <WIDTH,         >HEIGHT, <HEIGHT
      00551C 00 10                 1037         .db     0x00, 0x10                                      ; xdata 0x0010 (timer-isr)
      00551E 05 88 05 89           1038         .db     >(FB_NEW+10), <(FB_NEW+10), >(FB_NEW+11), <(FB_NEW+11)   ; kolom 5
      005522 07 B8 07 B9           1039         .db     >(FB_OLD+10), <(FB_OLD+10), >(FB_OLD+11), <(FB_OLD+11)
      005526 0E 1A 0E 1B           1040         .db     >(SH+10), <(SH+10),     >(SH+11), <(SH+11)
      00552A FF FF                 1041         .db     0xFF, 0xFF
