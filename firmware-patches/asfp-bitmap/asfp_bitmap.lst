                                   1055 ; a als twee hextekens naar TXBUF (gebruikt r3)
      00552F                       1056 put_hex:
      00552F FB               [12] 1057         mov     r3,a
      005530 C4               [12] 1058         swap    a
      005531 12r55r3E         [24] 1059         lcall   hexch
