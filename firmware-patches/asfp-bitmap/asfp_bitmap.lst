      005306 7F 10            [12]  665         mov     r7,#<SH
      005308 12r53rDB         [24]  666         lcall   colptr
      00530B EB               [12]  667         mov     a,r3
      00530C F0               [24]  668         movx    @dptr,a
      00530D A3               [24]  669         inc     dptr
      00530E EA               [12]  670         mov     a,r2
      00530F F0               [24]  671         movx    @dptr,a
      005310 12r53rB0         [24]  672         lcall   mark_dirty
