                                    658 ; ---------- bitmapmodus starten: schaduw := getoond beeld ----------
                                    659 ; blokkopie FB_OLD -> SH (2 * breedte bytes): bron via DPTR, doel via P2:R0 (MOVX @R0)
      005315                        660 bm_enter:
      005315 90 0E 00         [24]  661         mov     dptr,#BM_FLAG
      005318 E0               [24]  662         movx    a,@dptr
      005319 70 2D            [24]  663         jnz     be_done
      00531B 74 01            [12]  664         mov     a,#1
      00531D F0               [24]  665         movx    @dptr,a
      00531E 90 05 5C         [24]  666         mov     dptr,#WIDTH
      005321 E0               [24]  667         movx    a,@dptr
      005322 60 24            [24]  668         jz      be_done
      005324 25 E0            [12]  669         add     a,acc
      005326 FB               [12]  670         mov     r3,a                    ; aantal bytes, laag
      005327 E4               [12]  671         clr     a
      005328 33               [12]  672         rlc     a
      005329 FA               [12]  673         mov     r2,a                    ; aantal bytes, hoog
      00532A C0 A0            [24]  674         push    P2
      00532C 75 A0 0E         [24]  675         mov     P2,#>SH
      00532F 78 10            [12]  676         mov     r0,#<SH
      005331 90 07 AE         [24]  677         mov     dptr,#FB_OLD
      005334                        678 be_copy:
      005334 E0               [24]  679         movx    a,@dptr
      005335 F2               [24]  680         movx    @r0,a
      005336 A3               [24]  681         inc     dptr
      005337 08               [12]  682         inc     r0
      005338 B8 00 02         [24]  683         cjne    r0,#0,be_cnt
      00533B 05 A0            [12]  684         inc     P2
      00533D EB               [12]  685 be_cnt: mov     a,r3                    ; teller (r2:r3) - 1
      00533E 70 01            [24]  686         jnz     be_lo
      005340 1A               [12]  687         dec     r2
      005341 1B               [12]  688 be_lo:  dec     r3
      005342 EB               [12]  689         mov     a,r3
      005343 4A               [12]  690         orl     a,r2
      005344 70 EE            [24]  691         jnz     be_copy
      005346 D0 A0            [24]  692         pop     P2
      005348                        693 be_done:
      005348 22               [24]  694         ret
