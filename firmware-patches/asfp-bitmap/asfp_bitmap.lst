                                    913 ; cijfer op @dptr -> a (0..9), dptr++; C = 1 als geen cijfer
      00545D                        914 getdig:
      00545D E0               [24]  915         movx    a,@dptr
      00545E A3               [24]  916         inc     dptr
      00545F C3               [12]  917         clr     c
      005460 94 30            [12]  918         subb    a,#0x30
      005462 40 05            [24]  919         jc      gd_bad
      005464 B4 0A 00         [24]  920         cjne    a,#10,gd_cmp
      005467 B3               [12]  921 gd_cmp: cpl     c                       ; C was 1 als a < 10
      005468 22               [24]  922         ret
      005469 D3               [12]  923 gd_bad: setb    c
      00546A 22               [24]  924         ret
