                                      1 ; ASFP-bitmap: uitbreiding van ASFP.bin (LAWO AZR 802/24) met pixel-, bitmap- en
                                      2 ; ververs-telegrammen en gedeeltelijke verversing (partial update).
                                      3 ; Getest in de emulator (emulator/). Op hardware (17-11-2026): telegrammen worden aangenomen,
                                      4 ; maar er klapten nog geen dots om; daarom het diagnosetelegram aD.
                                      5 ;
                                      6 ; Nieuwe IBIS-telegrammen (CR + XOR-checksum zoals altijd):
                                      7 ;   aP<a><XXX><YY><C>[<XXX><YY><C>...]   pixels: kolom (3 cijfers), rij (2 cijfers, 0 = boven),
                                      8 ;                                        kleur 0 = zwart / 1 = geel
                                      9 ;   aB<a><XXX><HHHH>[<HHHH>...]          kolommen vanaf XXX; per kolom 16 bits hex,
                                     10 ;                                        bit y = rij y van boven (0001 = bovenste dot)
                                     11 ;   aU<a>                                alle dots opnieuw omzetten (tegen vastzittende dots)
                                     12 ;   aD<a>                                diagnose: antwoord "aD" + 28 bytes interne toestand in hex
                                     13 ;                                        (zie diag_tab); geen a0, beëindigt de bitmapmodus niet
                                     14 ; <a> = displayadres als teken ('1'..'?'); '0' = alle displays, dan geen antwoord.
                                     15 ; aB en aP mogen tot 500 tekens lang zijn (ASFP: 250), zodat een volledige bitmap van
                                     16 ; 112 x 16 (455 tekens) in één telegram past.
                                     17 ; Na elk geaccepteerd telegram antwoordt het display "a0"; daarna worden alleen de
                                     18 ; veranderde dots omgezet. Is de wachtrij vol, dan volgt geen antwoord (later opnieuw).
                                     19 ;
                                     20 ; Bitmapmodus: het eerste pixel/bitmap-telegram neemt het getoonde beeld over in een
                                     21 ; schaduwbuffer; daarna tekent alles in die schaduw. Een inhoudelijk ASFP-telegram
                                     22 ; (tekst, lijn, bestemming, testbeeld, ...) beëindigt de bitmapmodus; status- en
                                     23 ; versievragen (a<a>, aV<a>) niet.
                                     24 ;
                                     25 ; Werking in ASFP:
                                     26 ;   0x035F  ontvangstbuffer, index iRAM 2Dh (8 bit, max 0xF9); 0x0553 = ontvangststatus
                                     27 ;   0x057E  gewenst beeld, 2 bytes per kolom (hoog, laag); bit y = rij y van boven
                                     28 ;   0x07AE  getoond beeld (kopie na elke verversing)
                                     29 ;   0x0692  verversroutine; slaat onveranderde dots alleen over als 22h.0 = 1
                                     30 ;   22h.0   "wisseltekst actief": zolang gezet tekent de hoofdlus steeds de volgende pagina
                                     31 ;   0x0571  verzoek aan de hoofdlus (testbeeld aT gebruikt 1..4); 5 = verversen zonder vullen
                                     32 ;
                                     33 ; Opbouw van de patch:
                                     34 ;   - Ontvangst (interrupt): voor aB/aP telt de index door tot 500 (extra byte RX_HI).
                                     35 ;   - Herkenning (interrupt): adres controleren en het ruwe telegram in een wachtrij
                                     36 ;     kopiëren (2 x 512 bytes), "a0" antwoorden. Kort, zodat er geen tekens verloren gaan.
                                     37 ;   - Hoofdlus: zolang de wachtrij niet leeg is wordt 0x0571 = 5. Het omhulsel om de
                                     38 ;     verversing verwerkt dan alle telegrammen in de schaduw, kopieert die naar 0x057E en
                                     39 ;     ververst met een eigen snelle routine (alleen veranderde dots); 22h.0 = 0 (wisseltekst stopt).
                                     40 ;   - Reset: eigen variabelen wissen (het werk-RAM is batterijgebufferd).
                                     41 ;
                                     42 ; Haken in ASFP (origineel -> patch):
                                     43 ;   0x0000  LJMP 0x4EBF            -> LJMP init
                                     44 ;   0x001F  (opvulling 00 00 00)   -> LJMP ext_a
                                     45 ;   0x018B  SJMP 0x0204            -> AJMP 0x001F    (einde a-telegramherkenning)
                                     46 ;   0x0481  MOV 2Dh,#01h           -> LCALL rx_start (begin telegram)
                                     47 ;   0x04A9  MOV A,2Dh / SETB C     -> LJMP rx_store  (teken opslaan)
                                     48 ;   0x2FD9  MOV DPTR,#0571h        -> LJMP main_poll (hoofdlus)
                                     49 ;   0x30E0  LCALL 0x0692           -> LCALL refresh_wrap
                                     50 ; Nieuwe code vanaf 0x5000 (was 0xFF). Werk-RAM 0x0900-0x0F27 (ASFP gebruikt tot 0x08D0).
                                     51 ;
                                     52 ; Interruptcode draait in registerbank 1, hoofdluscode in bank 0. Gebruikt worden alleen
                                     53 ; R0-R7, ACC, B, DPTR en (tijdelijk, met herstel) P2, net als de ASFP-routines.
                                     54 
                                     55         .module asfp_bitmap
                                     56 
                                     57 ; 1 = eigen snelle verversing (alleen veranderde kolommen), 0 = originele routine 0x0692.
                                     58 ; Op hardware klapten met fast_refresh geen dots om (17-11-2026); daarom voorlopig 0.
                           000000    59 USE_FAST_REFRESH = 0
                                     60         .area   PATCH (ABS,CODE)
                                     61 
                                     62 ; ---------- ASFP ----------
                           00035F    63 BUF        = 0x035F        ; ontvangstbuffer, afgesloten met CR
                           00002E    64 RX_CS      = 0x002E        ; lopende checksum
                           000042    65 RAW_CH     = 0x42          ; iRAM: ontvangen byte incl. pariteit
                           000043    66 CH7        = 0x43          ; iRAM: ontvangen teken (7 bit)
                           00002D    67 RX_IDX     = 0x2D          ; iRAM: ontvangstindex (laag)
                           00055B    68 ADDR       = 0x055B        ; displayadres (binair)
                           00055C    69 WIDTH      = 0x055C        ; breedte in kolommen
                           00055D    70 HEIGHT     = 0x055D        ; hoogte in rijen
                           00057E    71 FB_NEW     = 0x057E        ; gewenst beeld
                           0007AE    72 FB_OLD     = 0x07AE        ; getoond beeld
                           000571    73 REQ        = 0x0571        ; verzoek aan hoofdlus
                           000005    74 REQ_REFRESH = 5
                           00031E    75 TXBUF      = 0x031E
                           00002F    76 TXLEN      = 0x002F
                           000555    77 TXIDX      = 0x0555
                           000038    78 TYPE       = 0x38          ; iRAM: telegramtype in de verdeler (0 = onbekend)
                           000007    79 T_STATUS   = 7
                           000008    80 T_VERSION  = 8
                           00003A    81 LEN_CS     = 0x3A          ; iRAM: lengte voor de checksumroutine
                           000204    82 DISPATCH_TAIL = 0x0204
                           0000B2    83 REPLY_CS   = 0x00B2
                           000692    84 REFRESH    = 0x0692
                           004EBF    85 RESET_ORIG = 0x4EBF
                           0004B0    86 RX_STORE_ORIG = 0x04B0     ; origineel: opslaan, aA-kopie, INC 2Dh
                           0004FB    87 RX_AFTER   = 0x04FB        ; origineel: CR-controle
                           002FDC    88 POLL_CONT  = 0x2FDC        ; origineel: MOVX A,@DPTR (DPTR = 0x0571)
                           000004    89 B_TXBUSY   = 0x04          ; 20h.4
                           000099    90 B_TI       = 0x99          ; SCON.1
                           000010    91 B_PARTIAL  = 0x10          ; 22h.0
                           0000A0    92 P2         = 0xA0
                                     93 
                                     94 ; ---------- eigen werk-RAM ----------
                           000009    95 QBASE      = 0x09          ; wachtrij: slot i op (QBASE + 2*i) * 256, 512 bytes per slot
                           000E00    96 BM_FLAG    = 0x0E00        ; 1 = bitmapmodus (schaduw geldig)
                           000E01    97 FULL_REQ   = 0x0E01        ; 1 = volgende verversing alles omzetten
                           000E02    98 Q_HEAD     = 0x0E02        ; aantal gevulde slots (modulo 4), alleen de interrupt schrijft
                           000E03    99 Q_TAIL     = 0x0E03        ; aantal verwerkte slots (modulo 4), alleen de hoofdlus schrijft
                           000E04   100 RX_HI      = 0x0E04        ; ontvangstindex (hoog) voor lange telegrammen
                           000E05   101 DIRTY_MIN  = 0x0E05        ; laagste gewijzigde kolom sinds de vorige verversing (0xFF = geen)
                           000E06   102 DIRTY_MAX  = 0x0E06        ; hoogste gewijzigde kolom
                           000E07   103 CNT_POLL5  = 0x0E07        ; tellers (diagnose, modulo 256): hoofdlus zette REQ = 5
                           000E08   104 CNT_ITEMS  = 0x0E08        ;   verwerkte telegrammen uit de wachtrij
                           000E09   105 CNT_FR     = 0x0E09        ;   aanroepen van fast_refresh
                           000E0A   106 CNT_DOT_H  = 0x0E0A        ;   aangevraagde dotpulsen (16 bit)
                           000E0B   107 CNT_DOT_L  = 0x0E0B
                           000E0C   108 VARS_END   = 0x0E0C
                           000E10   109 SH         = 0x0E10        ; schaduwbuffer, max 140 kolommen x 2 bytes
                           0001F4   110 RX_MAX     = 0x01F4        ; max. lengte aB/aP incl. CR (buffer tot vlak voor 0x0553)
                                    111 
                           00000D   112 CR         = 0x0D
                                    113 
                                    114 ; ---------- haken ----------
      000000                        115         .org    0x0000
      000000 02r50r00         [24]  116         ljmp    init
                                    117 
      00001F                        118         .org    0x001F
      00001F 02r50r6A         [24]  119         ljmp    ext_a
                                    120 
      00018B                        121         .org    0x018B
      00018B 00 1F            [12]  122         ajmp    0x001F
                                    123 
      000481                        124         .org    0x0481
      000481 12r50r11         [24]  125         lcall   rx_start
                                    126 
      0004A9                        127         .org    0x04A9
      0004A9 02r50r1A         [24]  128         ljmp    rx_store
                                    129 
      002FD9                        130         .org    0x2FD9
      002FD9 02r51r0E         [24]  131         ljmp    main_poll
                                    132 
      0030E0                        133         .org    0x30E0
      0030E0 12r51r31         [24]  134         lcall   refresh_wrap
                                    135 
      005000                        136         .org    0x5000
                                    137 
                                    138 ; ---------- reset ----------
      005000                        139 init:
      005000 E4               [12]  140         clr     a
      005001 90 0E 00         [24]  141         mov     dptr,#BM_FLAG           ; 0x0E00 .. VARS_END-1 wissen
      005004 F0               [24]  142 in_clr: movx    @dptr,a
      005005 A3               [24]  143         inc     dptr
      005006 AF 82            [24]  144         mov     r7,dpl
      005008 BF 0C F9         [24]  145         cjne    r7,#<VARS_END,in_clr
      00500B 12r53rA5         [24]  146         lcall   dirty_clear
      00500E 02 4E BF         [24]  147         ljmp    RESET_ORIG
                                    148 
                                    149 ; ---------- ontvangst (seriële interrupt) ----------
                                    150 ; begin van een telegram (vervangt MOV 2Dh,#01h; daarna laadt ASFP A en DPTR opnieuw)
      005011                        151 rx_start:
      005011 75 2D 01         [24]  152         mov     RX_IDX,#1
      005014 90 0E 04         [24]  153         mov     dptr,#RX_HI
      005017 E4               [12]  154         clr     a
      005018 F0               [24]  155         movx    @dptr,a
      005019 22               [24]  156         ret
                                    157 
                                    158 ; teken opslaan (vervangt MOV A,2Dh / SETB C op 0x04A9)
      00501A                        159 rx_store:
      00501A 90 0E 04         [24]  160         mov     dptr,#RX_HI
      00501D E0               [24]  161         movx    a,@dptr
      00501E FF               [12]  162         mov     r7,a                    ; index hoog
      00501F 70 0A            [24]  163         jnz     rs_long
      005021 E5 2D            [12]  164         mov     a,RX_IDX
      005023 D3               [12]  165         setb    c
      005024 94 F9            [12]  166         subb    a,#0xF9
      005026 50 03            [24]  167         jnc     rs_long                 ; index >= 0xFA: voorbij de ASFP-grens
      005028 02 04 B0         [24]  168         ljmp    RX_STORE_ORIG           ; normaal: originele code
      00502B                        169 rs_long:
      00502B 90 03 5F         [24]  170         mov     dptr,#BUF               ; alleen aB en aP mogen langer zijn
      00502E E0               [24]  171         movx    a,@dptr
      00502F B4 61 35         [24]  172         cjne    a,#0x61,rs_skip
      005032 A3               [24]  173         inc     dptr
      005033 E0               [24]  174         movx    a,@dptr
      005034 B4 42 02         [24]  175         cjne    a,#0x42,rs_p
      005037 80 03            [24]  176         sjmp    rs_ok
      005039 B4 50 2B         [24]  177 rs_p:   cjne    a,#0x50,rs_skip
      00503C                        178 rs_ok:
      00503C E5 2D            [12]  179         mov     a,RX_IDX                ; index < RX_MAX ?
      00503E C3               [12]  180         clr     c
      00503F 94 F4            [12]  181         subb    a,#<RX_MAX
      005041 EF               [12]  182         mov     a,r7
      005042 94 01            [12]  183         subb    a,#>RX_MAX
      005044 50 21            [24]  184         jnc     rs_skip
      005046 90 00 2E         [24]  185         mov     dptr,#RX_CS             ; checksum bijwerken
      005049 E0               [24]  186         movx    a,@dptr
      00504A 65 42            [12]  187         xrl     a,RAW_CH
      00504C F0               [24]  188         movx    @dptr,a
      00504D E5 2D            [12]  189         mov     a,RX_IDX                ; BUF[index] = teken
      00504F 24 5F            [12]  190         add     a,#<BUF
      005051 F5 82            [12]  191         mov     dpl,a
      005053 EF               [12]  192         mov     a,r7
      005054 34 03            [12]  193         addc    a,#>BUF
      005056 F5 83            [12]  194         mov     dph,a
      005058 E5 43            [12]  195         mov     a,CH7
      00505A F0               [24]  196         movx    @dptr,a
      00505B 05 2D            [12]  197         inc     RX_IDX                  ; index++ (16 bit)
      00505D E5 2D            [12]  198         mov     a,RX_IDX
      00505F 70 06            [24]  199         jnz     rs_skip
      005061 0F               [12]  200         inc     r7
      005062 90 0E 04         [24]  201         mov     dptr,#RX_HI
      005065 EF               [12]  202         mov     a,r7
      005066 F0               [24]  203         movx    @dptr,a
      005067                        204 rs_skip:
      005067 02 04 FB         [24]  205         ljmp    RX_AFTER                ; CR-controle zoals origineel
                                    206 
                                    207 ; ---------- telegramherkenning (seriële interrupt) ----------
      00506A                        208 ext_a:
      00506A E5 38            [12]  209         mov     a,TYPE
      00506C 60 11            [24]  210         jz      ext_ours
      00506E B4 07 02         [24]  211         cjne    a,#T_STATUS,ext_k1      ; ASFP-telegram: inhoud beëindigt bitmapmodus,
      005071 80 57            [24]  212         sjmp    ext_exit                ; status- en versievragen niet
      005073 B4 08 02         [24]  213 ext_k1: cjne    a,#T_VERSION,ext_k2
      005076 80 52            [24]  214         sjmp    ext_exit
      005078 90 0E 00         [24]  215 ext_k2: mov     dptr,#BM_FLAG
      00507B E4               [12]  216         clr     a
      00507C F0               [24]  217         movx    @dptr,a
      00507D 80 4B            [24]  218         sjmp    ext_exit
      00507F                        219 ext_ours:
      00507F 90 03 5F         [24]  220         mov     dptr,#BUF
      005082 E0               [24]  221         movx    a,@dptr
      005083 B4 61 44         [24]  222         cjne    a,#0x61,ext_exit        ; 'a'
      005086 A3               [24]  223         inc     dptr
      005087 E0               [24]  224         movx    a,@dptr
      005088 B4 50 02         [24]  225         cjne    a,#0x50,ext_c1          ; 'P'
      00508B 80 1E            [24]  226         sjmp    ext_addr
      00508D B4 42 02         [24]  227 ext_c1: cjne    a,#0x42,ext_c2          ; 'B'
      005090 80 19            [24]  228         sjmp    ext_addr
      005092 B4 55 02         [24]  229 ext_c2: cjne    a,#0x55,ext_c3          ; 'U'
      005095 80 14            [24]  230         sjmp    ext_addr
      005097 B4 44 30         [24]  231 ext_c3: cjne    a,#0x44,ext_exit        ; 'D': diagnose, alleen op het eigen adres
      00509A A3               [24]  232         inc     dptr
      00509B E0               [24]  233         movx    a,@dptr
      00509C FE               [12]  234         mov     r6,a
      00509D 90 05 5B         [24]  235         mov     dptr,#ADDR
      0050A0 E0               [24]  236         movx    a,@dptr
      0050A1 24 30            [12]  237         add     a,#0x30
      0050A3 6E               [12]  238         xrl     a,r6
      0050A4 70 24            [24]  239         jnz     ext_exit
      0050A6 12r54r6E         [24]  240         lcall   reply_diag
      0050A9 80 1F            [24]  241         sjmp    ext_exit
      0050AB                        242 ext_addr:
      0050AB A3               [24]  243         inc     dptr
      0050AC E0               [24]  244         movx    a,@dptr
      0050AD FE               [12]  245         mov     r6,a                    ; adresteken
      0050AE 7D 00            [12]  246         mov     r5,#0                   ; 1 = rondzending, geen antwoord
      0050B0 90 05 5B         [24]  247         mov     dptr,#ADDR
      0050B3 E0               [24]  248         movx    a,@dptr
      0050B4 24 30            [12]  249         add     a,#0x30
      0050B6 6E               [12]  250         xrl     a,r6
      0050B7 60 06            [24]  251         jz      ext_go
      0050B9 EE               [12]  252         mov     a,r6
      0050BA B4 30 0D         [24]  253         cjne    a,#0x30,ext_exit
      0050BD 7D 01            [12]  254         mov     r5,#1
      0050BF                        255 ext_go:
      0050BF 12r50rCD         [24]  256         lcall   enqueue
      0050C2 40 06            [24]  257         jc      ext_exit                ; wachtrij vol: geen antwoord
      0050C4 ED               [12]  258         mov     a,r5
      0050C5 70 03            [24]  259         jnz     ext_exit
      0050C7 12r54r46         [24]  260         lcall   reply_ok
      0050CA                        261 ext_exit:
      0050CA 02 02 04         [24]  262         ljmp    DISPATCH_TAIL
                                    263 
                                    264 ; ruw telegram (tot en met CR) naar slot Q_HEAD; C = 1 als de wachtrij vol is
                                    265 ; head en tail tellen modulo 4 (slot = teller AND 1); aantal = (head - tail) AND 3.
                                    266 ; Alleen de interrupt schrijft head, alleen de hoofdlus schrijft tail: geen vergrendeling nodig.
      0050CD                        267 enqueue:
      0050CD 90 0E 03         [24]  268         mov     dptr,#Q_TAIL
      0050D0 E0               [24]  269         movx    a,@dptr
      0050D1 FB               [12]  270         mov     r3,a                    ; tail
      0050D2 90 0E 02         [24]  271         mov     dptr,#Q_HEAD
      0050D5 E0               [24]  272         movx    a,@dptr
      0050D6 54 03            [12]  273         anl     a,#3
      0050D8 FA               [12]  274         mov     r2,a                    ; head
      0050D9 C3               [12]  275         clr     c
      0050DA 9B               [12]  276         subb    a,r3
      0050DB 54 03            [12]  277         anl     a,#3
      0050DD B4 02 00         [24]  278         cjne    a,#2,eq_room            ; C = 1 als aantal < 2
      0050E0                        279 eq_room:
      0050E0 50 2A            [24]  280         jnc     eq_full
      0050E2 EA               [12]  281         mov     a,r2
      0050E3 04               [12]  282         inc     a
      0050E4 54 03            [12]  283         anl     a,#3
      0050E6 FB               [12]  284         mov     r3,a                    ; nieuwe head
      0050E7 C0 A0            [24]  285         push    P2
      0050E9 EA               [12]  286         mov     a,r2
      0050EA 54 01            [12]  287         anl     a,#1                    ; slot
      0050EC 25 E0            [12]  288         add     a,acc
      0050EE 24 09            [12]  289         add     a,#QBASE
      0050F0 F5 A0            [12]  290         mov     P2,a                    ; doel via MOVX @R1 (P2 = hoge byte)
      0050F2 79 00            [12]  291         mov     r1,#0
      0050F4 90 03 5F         [24]  292         mov     dptr,#BUF
      0050F7                        293 eq_loop:
      0050F7 E0               [24]  294         movx    a,@dptr
      0050F8 F3               [24]  295         movx    @r1,a
      0050F9 A3               [24]  296         inc     dptr
      0050FA 09               [12]  297         inc     r1
      0050FB B9 00 02         [24]  298         cjne    r1,#0,eq_cr
      0050FE 05 A0            [12]  299         inc     P2
      005100 B4 0D F4         [24]  300 eq_cr:  cjne    a,#CR,eq_loop
      005103 D0 A0            [24]  301         pop     P2
      005105 90 0E 02         [24]  302         mov     dptr,#Q_HEAD
      005108 EB               [12]  303         mov     a,r3
      005109 F0               [24]  304         movx    @dptr,a
      00510A C3               [12]  305         clr     c
      00510B 22               [24]  306         ret
      00510C                        307 eq_full:
      00510C D3               [12]  308         setb    c
      00510D 22               [24]  309         ret
                                    310 
                                    311 ; ---------- hoofdlus ----------
                                    312 ; vervangt MOV DPTR,#0571h op 0x2FD9: wachtrij niet leeg en geen ander verzoek -> REQ = 5
      00510E                        313 main_poll:
      00510E 90 0E 03         [24]  314         mov     dptr,#Q_TAIL
      005111 E0               [24]  315         movx    a,@dptr
      005112 F5 F0            [12]  316         mov     b,a
      005114 90 0E 02         [24]  317         mov     dptr,#Q_HEAD
      005117 E0               [24]  318         movx    a,@dptr
      005118 65 F0            [12]  319         xrl     a,b
      00511A 60 0F            [24]  320         jz      mp_done
      00511C 90 05 71         [24]  321         mov     dptr,#REQ
      00511F E0               [24]  322         movx    a,@dptr
      005120 70 09            [24]  323         jnz     mp_done                 ; testbeeld eerst afhandelen
      005122 74 05            [12]  324         mov     a,#REQ_REFRESH
      005124 F0               [24]  325         movx    @dptr,a
      005125 90 0E 07         [24]  326         mov     dptr,#CNT_POLL5
      005128 12r54r6A         [24]  327         lcall   inc_x
      00512B                        328 mp_done:
      00512B 90 05 71         [24]  329         mov     dptr,#REQ
      00512E 02 2F DC         [24]  330         ljmp    POLL_CONT
                                    331 
                                    332 ; omhulsel om de verversing (0x30E0)
      005131                        333 refresh_wrap:
      005131 90 05 71         [24]  334         mov     dptr,#REQ
      005134 E0               [24]  335         movx    a,@dptr
      005135 B4 05 22         [24]  336         cjne    a,#REQ_REFRESH,rw_plain
      005138 12r52r22         [24]  337         lcall   q_process
      00513B 90 0E 00         [24]  338         mov     dptr,#BM_FLAG
      00513E E0               [24]  339         movx    a,@dptr
      00513F 60 03            [24]  340         jz      rw_go                   ; bitmapmodus intussen beëindigd
      005141 12r53r54         [24]  341         lcall   sh_to_fb
      005144                        342 rw_go:
      005144 90 0E 09         [24]  343         mov     dptr,#CNT_FR
      005147 12r54r6A         [24]  344         lcall   inc_x
                           000000   345 .if USE_FAST_REFRESH
                                    346         clr     B_PARTIAL               ; wisseltekst stoppen
                                    347         ljmp    fast_refresh            ; alleen veranderde dots, zonder paginawachttijd
                           000001   348 .else
                                    349         ; originele verversroutine: met 22h.0 = 1 slaat 0x0692 onveranderde dots over; de
                                    350         ; paginatimer (32h/33h) op 0, anders wacht 0x0692 eerst de wisseltekst-paginatijd af.
                                    351         ; Daarna 22h.0 = 0, zodat de hoofdlus geen volgende tekstpagina over het beeld tekent.
      00514A 75 32 00         [24]  352         mov     0x32,#0
      00514D 75 33 00         [24]  353         mov     0x33,#0
      005150 D2 10            [12]  354         setb    B_PARTIAL
      005152 12 06 92         [24]  355         lcall   REFRESH
      005155 C2 10            [12]  356         clr     B_PARTIAL
      005157 02r53rA5         [24]  357         ljmp    dirty_clear
                                    358 .endif
      00515A                        359 rw_plain:
      00515A 02 06 92         [24]  360         ljmp    REFRESH                 ; testbeeld: origineel gedrag
                                    361 
                                    362 ; ---------- snelle verversing (hoofdlus) ----------
                                    363 ; Vervangt 0x0692 voor de bitmapmodus. 0x0692 rekent voor elk van de (tot) 1792 dots
                                    364 ; apart het verschil uit (645 ms bij 6 MHz, ook als er niets verandert) en wacht bij
                                    365 ; wisseltekst eerst de paginatijd af. Deze routine vergelijkt per kolom de 16-bit woorden
                                    366 ; en vraagt alleen voor veranderde dots een puls aan, op dezelfde manier als 0x0692:
                                    367 ; 056B = rij, 056C = kolom, 21h.6 = kleur (XOR 21h.7 'omgekeerd'), 21h.4 = puls gevraagd;
                                    368 ; de timer-interrupt geeft de puls en wist 21h.4. Rijmaskers uit de ASFP-tabel (10h:11h);
                                    369 ; fr_setup laadt die pointer en 21h.7 zelf, zoals 0x0692 op 0x0732-0x0766 doet (10h:11h is
                                    370 ; elders in ASFP ook kladgeheugen).
                           000010   371 ROWMASK_H  = 0x10          ; iRAM: pointer naar rijmasker-tabel (code), hoog
                           000011   372 ROWMASK_L  = 0x11          ;                                        laag
                           00056B   373 DOT_ROW    = 0x056B
                           00056C   374 DOT_COL    = 0x056C
                           00000C   375 B_DOTREQ   = 0x0C          ; 21h.4
                           00000E   376 B_COLOR    = 0x0E          ; 21h.6
                           00000F   377 B_INVERSE  = 0x0F          ; 21h.7
                           000087   378 PCON       = 0x87
                           000554   379 DISP_BUSY  = 0x0554        ; 0x0692 zet deze op 0 na afloop
                                    380 
      00515D                        381 fast_refresh:
      00515D 12r51rFA         [24]  382         lcall   fr_setup                ; rijmasker-pointer en 'omgekeerd' zoals 0x0692
      005160 12r53rAF         [24]  383         lcall   dirty_start             ; alleen gewijzigde kolommen
      005163                        384 fr_col:
      005163 12r53rCA         [24]  385         lcall   in_range
      005166 40 03            [24]  386         jc      fr_col_go
      005168 02r51rF2         [24]  387         ljmp    fr_done
      00516B                        388 fr_col_go:
      00516B 7E 05            [12]  389         mov     r6,#>FB_NEW
      00516D 7F 7E            [12]  390         mov     r7,#<FB_NEW
      00516F 12r53rE0         [24]  391         lcall   colptr
      005172 E0               [24]  392         movx    a,@dptr
      005173 FB               [12]  393         mov     r3,a                    ; nieuw hoog
      005174 A3               [24]  394         inc     dptr
      005175 E0               [24]  395         movx    a,@dptr
      005176 FA               [12]  396         mov     r2,a                    ; nieuw laag
      005177 7E 07            [12]  397         mov     r6,#>FB_OLD
      005179 7F AE            [12]  398         mov     r7,#<FB_OLD
      00517B 12r53rE0         [24]  399         lcall   colptr
      00517E E0               [24]  400         movx    a,@dptr
      00517F 6B               [12]  401         xrl     a,r3
      005180 F5 F0            [12]  402         mov     b,a                     ; verschil hoog
      005182 A3               [24]  403         inc     dptr
      005183 E0               [24]  404         movx    a,@dptr
      005184 6A               [12]  405         xrl     a,r2
      005185 FD               [12]  406         mov     r5,a                    ; verschil laag
      005186 45 F0            [12]  407         orl     a,b
      005188 60 64            [24]  408         jz      fr_next                 ; kolom ongewijzigd
      00518A 7F 00            [12]  409         mov     r7,#0                   ; rij-index
      00518C                        410 fr_row:
      00518C 90 05 5D         [24]  411         mov     dptr,#HEIGHT
      00518F E0               [24]  412         movx    a,@dptr
      005190 F9               [12]  413         mov     r1,a
      005191 EF               [12]  414         mov     a,r7
      005192 C3               [12]  415         clr     c
      005193 99               [12]  416         subb    a,r1
      005194 50 4C            [24]  417         jnc     fr_store
      005196 EF               [12]  418         mov     a,r7                    ; dptr = rijmasker-tabel + 2*rij
      005197 2F               [12]  419         add     a,r7
      005198 25 11            [12]  420         add     a,ROWMASK_L
      00519A F5 82            [12]  421         mov     dpl,a
      00519C E4               [12]  422         clr     a
      00519D 35 10            [12]  423         addc    a,ROWMASK_H
      00519F F5 83            [12]  424         mov     dph,a
      0051A1 E4               [12]  425         clr     a
      0051A2 93               [24]  426         movc    a,@a+dptr
      0051A3 FE               [12]  427         mov     r6,a                    ; masker hoog
      0051A4 74 01            [12]  428         mov     a,#1
      0051A6 93               [24]  429         movc    a,@a+dptr
      0051A7 F9               [12]  430         mov     r1,a                    ; masker laag
      0051A8 EE               [12]  431         mov     a,r6
      0051A9 55 F0            [12]  432         anl     a,b
      0051AB 70 04            [24]  433         jnz     fr_flip
      0051AD E9               [12]  434         mov     a,r1
      0051AE 5D               [12]  435         anl     a,r5
      0051AF 60 2E            [24]  436         jz      fr_rnext
      0051B1                        437 fr_flip:
      0051B1 EE               [12]  438         mov     a,r6                    ; kleur = (nieuw AND masker) <> 0
      0051B2 5B               [12]  439         anl     a,r3
      0051B3 F8               [12]  440         mov     r0,a
      0051B4 E9               [12]  441         mov     a,r1
      0051B5 5A               [12]  442         anl     a,r2
      0051B6 48               [12]  443         orl     a,r0
      0051B7 24 FF            [12]  444         add     a,#0xFF                 ; C = 1 als a <> 0
      0051B9 30 0F 01         [24]  445         jnb     B_INVERSE,fr_col_ok
      0051BC B3               [12]  446         cpl     c
      0051BD                        447 fr_col_ok:
      0051BD 92 0E            [24]  448         mov     B_COLOR,c
      0051BF 90 05 6B         [24]  449         mov     dptr,#DOT_ROW
      0051C2 EF               [12]  450         mov     a,r7
      0051C3 F0               [24]  451         movx    @dptr,a
      0051C4 A3               [24]  452         inc     dptr                    ; DOT_COL
      0051C5 EC               [12]  453         mov     a,r4
      0051C6 F0               [24]  454         movx    @dptr,a
      0051C7 90 0E 0B         [24]  455         mov     dptr,#CNT_DOT_L
      0051CA 12r54r6A         [24]  456         lcall   inc_x
      0051CD 70 06            [24]  457         jnz     fr_req
      0051CF 90 0E 0A         [24]  458         mov     dptr,#CNT_DOT_H
      0051D2 12r54r6A         [24]  459         lcall   inc_x
      0051D5                        460 fr_req:
      0051D5 D2 0C            [12]  461         setb    B_DOTREQ
      0051D7                        462 fr_wait:
      0051D7 30 0C 05         [24]  463         jnb     B_DOTREQ,fr_rnext       ; wachten tot de timer-interrupt gepulst heeft
      0051DA 75 87 81         [24]  464         mov     PCON,#0x81              ; idle, SMOD blijft 1 (zoals ASFP)
      0051DD 80 F8            [24]  465         sjmp    fr_wait
      0051DF                        466 fr_rnext:
      0051DF 0F               [12]  467         inc     r7
      0051E0 80 AA            [24]  468         sjmp    fr_row
      0051E2                        469 fr_store:
      0051E2 7E 07            [12]  470         mov     r6,#>FB_OLD             ; getoond := nieuw voor deze kolom
      0051E4 7F AE            [12]  471         mov     r7,#<FB_OLD
      0051E6 12r53rE0         [24]  472         lcall   colptr
      0051E9 EB               [12]  473         mov     a,r3
      0051EA F0               [24]  474         movx    @dptr,a
      0051EB A3               [24]  475         inc     dptr
      0051EC EA               [12]  476         mov     a,r2
      0051ED F0               [24]  477         movx    @dptr,a
      0051EE                        478 fr_next:
      0051EE 0C               [12]  479         inc     r4
      0051EF 02r51r63         [24]  480         ljmp    fr_col
      0051F2                        481 fr_done:
      0051F2 90 05 54         [24]  482         mov     dptr,#DISP_BUSY
      0051F5 E4               [12]  483         clr     a
      0051F6 F0               [24]  484         movx    @dptr,a
      0051F7 02r53rA5         [24]  485         ljmp    dirty_clear
                                    486 
                                    487 ; voorbereiding zoals 0x0692 (0x0732-0x0766): 21h.7 = 'omgekeerd' uit tabel 0x4B33 per adres
                                    488 ; (XOR 20h.0), 10h:11h = rijmasker-pointer uit tabel 0x4B2B per adres (14 bytes per adres)
      0051FA                        489 fr_setup:
      0051FA 90 05 5B         [24]  490         mov     dptr,#ADDR
      0051FD E0               [24]  491         movx    a,@dptr
      0051FE 7F 0E            [12]  492         mov     r7,#0x0E
      005200 90 4B 33         [24]  493         mov     dptr,#0x4B33
      005203 12 4E 13         [24]  494         lcall   0x4E13                  ; dptr += a * r7
      005206 E4               [12]  495         clr     a
      005207 93               [24]  496         movc    a,@a+dptr
      005208 24 FF            [12]  497         add     a,#0xFF                 ; C = 1 als tabelwaarde <> 0
      00520A B3               [12]  498         cpl     c                       ; omgekeerd = (waarde == 0)
      00520B 30 00 01         [24]  499         jnb     0x00,fs_inv             ; 20h.0 keert om
      00520E B3               [12]  500         cpl     c
      00520F 92 0F            [24]  501 fs_inv: mov     B_INVERSE,c
      005211 90 05 5B         [24]  502         mov     dptr,#ADDR
      005214 E0               [24]  503         movx    a,@dptr
      005215 7F 0E            [12]  504         mov     r7,#0x0E
      005217 90 4B 2B         [24]  505         mov     dptr,#0x4B2B
      00521A 12 4E 13         [24]  506         lcall   0x4E13
      00521D 78 10            [12]  507         mov     r0,#ROWMASK_H
      00521F 02 4E B6         [24]  508         ljmp    0x4EB6                  ; 2 bytes uit de tabel naar @r0 (10h, 11h)
                                    509 
                                    510 ; alle wachtende telegrammen verwerken in de schaduw
      005222                        511 q_process:
      005222 90 0E 03         [24]  512         mov     dptr,#Q_TAIL
      005225 E0               [24]  513         movx    a,@dptr
      005226 54 03            [12]  514         anl     a,#3
      005228 FD               [12]  515         mov     r5,a                    ; tail
      005229 90 0E 02         [24]  516         mov     dptr,#Q_HEAD
      00522C E0               [24]  517         movx    a,@dptr
      00522D 54 03            [12]  518         anl     a,#3
      00522F 6D               [12]  519         xrl     a,r5
      005230 60 45            [24]  520         jz      qp_end
      005232 12r53r20         [24]  521         lcall   bm_enter                ; schaduw = getoond beeld (eerste keer)
      005235 ED               [12]  522         mov     a,r5
      005236 54 01            [12]  523         anl     a,#1                    ; slot
      005238 25 E0            [12]  524         add     a,acc
      00523A 24 09            [12]  525         add     a,#QBASE
      00523C F5 83            [12]  526         mov     dph,a
      00523E 75 82 01         [24]  527         mov     dpl,#1
      005241 E0               [24]  528         movx    a,@dptr                 ; commando
      005242 F5 F0            [12]  529         mov     b,a
      005244 A3               [24]  530         inc     dptr
      005245 A3               [24]  531         inc     dptr                    ; eerste dataveld
      005246 E5 F0            [12]  532         mov     a,b
      005248 B4 50 05         [24]  533         cjne    a,#0x50,qp_1
      00524B 12r52r78         [24]  534         lcall   do_pixels
      00524E 80 17            [24]  535         sjmp    qp_next
      005250 B4 42 05         [24]  536 qp_1:   cjne    a,#0x42,qp_2
      005253 12r52rD9         [24]  537         lcall   do_bitmap
      005256 80 0F            [24]  538         sjmp    qp_next
      005258 90 0E 01         [24]  539 qp_2:   mov     dptr,#FULL_REQ          ; 'U': alles, over de hele breedte
      00525B 74 01            [12]  540         mov     a,#1
      00525D F0               [24]  541         movx    @dptr,a
      00525E 90 0E 05         [24]  542         mov     dptr,#DIRTY_MIN
      005261 E4               [12]  543         clr     a
      005262 F0               [24]  544         movx    @dptr,a
      005263 A3               [24]  545         inc     dptr                    ; DIRTY_MAX
      005264 74 FE            [12]  546         mov     a,#0xFE
      005266 F0               [24]  547         movx    @dptr,a
      005267                        548 qp_next:
      005267 90 0E 08         [24]  549         mov     dptr,#CNT_ITEMS
      00526A 12r54r6A         [24]  550         lcall   inc_x
      00526D ED               [12]  551         mov     a,r5
      00526E 04               [12]  552         inc     a
      00526F 54 03            [12]  553         anl     a,#3
      005271 90 0E 03         [24]  554         mov     dptr,#Q_TAIL
      005274 F0               [24]  555         movx    @dptr,a
      005275 80 AB            [24]  556         sjmp    q_process
      005277                        557 qp_end:
      005277 22               [24]  558         ret
