                                    555 ; voorbereiding zoals 0x0692 (0x0732-0x0766): 21h.7 = 'omgekeerd' uit tabel 0x4B33 per adres
                                    556 ; (XOR 20h.0), 10h:11h = rijmasker-pointer uit tabel 0x4B2B per adres (14 bytes per adres)
      005263                        557 fr_setup:
      005263 90 05 5B         [24]  558         mov     dptr,#ADDR
      005266 E0               [24]  559         movx    a,@dptr
      005267 7F 0E            [12]  560         mov     r7,#0x0E
      005269 90 4B 33         [24]  561         mov     dptr,#0x4B33
      00526C 12 4E 13         [24]  562         lcall   0x4E13                  ; dptr += a * r7
      00526F E4               [12]  563         clr     a
      005270 93               [24]  564         movc    a,@a+dptr
      005271 24 FF            [12]  565         add     a,#0xFF                 ; C = 1 als tabelwaarde <> 0
      005273 B3               [12]  566         cpl     c                       ; omgekeerd = (waarde == 0)
      005274 30 00 01         [24]  567         jnb     0x00,fs_inv             ; 20h.0 keert om
      005277 B3               [12]  568         cpl     c
      005278 92 0F            [24]  569 fs_inv: mov     B_INVERSE,c
      00527A 90 05 5B         [24]  570         mov     dptr,#ADDR
      00527D E0               [24]  571         movx    a,@dptr
      00527E 7F 0E            [12]  572         mov     r7,#0x0E
      005280 90 4B 2B         [24]  573         mov     dptr,#0x4B2B
      005283 12 4E 13         [24]  574         lcall   0x4E13
      005286 78 10            [12]  575         mov     r0,#ROWMASK_H
      005288 02 4E B6         [24]  576         ljmp    0x4EB6                  ; 2 bytes uit de tabel naar @r0 (10h, 11h)
                                    577 
                                    578 ; alle wachtende telegrammen verwerken in de schaduw
      00528B                        579 q_process:
      00528B 90 0E 03         [24]  580         mov     dptr,#Q_TAIL
      00528E E0               [24]  581         movx    a,@dptr
      00528F 54 03            [12]  582         anl     a,#3
      005291 FD               [12]  583         mov     r5,a                    ; tail
      005292 90 0E 02         [24]  584         mov     dptr,#Q_HEAD
      005295 E0               [24]  585         movx    a,@dptr
      005296 54 03            [12]  586         anl     a,#3
      005298 6D               [12]  587         xrl     a,r5
      005299 60 45            [24]  588         jz      qp_end
      00529B 12r53r8F         [24]  589         lcall   bm_enter                ; schaduw = getoond beeld (eerste keer)
      00529E ED               [12]  590         mov     a,r5
      00529F 54 01            [12]  591         anl     a,#1                    ; slot
      0052A1 25 E0            [12]  592         add     a,acc
      0052A3 24 09            [12]  593         add     a,#QBASE
      0052A5 F5 83            [12]  594         mov     dph,a
      0052A7 75 82 01         [24]  595         mov     dpl,#1
      0052AA E0               [24]  596         movx    a,@dptr                 ; commando
      0052AB F5 F0            [12]  597         mov     b,a
      0052AD A3               [24]  598         inc     dptr
      0052AE A3               [24]  599         inc     dptr                    ; eerste dataveld
      0052AF E5 F0            [12]  600         mov     a,b
      0052B1 B4 50 05         [24]  601         cjne    a,#0x50,qp_1
      0052B4 12r52rE1         [24]  602         lcall   do_pixels
      0052B7 80 17            [24]  603         sjmp    qp_next
      0052B9 B4 42 05         [24]  604 qp_1:   cjne    a,#0x42,qp_2
      0052BC 12r53r45         [24]  605         lcall   do_bitmap
      0052BF 80 0F            [24]  606         sjmp    qp_next
      0052C1 90 0E 01         [24]  607 qp_2:   mov     dptr,#FULL_REQ          ; 'U': alles, over de hele breedte
      0052C4 74 01            [12]  608         mov     a,#1
      0052C6 F0               [24]  609         movx    @dptr,a
      0052C7 90 0E 05         [24]  610         mov     dptr,#DIRTY_MIN
      0052CA E4               [12]  611         clr     a
      0052CB F0               [24]  612         movx    @dptr,a
      0052CC A3               [24]  613         inc     dptr                    ; DIRTY_MAX
      0052CD 74 FE            [12]  614         mov     a,#0xFE
      0052CF F0               [24]  615         movx    @dptr,a
      0052D0                        616 qp_next:
      0052D0 90 0E 08         [24]  617         mov     dptr,#CNT_ITEMS
      0052D3 12r54rD9         [24]  618         lcall   inc_x
      0052D6 ED               [12]  619         mov     a,r5
      0052D7 04               [12]  620         inc     a
      0052D8 54 03            [12]  621         anl     a,#3
      0052DA 90 0E 03         [24]  622         mov     dptr,#Q_TAIL
      0052DD F0               [24]  623         movx    @dptr,a
      0052DE 80 AB            [24]  624         sjmp    q_process
      0052E0                        625 qp_end:
      0052E0 22               [24]  626         ret
