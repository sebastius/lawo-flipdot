                                    985 ; a als twee hextekens naar TXBUF (gebruikt r3)
      0054C0                        986 put_hex:
      0054C0 FB               [12]  987         mov     r3,a
      0054C1 C4               [12]  988         swap    a
      0054C2 12r54rCF         [24]  989         lcall   hexch
      0054C5 12r54rDB         [24]  990         lcall   put_ch
      0054C8 EB               [12]  991         mov     a,r3
      0054C9 12r54rCF         [24]  992         lcall   hexch
      0054CC 02r54rDB         [24]  993         ljmp    put_ch
                                    994 
      0054CF 54 0F            [12]  995 hexch:  anl     a,#0x0F
      0054D1 B4 0A 00         [24]  996         cjne    a,#10,hx_c
      0054D4 40 02            [24]  997 hx_c:   jc      hx_d
      0054D6 24 07            [12]  998         add     a,#7
      0054D8 24 30            [12]  999 hx_d:   add     a,#0x30
      0054DA 22               [24] 1000         ret
                                   1001 
                                   1002 ; a naar TXBUF[r2], r2++
      0054DB                       1003 put_ch:
      0054DB C0 E0            [24] 1004         push    acc
      0054DD EA               [12] 1005         mov     a,r2
      0054DE 24 1E            [12] 1006         add     a,#<TXBUF
      0054E0 F5 82            [12] 1007         mov     dpl,a
      0054E2 E4               [12] 1008         clr     a
      0054E3 34 03            [12] 1009         addc    a,#>TXBUF
      0054E5 F5 83            [12] 1010         mov     dph,a
      0054E7 D0 E0            [24] 1011         pop     acc
      0054E9 F0               [24] 1012         movx    @dptr,a
      0054EA 0A               [12] 1013         inc     r2
      0054EB 22               [24] 1014         ret
