                                   1000 ; volgorde van de 28 bytes in het aD-antwoord (zie README)
      0054E1                       1001 diag_tab:
      0054E1 0E 02 0E 03           1002         .db     >Q_HEAD, <Q_HEAD,       >Q_TAIL, <Q_TAIL
      0054E5 0E 00 0E 01           1003         .db     >BM_FLAG, <BM_FLAG,     >FULL_REQ, <FULL_REQ
      0054E9 0E 05 0E 06           1004         .db     >DIRTY_MIN, <DIRTY_MIN, >DIRTY_MAX, <DIRTY_MAX
      0054ED 05 71 05 54           1005         .db     >REQ, <REQ,             >DISP_BUSY, <DISP_BUSY
      0054F1 0E 07 0E 08           1006         .db     >CNT_POLL5, <CNT_POLL5, >CNT_ITEMS, <CNT_ITEMS
      0054F5 0E 09 0E 0A 0E 0B     1007         .db     >CNT_FR, <CNT_FR,       >CNT_DOT_H, <CNT_DOT_H, >CNT_DOT_L, <CNT_DOT_L
      0054FB FE 10 FE 11           1008         .db     0xFE, 0x10,  0xFE, 0x11                         ; rijmasker-pointer
      0054FF FE 20 FE 21 FE 22     1009         .db     0xFE, 0x20,  0xFE, 0x21,  0xFE, 0x22            ; bitvariabelen
      005505 FD 00                 1010         .db     0xFD, 0x00                                      ; P1
      005507 05 5C 05 5D           1011         .db     >WIDTH, <WIDTH,         >HEIGHT, <HEIGHT
      00550B 00 10                 1012         .db     0x00, 0x10                                      ; xdata 0x0010 (timer-isr)
      00550D 05 88 05 89           1013         .db     >(FB_NEW+10), <(FB_NEW+10), >(FB_NEW+11), <(FB_NEW+11)   ; kolom 5
      005511 07 B8 07 B9           1014         .db     >(FB_OLD+10), <(FB_OLD+10), >(FB_OLD+11), <(FB_OLD+11)
      005515 0E 1A 0E 1B           1015         .db     >(SH+10), <(SH+10),     >(SH+11), <(SH+11)
      005519 FF FF                 1016         .db     0xFF, 0xFF
