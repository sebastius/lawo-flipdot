                                    941 ; ---------- diagnose: "aD" + hex van de bytes uit diag_tab (seriële interrupt) ----------
                                    942 ; tabel: 2 bytes per regel; hoog = 0xFE: iRAM (laag = adres), 0xFD: P1, 0xFF: einde, anders xdata
      005469                        943 reply_diag:
      005469 7A 00            [12]  944         mov     r2,#0                   ; schrijfpositie in TXBUF
      00546B 74 61            [12]  945         mov     a,#0x61
      00546D 12r54rD6         [24]  946         lcall   put_ch
      005470 74 44            [12]  947         mov     a,#0x44
      005472 12r54rD6         [24]  948         lcall   put_ch
      005475 7C 00            [12]  949         mov     r4,#0                   ; tabelindex
      005477                        950 rd_loop:
      005477 90r54rE7         [24]  951         mov     dptr,#diag_tab
      00547A EC               [12]  952         mov     a,r4
      00547B 93               [24]  953         movc    a,@a+dptr
      00547C FD               [12]  954         mov     r5,a
      00547D 0C               [12]  955         inc     r4
      00547E EC               [12]  956         mov     a,r4
      00547F 93               [24]  957         movc    a,@a+dptr
      005480 FE               [12]  958         mov     r6,a
      005481 0C               [12]  959         inc     r4
      005482 ED               [12]  960         mov     a,r5
      005483 B4 FF 02         [24]  961         cjne    a,#0xFF,rd_x1
      005486 80 19            [24]  962         sjmp    rd_end
      005488 B4 FE 05         [24]  963 rd_x1:  cjne    a,#0xFE,rd_x2
      00548B EE               [12]  964         mov     a,r6
      00548C F8               [12]  965         mov     r0,a
      00548D E6               [12]  966         mov     a,@r0
      00548E 80 0C            [24]  967         sjmp    rd_put
      005490 B4 FD 04         [24]  968 rd_x2:  cjne    a,#0xFD,rd_x3
      005493 E5 90            [12]  969         mov     a,0x90                  ; P1
      005495 80 05            [24]  970         sjmp    rd_put
      005497 8D 83            [24]  971 rd_x3:  mov     dph,r5
      005499 8E 82            [24]  972         mov     dpl,r6
      00549B E0               [24]  973         movx    a,@dptr
      00549C 12r54rBB         [24]  974 rd_put: lcall   put_hex
      00549F 80 D6            [24]  975         sjmp    rd_loop
      0054A1                        976 rd_end:
      0054A1 74 0D            [12]  977         mov     a,#CR
      0054A3 12r54rD6         [24]  978         lcall   put_ch
      0054A6 EA               [12]  979         mov     a,r2                    ; r2 = lengte incl. CR
      0054A7 F5 3A            [12]  980         mov     LEN_CS,a
      0054A9 04               [12]  981         inc     a                       ; + checksum
      0054AA 90 00 2F         [24]  982         mov     dptr,#TXLEN
      0054AD F0               [24]  983         movx    @dptr,a
      0054AE 12 00 B2         [24]  984         lcall   REPLY_CS
      0054B1 D2 04            [12]  985         setb    B_TXBUSY
      0054B3 90 05 55         [24]  986         mov     dptr,#TXIDX
      0054B6 E4               [12]  987         clr     a
      0054B7 F0               [24]  988         movx    @dptr,a
      0054B8 D2 99            [12]  989         setb    B_TI
      0054BA 22               [24]  990         ret
