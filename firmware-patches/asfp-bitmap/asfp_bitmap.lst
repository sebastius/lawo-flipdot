      005353 A3               [24]  726 md_max: inc     dptr                    ; DIRTY_MAX
      005354 E0               [24]  727         movx    a,@dptr
      005355 C3               [12]  728         clr     c
      005356 9C               [12]  729         subb    a,r4
      005357 50 02            [24]  730         jnc     md_end                  ; max >= r4
      005359 EC               [12]  731         mov     a,r4
      00535A F0               [24]  732         movx    @dptr,a
      00535B 22               [24]  733 md_end: ret
                                    734 
                                    735 ; C = 1 als r4 <= DIRTY_MAX en r4 < breedte
      00535C                        736 in_range:
      00535C 90 0E 06         [24]  737         mov     dptr,#DIRTY_MAX
      00535F E0               [24]  738         movx    a,@dptr
      005360 C3               [12]  739         clr     c
      005361 9C               [12]  740         subb    a,r4
      005362 40 03            [24]  741         jc      ir_no
      005364 02r53r69         [24]  742         ljmp    x_lt_width
      005367 C3               [12]  743 ir_no:  clr     c
      005368 22               [24]  744         ret
                                    745 
                                    746 ; C = 1 als r4 < breedte (gebruikt dptr, r1)
      005369                        747 x_lt_width:
      005369 90 05 5C         [24]  748         mov     dptr,#WIDTH
      00536C E0               [24]  749         movx    a,@dptr
      00536D F9               [12]  750         mov     r1,a
      00536E EC               [12]  751         mov     a,r4
      00536F C3               [12]  752         clr     c
      005370 99               [12]  753         subb    a,r1
      005371 22               [24]  754         ret
                                    755 
                                    756 ; dptr = (r6:r7) + 2*r4
      005372                        757 colptr:
      005372 EC               [12]  758         mov     a,r4
      005373 2C               [12]  759         add     a,r4
      005374 F8               [12]  760         mov     r0,a
      005375 E4               [12]  761         clr     a
      005376 33               [12]  762         rlc     a
      005377 C8               [12]  763         xch     a,r0                    ; a = laag, r0 = hoog
      005378 2F               [12]  764         add     a,r7
      005379 F5 82            [12]  765         mov     dpl,a
      00537B E8               [12]  766         mov     a,r0
      00537C 3E               [12]  767         addc    a,r6
      00537D F5 83            [12]  768         mov     dph,a
      00537F 22               [24]  769         ret
