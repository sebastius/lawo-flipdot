                                      1 ; ASFP-bitmap: uitbreiding van ASFP.bin (LAWO AZR 802/24) met pixel-, bitmap- en
                                      2 ; ververs-telegrammen en gedeeltelijke verversing (partial update).
                                      3 ; Getest in de emulator (emulator/). Op hardware (17-11-2026): telegrammen worden aangenomen,
                                      4 ; maar er klapten nog geen dots om; daarom het diagnosetelegram aD.
                                      5 ;
                                      6 ; Nieuwe IBIS-telegrammen (CR + XOR-checksum zoals altijd):
                                      7 ;   aP<a><XXX><YY><C>[<XXX><YY><C>...]   pixels: kolom (3 cijfers), rij (2 cijfers, 0 = boven),
                                      8 ;                                        kleur 0 = zwart / 1 = geel
                                      9 ;   aB<a><XXX><HHHH>[<HHHH>...]          kolommen vanaf XXX; per kolom 16 bits hex,
                                     10 ;                                        bit y = rij y van boven (0001 = bovenste dot)
                                     11 ;   aU<a>                                alle dots opnieuw omzetten (tegen vastzittende dots)
                                     12 ;   aM<a><n>                           verversingsmodus n (0..7), zie RF_MODE
                                     13 ;   aD<a>                                diagnose: antwoord "aD" + 29 bytes interne toestand in hex
                                     14 ;                                        (zie diag_tab); geen a0, beëindigt de bitmapmodus niet
                                     15 ; <a> = displayadres als teken ('1'..'?'); '0' = alle displays, dan geen antwoord.
                                     16 ; aB en aP mogen tot 500 tekens lang zijn (ASFP: 250), zodat een volledige bitmap van
                                     17 ; 112 x 16 (455 tekens) in één telegram past.
                                     18 ; Na elk geaccepteerd telegram antwoordt het display "a0"; daarna worden alleen de
                                     19 ; veranderde dots omgezet. Is de wachtrij vol, dan volgt geen antwoord (later opnieuw).
                                     20 ;
                                     21 ; Bitmapmodus: het eerste pixel/bitmap-telegram neemt het getoonde beeld over in een
                                     22 ; schaduwbuffer; daarna tekent alles in die schaduw. Een inhoudelijk ASFP-telegram
                                     23 ; (tekst, lijn, bestemming, testbeeld, ...) beëindigt de bitmapmodus; status- en
                                     24 ; versievragen (a<a>, aV<a>) niet.
                                     25 ;
                                     26 ; Werking in ASFP:
                                     27 ;   0x035F  ontvangstbuffer, index iRAM 2Dh (8 bit, max 0xF9); 0x0553 = ontvangststatus
                                     28 ;   0x057E  gewenst beeld, 2 bytes per kolom (hoog, laag); bit y = rij y van boven
                                     29 ;   0x07AE  getoond beeld (kopie na elke verversing)
                                     30 ;   0x0692  verversroutine; slaat onveranderde dots alleen over als 22h.0 = 1
                                     31 ;   22h.0   "wisseltekst actief": zolang gezet tekent de hoofdlus steeds de volgende pagina
                                     32 ;   0x0571  verzoek aan de hoofdlus (testbeeld aT gebruikt 1..4); 5 = verversen zonder vullen
                                     33 ;
                                     34 ; Opbouw van de patch:
                                     35 ;   - Ontvangst (interrupt): voor aB/aP telt de index door tot 500 (extra byte RX_HI).
                                     36 ;   - Herkenning (interrupt): adres controleren en het ruwe telegram in een wachtrij
                                     37 ;     kopiëren (2 x 512 bytes), "a0" antwoorden. Kort, zodat er geen tekens verloren gaan.
                                     38 ;   - Hoofdlus: zolang de wachtrij niet leeg is wordt 0x0571 = 5. Het omhulsel om de
                                     39 ;     verversing verwerkt dan alle telegrammen in de schaduw, kopieert die naar 0x057E en
                                     40 ;     ververst met een eigen snelle routine (alleen veranderde dots); 22h.0 = 0 (wisseltekst stopt).
                                     41 ;   - Reset: eigen variabelen wissen (het werk-RAM is batterijgebufferd).
                                     42 ;
                                     43 ; Haken in ASFP (origineel -> patch):
                                     44 ;   0x0000  LJMP 0x4EBF            -> LJMP init
                                     45 ;   0x001F  (opvulling 00 00 00)   -> LJMP ext_a
                                     46 ;   0x018B  SJMP 0x0204            -> AJMP 0x001F    (einde a-telegramherkenning)
                                     47 ;   0x0481  MOV 2Dh,#01h           -> LCALL rx_start (begin telegram)
                                     48 ;   0x04A9  MOV A,2Dh / SETB C     -> LJMP rx_store  (teken opslaan)
                                     49 ;   0x2FD9  MOV DPTR,#0571h        -> LJMP main_poll (hoofdlus)
                                     50 ;   0x30E0  LCALL 0x0692           -> LCALL refresh_wrap
                                     51 ; Nieuwe code vanaf 0x5000 (was 0xFF). Werk-RAM 0x0900-0x0F27 (ASFP gebruikt tot 0x08D0).
                                     52 ;
                                     53 ; Interruptcode draait in registerbank 1, hoofdluscode in bank 0. Gebruikt worden alleen
                                     54 ; R0-R7, ACC, B, DPTR en (tijdelijk, met herstel) P2, net als de ASFP-routines.
                                     55 
                                     56         .module asfp_bitmap
                                     57 
                                     58 ; Verversing kiesbaar tijdens bedrijf met aM<a><n> (RF_MODE, na reset 0):
                                     59 ;   0 = originele routine 0x0692 (werkt op hardware), 1 = fast_refresh,
                                     60 ;   2 = fast_refresh + ~3 ms wachten aan het eind, 3 = fast_refresh + ~3 ms na elke puls,
                                     61 ;   4 = fast_refresh zonder fr_setup, 5 = 2 en 3 samen,
                                     62 ;   6 = fast_refresh na ~300 ms wachten (zoals de rekentijd van 0x0692), 7 = 2, 3 en 6 samen.
                                     63 ; Op hardware (17-11-2026) klapten met fast_refresh geen dots om, hoewel aD laat zien dat de
                                     64 ; pulsen worden aangevraagd en afgehandeld; in de emulator werkt het wel. Oorzaak onbekend.
                           000001    65 FRF_NOSETUP = 0x01          ; FR_FLAGS: fr_setup overslaan
                           000002    66 FRF_ENDWAIT = 0x02          ;           ~3 ms wachten na de laatste puls
                           000004    67 FRF_GAP     = 0x04          ;           ~3 ms wachten na elke puls
                           000008    68 FRF_PRE     = 0x08          ;           ~300 ms wachten voor de eerste puls
                                     69 
                                     70 ; Kolomverschuiving voor aP en aB: byte op XOFF_ADDR (standaard 28). Op een display waarvan de
                                     71 ; eerste module (kolom 0-27) ontbreekt, valt x = 0 dan op de eerste zichtbare kolom.
                                     72 ; Zet het byte op 0 voor een volledig display (build.py --xoff, of met een hex-editor).
                           005FFF    73 XOFF_ADDR  = 0x5FFF
                                     74         .area   PATCH (ABS,CODE)
                                     75 
                                     76 ; ---------- ASFP ----------
                           00035F    77 BUF        = 0x035F        ; ontvangstbuffer, afgesloten met CR
                           00002E    78 RX_CS      = 0x002E        ; lopende checksum
                           000042    79 RAW_CH     = 0x42          ; iRAM: ontvangen byte incl. pariteit
                           000043    80 CH7        = 0x43          ; iRAM: ontvangen teken (7 bit)
                           00002D    81 RX_IDX     = 0x2D          ; iRAM: ontvangstindex (laag)
                           00055B    82 ADDR       = 0x055B        ; displayadres (binair)
                           00055C    83 WIDTH      = 0x055C        ; breedte in kolommen
                           00055D    84 HEIGHT     = 0x055D        ; hoogte in rijen
                           00057E    85 FB_NEW     = 0x057E        ; gewenst beeld
                           0007AE    86 FB_OLD     = 0x07AE        ; getoond beeld
                           000571    87 REQ        = 0x0571        ; verzoek aan hoofdlus
                           000005    88 REQ_REFRESH = 5
                           00031E    89 TXBUF      = 0x031E
                           00002F    90 TXLEN      = 0x002F
                           000555    91 TXIDX      = 0x0555
                           000038    92 TYPE       = 0x38          ; iRAM: telegramtype in de verdeler (0 = onbekend)
                           000007    93 T_STATUS   = 7
                           000008    94 T_VERSION  = 8
                           00003A    95 LEN_CS     = 0x3A          ; iRAM: lengte voor de checksumroutine
                           000204    96 DISPATCH_TAIL = 0x0204
                           0000B2    97 REPLY_CS   = 0x00B2
                           000692    98 REFRESH    = 0x0692
                           004EBF    99 RESET_ORIG = 0x4EBF
                           0004B0   100 RX_STORE_ORIG = 0x04B0     ; origineel: opslaan, aA-kopie, INC 2Dh
                           0004FB   101 RX_AFTER   = 0x04FB        ; origineel: CR-controle
                           002FDC   102 POLL_CONT  = 0x2FDC        ; origineel: MOVX A,@DPTR (DPTR = 0x0571)
                           000004   103 B_TXBUSY   = 0x04          ; 20h.4
                           000099   104 B_TI       = 0x99          ; SCON.1
                           000010   105 B_PARTIAL  = 0x10          ; 22h.0
                           0000A0   106 P2         = 0xA0
                                    107 
                                    108 ; ---------- eigen werk-RAM ----------
                           000009   109 QBASE      = 0x09          ; wachtrij: slot i op (QBASE + 2*i) * 256, 512 bytes per slot
                           000E00   110 BM_FLAG    = 0x0E00        ; 1 = bitmapmodus (schaduw geldig)
                           000E01   111 FULL_REQ   = 0x0E01        ; 1 = volgende verversing alles omzetten
                           000E02   112 Q_HEAD     = 0x0E02        ; aantal gevulde slots (modulo 4), alleen de interrupt schrijft
                           000E03   113 Q_TAIL     = 0x0E03        ; aantal verwerkte slots (modulo 4), alleen de hoofdlus schrijft
                           000E04   114 RX_HI      = 0x0E04        ; ontvangstindex (hoog) voor lange telegrammen
                           000E05   115 DIRTY_MIN  = 0x0E05        ; laagste gewijzigde kolom sinds de vorige verversing (0xFF = geen)
                           000E06   116 DIRTY_MAX  = 0x0E06        ; hoogste gewijzigde kolom
                           000E07   117 CNT_POLL5  = 0x0E07        ; tellers (diagnose, modulo 256): hoofdlus zette REQ = 5
                           000E08   118 CNT_ITEMS  = 0x0E08        ;   verwerkte telegrammen uit de wachtrij
                           000E09   119 CNT_FR     = 0x0E09        ;   aanroepen van fast_refresh
                           000E0A   120 CNT_DOT_H  = 0x0E0A        ;   aangevraagde dotpulsen (16 bit)
                           000E0B   121 CNT_DOT_L  = 0x0E0B
                           000E0C   122 RF_MODE    = 0x0E0C        ; verversingsmodus (aM), zie boven
                           000E0D   123 FR_FLAGS   = 0x0E0D        ; FRF_* voor fast_refresh, afgeleid van RF_MODE
                           000E0E   124 VARS_END   = 0x0E0E
                           000E10   125 SH         = 0x0E10        ; schaduwbuffer, max 140 kolommen x 2 bytes
                           0001F4   126 RX_MAX     = 0x01F4        ; max. lengte aB/aP incl. CR (buffer tot vlak voor 0x0553)
                                    127 
                           00000D   128 CR         = 0x0D
                                    129 
                                    130 ; ---------- haken ----------
      000000                        131         .org    0x0000
      000000 02r50r00         [24]  132         ljmp    init
                                    133 
      00001F                        134         .org    0x001F
      00001F 02r50r6A         [24]  135         ljmp    ext_a
                                    136 
      00018B                        137         .org    0x018B
      00018B 00 1F            [12]  138         ajmp    0x001F
                                    139 
      000481                        140         .org    0x0481
      000481 12r50r11         [24]  141         lcall   rx_start
                                    142 
      0004A9                        143         .org    0x04A9
      0004A9 02r50r1A         [24]  144         ljmp    rx_store
                                    145 
      002FD9                        146         .org    0x2FD9
      002FD9 02r51r33         [24]  147         ljmp    main_poll
                                    148 
      0030E0                        149         .org    0x30E0
      0030E0 12r51r56         [24]  150         lcall   refresh_wrap
                                    151 
      005000                        152         .org    0x5000
                                    153 
                                    154 ; ---------- reset ----------
      005000                        155 init:
      005000 E4               [12]  156         clr     a
      005001 90 0E 00         [24]  157         mov     dptr,#BM_FLAG           ; 0x0E00 .. VARS_END-1 wissen
      005004 F0               [24]  158 in_clr: movx    @dptr,a
      005005 A3               [24]  159         inc     dptr
      005006 AF 82            [24]  160         mov     r7,dpl
      005008 BF 0E F9         [24]  161         cjne    r7,#<VARS_END,in_clr
      00500B 12r54r14         [24]  162         lcall   dirty_clear
      00500E 02 4E BF         [24]  163         ljmp    RESET_ORIG
                                    164 
                                    165 ; ---------- ontvangst (seriële interrupt) ----------
                                    166 ; begin van een telegram (vervangt MOV 2Dh,#01h; daarna laadt ASFP A en DPTR opnieuw)
      005011                        167 rx_start:
      005011 75 2D 01         [24]  168         mov     RX_IDX,#1
      005014 90 0E 04         [24]  169         mov     dptr,#RX_HI
      005017 E4               [12]  170         clr     a
      005018 F0               [24]  171         movx    @dptr,a
      005019 22               [24]  172         ret
                                    173 
                                    174 ; teken opslaan (vervangt MOV A,2Dh / SETB C op 0x04A9)
      00501A                        175 rx_store:
      00501A 90 0E 04         [24]  176         mov     dptr,#RX_HI
      00501D E0               [24]  177         movx    a,@dptr
      00501E FF               [12]  178         mov     r7,a                    ; index hoog
      00501F 70 0A            [24]  179         jnz     rs_long
      005021 E5 2D            [12]  180         mov     a,RX_IDX
      005023 D3               [12]  181         setb    c
      005024 94 F9            [12]  182         subb    a,#0xF9
      005026 50 03            [24]  183         jnc     rs_long                 ; index >= 0xFA: voorbij de ASFP-grens
      005028 02 04 B0         [24]  184         ljmp    RX_STORE_ORIG           ; normaal: originele code
      00502B                        185 rs_long:
      00502B 90 03 5F         [24]  186         mov     dptr,#BUF               ; alleen aB en aP mogen langer zijn
      00502E E0               [24]  187         movx    a,@dptr
      00502F B4 61 35         [24]  188         cjne    a,#0x61,rs_skip
      005032 A3               [24]  189         inc     dptr
      005033 E0               [24]  190         movx    a,@dptr
      005034 B4 42 02         [24]  191         cjne    a,#0x42,rs_p
      005037 80 03            [24]  192         sjmp    rs_ok
      005039 B4 50 2B         [24]  193 rs_p:   cjne    a,#0x50,rs_skip
      00503C                        194 rs_ok:
      00503C E5 2D            [12]  195         mov     a,RX_IDX                ; index < RX_MAX ?
      00503E C3               [12]  196         clr     c
      00503F 94 F4            [12]  197         subb    a,#<RX_MAX
      005041 EF               [12]  198         mov     a,r7
      005042 94 01            [12]  199         subb    a,#>RX_MAX
      005044 50 21            [24]  200         jnc     rs_skip
      005046 90 00 2E         [24]  201         mov     dptr,#RX_CS             ; checksum bijwerken
      005049 E0               [24]  202         movx    a,@dptr
      00504A 65 42            [12]  203         xrl     a,RAW_CH
      00504C F0               [24]  204         movx    @dptr,a
      00504D E5 2D            [12]  205         mov     a,RX_IDX                ; BUF[index] = teken
      00504F 24 5F            [12]  206         add     a,#<BUF
      005051 F5 82            [12]  207         mov     dpl,a
      005053 EF               [12]  208         mov     a,r7
      005054 34 03            [12]  209         addc    a,#>BUF
      005056 F5 83            [12]  210         mov     dph,a
      005058 E5 43            [12]  211         mov     a,CH7
      00505A F0               [24]  212         movx    @dptr,a
      00505B 05 2D            [12]  213         inc     RX_IDX                  ; index++ (16 bit)
      00505D E5 2D            [12]  214         mov     a,RX_IDX
      00505F 70 06            [24]  215         jnz     rs_skip
      005061 0F               [12]  216         inc     r7
      005062 90 0E 04         [24]  217         mov     dptr,#RX_HI
      005065 EF               [12]  218         mov     a,r7
      005066 F0               [24]  219         movx    @dptr,a
      005067                        220 rs_skip:
      005067 02 04 FB         [24]  221         ljmp    RX_AFTER                ; CR-controle zoals origineel
                                    222 
                                    223 ; ---------- telegramherkenning (seriële interrupt) ----------
      00506A                        224 ext_a:
      00506A E5 38            [12]  225         mov     a,TYPE
      00506C 60 11            [24]  226         jz      ext_ours
      00506E B4 07 02         [24]  227         cjne    a,#T_STATUS,ext_k1      ; ASFP-telegram: inhoud beëindigt bitmapmodus,
      005071 80 7C            [24]  228         sjmp    ext_exit                ; status- en versievragen niet
      005073 B4 08 02         [24]  229 ext_k1: cjne    a,#T_VERSION,ext_k2
      005076 80 77            [24]  230         sjmp    ext_exit
      005078 90 0E 00         [24]  231 ext_k2: mov     dptr,#BM_FLAG
      00507B E4               [12]  232         clr     a
      00507C F0               [24]  233         movx    @dptr,a
      00507D 80 70            [24]  234         sjmp    ext_exit
      00507F                        235 ext_ours:
      00507F 90 03 5F         [24]  236         mov     dptr,#BUF
      005082 E0               [24]  237         movx    a,@dptr
      005083 B4 61 69         [24]  238         cjne    a,#0x61,ext_exit        ; 'a'
      005086 A3               [24]  239         inc     dptr
      005087 E0               [24]  240         movx    a,@dptr
      005088 B4 50 02         [24]  241         cjne    a,#0x50,ext_c1          ; 'P'
      00508B 80 43            [24]  242         sjmp    ext_addr
      00508D B4 42 02         [24]  243 ext_c1: cjne    a,#0x42,ext_c2          ; 'B'
      005090 80 3E            [24]  244         sjmp    ext_addr
      005092 B4 55 02         [24]  245 ext_c2: cjne    a,#0x55,ext_c3          ; 'U'
      005095 80 39            [24]  246         sjmp    ext_addr
      005097 B4 4D 22         [24]  247 ext_c3: cjne    a,#0x4D,ext_c4          ; 'M': verversingsmodus kiezen, alleen eigen adres
      00509A A3               [24]  248         inc     dptr
      00509B E0               [24]  249         movx    a,@dptr
      00509C FE               [12]  250         mov     r6,a
      00509D A3               [24]  251         inc     dptr
      00509E E0               [24]  252         movx    a,@dptr
      00509F C3               [12]  253         clr     c
      0050A0 94 30            [12]  254         subb    a,#0x30
      0050A2 40 4B            [24]  255         jc      ext_exit
      0050A4 FD               [12]  256         mov     r5,a                    ; modus
      0050A5 94 08            [12]  257         subb    a,#8
      0050A7 50 46            [24]  258         jnc     ext_exit                ; alleen 0..7
      0050A9 90 05 5B         [24]  259         mov     dptr,#ADDR
      0050AC E0               [24]  260         movx    a,@dptr
      0050AD 24 30            [12]  261         add     a,#0x30
      0050AF 6E               [12]  262         xrl     a,r6
      0050B0 70 3D            [24]  263         jnz     ext_exit
      0050B2 90 0E 0C         [24]  264         mov     dptr,#RF_MODE
      0050B5 ED               [12]  265         mov     a,r5
      0050B6 F0               [24]  266         movx    @dptr,a
      0050B7 12r54rB5         [24]  267         lcall   reply_ok
      0050BA 80 33            [24]  268         sjmp    ext_exit
      0050BC B4 44 30         [24]  269 ext_c4: cjne    a,#0x44,ext_exit        ; 'D': diagnose, alleen op het eigen adres
      0050BF A3               [24]  270         inc     dptr
      0050C0 E0               [24]  271         movx    a,@dptr
      0050C1 FE               [12]  272         mov     r6,a
      0050C2 90 05 5B         [24]  273         mov     dptr,#ADDR
      0050C5 E0               [24]  274         movx    a,@dptr
      0050C6 24 30            [12]  275         add     a,#0x30
      0050C8 6E               [12]  276         xrl     a,r6
      0050C9 70 24            [24]  277         jnz     ext_exit
      0050CB 12r54rDD         [24]  278         lcall   reply_diag
      0050CE 80 1F            [24]  279         sjmp    ext_exit
      0050D0                        280 ext_addr:
      0050D0 A3               [24]  281         inc     dptr
      0050D1 E0               [24]  282         movx    a,@dptr
      0050D2 FE               [12]  283         mov     r6,a                    ; adresteken
      0050D3 7D 00            [12]  284         mov     r5,#0                   ; 1 = rondzending, geen antwoord
      0050D5 90 05 5B         [24]  285         mov     dptr,#ADDR
      0050D8 E0               [24]  286         movx    a,@dptr
      0050D9 24 30            [12]  287         add     a,#0x30
      0050DB 6E               [12]  288         xrl     a,r6
      0050DC 60 06            [24]  289         jz      ext_go
      0050DE EE               [12]  290         mov     a,r6
      0050DF B4 30 0D         [24]  291         cjne    a,#0x30,ext_exit
      0050E2 7D 01            [12]  292         mov     r5,#1
      0050E4                        293 ext_go:
      0050E4 12r50rF2         [24]  294         lcall   enqueue
      0050E7 40 06            [24]  295         jc      ext_exit                ; wachtrij vol: geen antwoord
      0050E9 ED               [12]  296         mov     a,r5
      0050EA 70 03            [24]  297         jnz     ext_exit
      0050EC 12r54rB5         [24]  298         lcall   reply_ok
      0050EF                        299 ext_exit:
      0050EF 02 02 04         [24]  300         ljmp    DISPATCH_TAIL
                                    301 
                                    302 ; ruw telegram (tot en met CR) naar slot Q_HEAD; C = 1 als de wachtrij vol is
                                    303 ; head en tail tellen modulo 4 (slot = teller AND 1); aantal = (head - tail) AND 3.
                                    304 ; Alleen de interrupt schrijft head, alleen de hoofdlus schrijft tail: geen vergrendeling nodig.
      0050F2                        305 enqueue:
      0050F2 90 0E 03         [24]  306         mov     dptr,#Q_TAIL
      0050F5 E0               [24]  307         movx    a,@dptr
      0050F6 FB               [12]  308         mov     r3,a                    ; tail
      0050F7 90 0E 02         [24]  309         mov     dptr,#Q_HEAD
      0050FA E0               [24]  310         movx    a,@dptr
      0050FB 54 03            [12]  311         anl     a,#3
      0050FD FA               [12]  312         mov     r2,a                    ; head
      0050FE C3               [12]  313         clr     c
      0050FF 9B               [12]  314         subb    a,r3
      005100 54 03            [12]  315         anl     a,#3
      005102 B4 02 00         [24]  316         cjne    a,#2,eq_room            ; C = 1 als aantal < 2
      005105                        317 eq_room:
      005105 50 2A            [24]  318         jnc     eq_full
      005107 EA               [12]  319         mov     a,r2
      005108 04               [12]  320         inc     a
      005109 54 03            [12]  321         anl     a,#3
      00510B FB               [12]  322         mov     r3,a                    ; nieuwe head
      00510C C0 A0            [24]  323         push    P2
      00510E EA               [12]  324         mov     a,r2
      00510F 54 01            [12]  325         anl     a,#1                    ; slot
      005111 25 E0            [12]  326         add     a,acc
      005113 24 09            [12]  327         add     a,#QBASE
      005115 F5 A0            [12]  328         mov     P2,a                    ; doel via MOVX @R1 (P2 = hoge byte)
      005117 79 00            [12]  329         mov     r1,#0
      005119 90 03 5F         [24]  330         mov     dptr,#BUF
      00511C                        331 eq_loop:
      00511C E0               [24]  332         movx    a,@dptr
      00511D F3               [24]  333         movx    @r1,a
      00511E A3               [24]  334         inc     dptr
      00511F 09               [12]  335         inc     r1
      005120 B9 00 02         [24]  336         cjne    r1,#0,eq_cr
      005123 05 A0            [12]  337         inc     P2
      005125 B4 0D F4         [24]  338 eq_cr:  cjne    a,#CR,eq_loop
      005128 D0 A0            [24]  339         pop     P2
