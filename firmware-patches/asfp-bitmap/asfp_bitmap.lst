      0054E3 EA               [12] 1014         mov     a,r2
      0054E4 24 1E            [12] 1015         add     a,#<TXBUF
      0054E6 F5 82            [12] 1016         mov     dpl,a
      0054E8 E4               [12] 1017         clr     a
      0054E9 34 03            [12] 1018         addc    a,#>TXBUF
      0054EB F5 83            [12] 1019         mov     dph,a
      0054ED D0 E0            [24] 1020         pop     acc
      0054EF F0               [24] 1021         movx    @dptr,a
      0054F0 0A               [12] 1022         inc     r2
      0054F1 22               [24] 1023         ret
