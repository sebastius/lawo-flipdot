                                    683 ; ---------- bitmapmodus starten: schaduw := getoond beeld ----------
                                    684 ; blokkopie FB_OLD -> SH (2 * breedte bytes): bron via DPTR, doel via P2:R0 (MOVX @R0)
      005326                        685 bm_enter:
      005326 90 0E 00         [24]  686         mov     dptr,#BM_FLAG
      005329 E0               [24]  687         movx    a,@dptr
      00532A 70 2D            [24]  688         jnz     be_done
      00532C 74 01            [12]  689         mov     a,#1
      00532E F0               [24]  690         movx    @dptr,a
      00532F 90 05 5C         [24]  691         mov     dptr,#WIDTH
      005332 E0               [24]  692         movx    a,@dptr
      005333 60 24            [24]  693         jz      be_done
      005335 25 E0            [12]  694         add     a,acc
      005337 FB               [12]  695         mov     r3,a                    ; aantal bytes, laag
      005338 E4               [12]  696         clr     a
      005339 33               [12]  697         rlc     a
      00533A FA               [12]  698         mov     r2,a                    ; aantal bytes, hoog
      00533B C0 A0            [24]  699         push    P2
      00533D 75 A0 0E         [24]  700         mov     P2,#>SH
