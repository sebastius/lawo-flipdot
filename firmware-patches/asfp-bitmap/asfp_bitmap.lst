      0054C0 74 0D            [12]  983         mov     a,#CR
      0054C2 F0               [24]  984         movx    @dptr,a
      0054C3 75 3A 03         [24]  985         mov     LEN_CS,#3
      0054C6 12 00 B2         [24]  986         lcall   REPLY_CS
      0054C9 90 00 2F         [24]  987         mov     dptr,#TXLEN
      0054CC 74 04            [12]  988         mov     a,#4
      0054CE F0               [24]  989         movx    @dptr,a
