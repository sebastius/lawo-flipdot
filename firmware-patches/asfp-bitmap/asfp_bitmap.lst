                                      1 ; ASFP-bitmap: uitbreiding van ASFP.bin (LAWO AZR 802/24) met pixel-, bitmap- en
                                      2 ; ververs-telegrammen en gedeeltelijke verversing (partial update).
                                      3 ; Alleen getest in de emulator (emulator/), niet op hardware.
                                      4 ;
                                      5 ; Nieuwe IBIS-telegrammen (CR + XOR-checksum zoals altijd):
                                      6 ;   aP<a><XXX><YY><C>[<XXX><YY><C>...]   pixels: kolom (3 cijfers), rij (2 cijfers, 0 = boven),
                                      7 ;                                        kleur 0 = zwart / 1 = geel
                                      8 ;   aB<a><XXX><HHHH>[<HHHH>...]          kolommen vanaf XXX; per kolom 16 bits hex,
                                      9 ;                                        bit y = rij y van boven (0001 = bovenste dot)
                                     10 ;   aU<a>                                alle dots opnieuw omzetten (tegen vastzittende dots)
                                     11 ; <a> = displayadres als teken ('1'..'?'); '0' = alle displays, dan geen antwoord.
                                     12 ; aB en aP mogen tot 500 tekens lang zijn (ASFP: 250), zodat een volledige bitmap van
                                     13 ; 112 x 16 (455 tekens) in één telegram past.
                                     14 ; Na elk geaccepteerd telegram antwoordt het display "a0"; daarna worden alleen de
                                     15 ; veranderde dots omgezet. Is de wachtrij vol, dan volgt geen antwoord (later opnieuw).
                                     16 ;
                                     17 ; Bitmapmodus: het eerste pixel/bitmap-telegram neemt het getoonde beeld over in een
                                     18 ; schaduwbuffer; daarna tekent alles in die schaduw. Een inhoudelijk ASFP-telegram
                                     19 ; (tekst, lijn, bestemming, testbeeld, ...) beëindigt de bitmapmodus; status- en
                                     20 ; versievragen (a<a>, aV<a>) niet.
                                     21 ;
                                     22 ; Werking in ASFP:
                                     23 ;   0x035F  ontvangstbuffer, index iRAM 2Dh (8 bit, max 0xF9); 0x0553 = ontvangststatus
                                     24 ;   0x057E  gewenst beeld, 2 bytes per kolom (hoog, laag); bit y = rij y van boven
                                     25 ;   0x07AE  getoond beeld (kopie na elke verversing)
                                     26 ;   0x0692  verversroutine; slaat onveranderde dots alleen over als 22h.0 = 1
                                     27 ;   22h.0   "wisseltekst actief": zolang gezet tekent de hoofdlus steeds de volgende pagina
                                     28 ;   0x0571  verzoek aan de hoofdlus (testbeeld aT gebruikt 1..4); 5 = verversen zonder vullen
                                     29 ;
                                     30 ; Opbouw van de patch:
                                     31 ;   - Ontvangst (interrupt): voor aB/aP telt de index door tot 500 (extra byte RX_HI).
                                     32 ;   - Herkenning (interrupt): adres controleren en het ruwe telegram in een wachtrij
                                     33 ;     kopiëren (2 x 512 bytes), "a0" antwoorden. Kort, zodat er geen tekens verloren gaan.
                                     34 ;   - Hoofdlus: zolang de wachtrij niet leeg is wordt 0x0571 = 5. Het omhulsel om de
                                     35 ;     verversing verwerkt dan alle telegrammen in de schaduw, kopieert die naar 0x057E en
                                     36 ;     ververst met een eigen snelle routine (alleen veranderde dots); 22h.0 = 0 (wisseltekst stopt).
                                     37 ;   - Reset: eigen variabelen wissen (het werk-RAM is batterijgebufferd).
                                     38 ;
                                     39 ; Haken in ASFP (origineel -> patch):
                                     40 ;   0x0000  LJMP 0x4EBF            -> LJMP init
                                     41 ;   0x001F  (opvulling 00 00 00)   -> LJMP ext_a
                                     42 ;   0x018B  SJMP 0x0204            -> AJMP 0x001F    (einde a-telegramherkenning)
                                     43 ;   0x0481  MOV 2Dh,#01h           -> LCALL rx_start (begin telegram)
                                     44 ;   0x04A9  MOV A,2Dh / SETB C     -> LJMP rx_store  (teken opslaan)
                                     45 ;   0x2FD9  MOV DPTR,#0571h        -> LJMP main_poll (hoofdlus)
                                     46 ;   0x30E0  LCALL 0x0692           -> LCALL refresh_wrap
                                     47 ; Nieuwe code vanaf 0x5000 (was 0xFF). Werk-RAM 0x0900-0x0F27 (ASFP gebruikt tot 0x08D0).
                                     48 ;
                                     49 ; Interruptcode draait in registerbank 1, hoofdluscode in bank 0. Gebruikt worden alleen
                                     50 ; R0-R7, ACC, B, DPTR en (tijdelijk, met herstel) P2, net als de ASFP-routines.
                                     51 
                                     52         .module asfp_bitmap
                                     53         .area   PATCH (ABS,CODE)
                                     54 
                                     55 ; ---------- ASFP ----------
                           00035F    56 BUF        = 0x035F        ; ontvangstbuffer, afgesloten met CR
                           00002E    57 RX_CS      = 0x002E        ; lopende checksum
                           000042    58 RAW_CH     = 0x42          ; iRAM: ontvangen byte incl. pariteit
                           000043    59 CH7        = 0x43          ; iRAM: ontvangen teken (7 bit)
                           00002D    60 RX_IDX     = 0x2D          ; iRAM: ontvangstindex (laag)
                           00055B    61 ADDR       = 0x055B        ; displayadres (binair)
                           00055C    62 WIDTH      = 0x055C        ; breedte in kolommen
                           00055D    63 HEIGHT     = 0x055D        ; hoogte in rijen
                           00057E    64 FB_NEW     = 0x057E        ; gewenst beeld
                           0007AE    65 FB_OLD     = 0x07AE        ; getoond beeld
                           000571    66 REQ        = 0x0571        ; verzoek aan hoofdlus
                           000005    67 REQ_REFRESH = 5
                           00031E    68 TXBUF      = 0x031E
                           00002F    69 TXLEN      = 0x002F
                           000555    70 TXIDX      = 0x0555
                           000038    71 TYPE       = 0x38          ; iRAM: telegramtype in de verdeler (0 = onbekend)
                           000007    72 T_STATUS   = 7
                           000008    73 T_VERSION  = 8
                           00003A    74 LEN_CS     = 0x3A          ; iRAM: lengte voor de checksumroutine
                           000204    75 DISPATCH_TAIL = 0x0204
                           0000B2    76 REPLY_CS   = 0x00B2
                           000692    77 REFRESH    = 0x0692
                           004EBF    78 RESET_ORIG = 0x4EBF
                           0004B0    79 RX_STORE_ORIG = 0x04B0     ; origineel: opslaan, aA-kopie, INC 2Dh
                           0004FB    80 RX_AFTER   = 0x04FB        ; origineel: CR-controle
                           002FDC    81 POLL_CONT  = 0x2FDC        ; origineel: MOVX A,@DPTR (DPTR = 0x0571)
                           000004    82 B_TXBUSY   = 0x04          ; 20h.4
                           000099    83 B_TI       = 0x99          ; SCON.1
                           000010    84 B_PARTIAL  = 0x10          ; 22h.0
                           0000A0    85 P2         = 0xA0
                                     86 
                                     87 ; ---------- eigen werk-RAM ----------
                           000009    88 QBASE      = 0x09          ; wachtrij: slot i op (QBASE + 2*i) * 256, 512 bytes per slot
                           000E00    89 BM_FLAG    = 0x0E00        ; 1 = bitmapmodus (schaduw geldig)
                           000E01    90 FULL_REQ   = 0x0E01        ; 1 = volgende verversing alles omzetten
                           000E02    91 Q_HEAD     = 0x0E02        ; aantal gevulde slots (modulo 4), alleen de interrupt schrijft
                           000E03    92 Q_TAIL     = 0x0E03        ; aantal verwerkte slots (modulo 4), alleen de hoofdlus schrijft
                           000E04    93 RX_HI      = 0x0E04        ; ontvangstindex (hoog) voor lange telegrammen
                           000E05    94 DIRTY_MIN  = 0x0E05        ; laagste gewijzigde kolom sinds de vorige verversing (0xFF = geen)
                           000E06    95 DIRTY_MAX  = 0x0E06        ; hoogste gewijzigde kolom
                           000E10    96 SH         = 0x0E10        ; schaduwbuffer, max 140 kolommen x 2 bytes
                           0001F4    97 RX_MAX     = 0x01F4        ; max. lengte aB/aP incl. CR (buffer tot vlak voor 0x0553)
                                     98 
                           00000D    99 CR         = 0x0D
                                    100 
                                    101 ; ---------- haken ----------
      000000                        102         .org    0x0000
      000000 02r50r00         [24]  103         ljmp    init
                                    104 
      00001F                        105         .org    0x001F
      00001F 02r50r6C         [24]  106         ljmp    ext_a
                                    107 
      00018B                        108         .org    0x018B
      00018B 00 1F            [12]  109         ajmp    0x001F
                                    110 
      000481                        111         .org    0x0481
      000481 12r50r13         [24]  112         lcall   rx_start
                                    113 
      0004A9                        114         .org    0x04A9
      0004A9 02r50r1C         [24]  115         ljmp    rx_store
                                    116 
      002FD9                        117         .org    0x2FD9
      002FD9 02r50rFA         [24]  118         ljmp    main_poll
                                    119 
      0030E0                        120         .org    0x30E0
      0030E0 12r51r17         [24]  121         lcall   refresh_wrap
                                    122 
      005000                        123         .org    0x5000
                                    124 
                                    125 ; ---------- reset ----------
      005000                        126 init:
      005000 E4               [12]  127         clr     a
      005001 90 0E 00         [24]  128         mov     dptr,#BM_FLAG
      005004 F0               [24]  129         movx    @dptr,a
      005005 A3               [24]  130         inc     dptr                    ; FULL_REQ
      005006 F0               [24]  131         movx    @dptr,a
      005007 A3               [24]  132         inc     dptr                    ; Q_HEAD
      005008 F0               [24]  133         movx    @dptr,a
      005009 A3               [24]  134         inc     dptr                    ; Q_TAIL
      00500A F0               [24]  135         movx    @dptr,a
      00500B A3               [24]  136         inc     dptr                    ; RX_HI
      00500C F0               [24]  137         movx    @dptr,a
      00500D 12r53r37         [24]  138         lcall   dirty_clear
      005010 02 4E BF         [24]  139         ljmp    RESET_ORIG
                                    140 
                                    141 ; ---------- ontvangst (seriële interrupt) ----------
                                    142 ; begin van een telegram (vervangt MOV 2Dh,#01h; daarna laadt ASFP A en DPTR opnieuw)
      005013                        143 rx_start:
      005013 75 2D 01         [24]  144         mov     RX_IDX,#1
      005016 90 0E 04         [24]  145         mov     dptr,#RX_HI
      005019 E4               [12]  146         clr     a
      00501A F0               [24]  147         movx    @dptr,a
      00501B 22               [24]  148         ret
                                    149 
                                    150 ; teken opslaan (vervangt MOV A,2Dh / SETB C op 0x04A9)
      00501C                        151 rx_store:
      00501C 90 0E 04         [24]  152         mov     dptr,#RX_HI
      00501F E0               [24]  153         movx    a,@dptr
      005020 FF               [12]  154         mov     r7,a                    ; index hoog
      005021 70 0A            [24]  155         jnz     rs_long
      005023 E5 2D            [12]  156         mov     a,RX_IDX
      005025 D3               [12]  157         setb    c
      005026 94 F9            [12]  158         subb    a,#0xF9
      005028 50 03            [24]  159         jnc     rs_long                 ; index >= 0xFA: voorbij de ASFP-grens
      00502A 02 04 B0         [24]  160         ljmp    RX_STORE_ORIG           ; normaal: originele code
      00502D                        161 rs_long:
      00502D 90 03 5F         [24]  162         mov     dptr,#BUF               ; alleen aB en aP mogen langer zijn
      005030 E0               [24]  163         movx    a,@dptr
      005031 B4 61 35         [24]  164         cjne    a,#0x61,rs_skip
      005034 A3               [24]  165         inc     dptr
      005035 E0               [24]  166         movx    a,@dptr
      005036 B4 42 02         [24]  167         cjne    a,#0x42,rs_p
      005039 80 03            [24]  168         sjmp    rs_ok
      00503B B4 50 2B         [24]  169 rs_p:   cjne    a,#0x50,rs_skip
      00503E                        170 rs_ok:
      00503E E5 2D            [12]  171         mov     a,RX_IDX                ; index < RX_MAX ?
      005040 C3               [12]  172         clr     c
      005041 94 F4            [12]  173         subb    a,#<RX_MAX
      005043 EF               [12]  174         mov     a,r7
      005044 94 01            [12]  175         subb    a,#>RX_MAX
      005046 50 21            [24]  176         jnc     rs_skip
      005048 90 00 2E         [24]  177         mov     dptr,#RX_CS             ; checksum bijwerken
      00504B E0               [24]  178         movx    a,@dptr
      00504C 65 42            [12]  179         xrl     a,RAW_CH
      00504E F0               [24]  180         movx    @dptr,a
      00504F E5 2D            [12]  181         mov     a,RX_IDX                ; BUF[index] = teken
      005051 24 5F            [12]  182         add     a,#<BUF
      005053 F5 82            [12]  183         mov     dpl,a
      005055 EF               [12]  184         mov     a,r7
      005056 34 03            [12]  185         addc    a,#>BUF
      005058 F5 83            [12]  186         mov     dph,a
      00505A E5 43            [12]  187         mov     a,CH7
      00505C F0               [24]  188         movx    @dptr,a
      00505D 05 2D            [12]  189         inc     RX_IDX                  ; index++ (16 bit)
      00505F E5 2D            [12]  190         mov     a,RX_IDX
      005061 70 06            [24]  191         jnz     rs_skip
      005063 0F               [12]  192         inc     r7
      005064 90 0E 04         [24]  193         mov     dptr,#RX_HI
      005067 EF               [12]  194         mov     a,r7
      005068 F0               [24]  195         movx    @dptr,a
      005069                        196 rs_skip:
      005069 02 04 FB         [24]  197         ljmp    RX_AFTER                ; CR-controle zoals origineel
                                    198 
                                    199 ; ---------- telegramherkenning (seriële interrupt) ----------
      00506C                        200 ext_a:
      00506C E5 38            [12]  201         mov     a,TYPE
      00506E 60 11            [24]  202         jz      ext_ours
      005070 B4 07 02         [24]  203         cjne    a,#T_STATUS,ext_k1      ; ASFP-telegram: inhoud beëindigt bitmapmodus,
      005073 80 41            [24]  204         sjmp    ext_exit                ; status- en versievragen niet
      005075 B4 08 02         [24]  205 ext_k1: cjne    a,#T_VERSION,ext_k2
      005078 80 3C            [24]  206         sjmp    ext_exit
      00507A 90 0E 00         [24]  207 ext_k2: mov     dptr,#BM_FLAG
      00507D E4               [12]  208         clr     a
      00507E F0               [24]  209         movx    @dptr,a
      00507F 80 35            [24]  210         sjmp    ext_exit
      005081                        211 ext_ours:
      005081 90 03 5F         [24]  212         mov     dptr,#BUF
      005084 E0               [24]  213         movx    a,@dptr
      005085 B4 61 2E         [24]  214         cjne    a,#0x61,ext_exit        ; 'a'
      005088 A3               [24]  215         inc     dptr
      005089 E0               [24]  216         movx    a,@dptr
      00508A B4 50 02         [24]  217         cjne    a,#0x50,ext_c1          ; 'P'
      00508D 80 08            [24]  218         sjmp    ext_addr
      00508F B4 42 02         [24]  219 ext_c1: cjne    a,#0x42,ext_c2          ; 'B'
      005092 80 03            [24]  220         sjmp    ext_addr
      005094 B4 55 1F         [24]  221 ext_c2: cjne    a,#0x55,ext_exit        ; 'U'
      005097                        222 ext_addr:
      005097 A3               [24]  223         inc     dptr
      005098 E0               [24]  224         movx    a,@dptr
      005099 FE               [12]  225         mov     r6,a                    ; adresteken
      00509A 7D 00            [12]  226         mov     r5,#0                   ; 1 = rondzending, geen antwoord
      00509C 90 05 5B         [24]  227         mov     dptr,#ADDR
      00509F E0               [24]  228         movx    a,@dptr
      0050A0 24 30            [12]  229         add     a,#0x30
      0050A2 6E               [12]  230         xrl     a,r6
      0050A3 60 06            [24]  231         jz      ext_go
      0050A5 EE               [12]  232         mov     a,r6
      0050A6 B4 30 0D         [24]  233         cjne    a,#0x30,ext_exit
      0050A9 7D 01            [12]  234         mov     r5,#1
      0050AB                        235 ext_go:
      0050AB 12r50rB9         [24]  236         lcall   enqueue
      0050AE 40 06            [24]  237         jc      ext_exit                ; wachtrij vol: geen antwoord
      0050B0 ED               [12]  238         mov     a,r5
      0050B1 70 03            [24]  239         jnz     ext_exit
      0050B3 12r53rD8         [24]  240         lcall   reply_ok
      0050B6                        241 ext_exit:
      0050B6 02 02 04         [24]  242         ljmp    DISPATCH_TAIL
                                    243 
                                    244 ; ruw telegram (tot en met CR) naar slot Q_HEAD; C = 1 als de wachtrij vol is
                                    245 ; head en tail tellen modulo 4 (slot = teller AND 1); aantal = (head - tail) AND 3.
                                    246 ; Alleen de interrupt schrijft head, alleen de hoofdlus schrijft tail: geen vergrendeling nodig.
      0050B9                        247 enqueue:
      0050B9 90 0E 03         [24]  248         mov     dptr,#Q_TAIL
      0050BC E0               [24]  249         movx    a,@dptr
      0050BD FB               [12]  250         mov     r3,a                    ; tail
      0050BE 90 0E 02         [24]  251         mov     dptr,#Q_HEAD
      0050C1 E0               [24]  252         movx    a,@dptr
      0050C2 54 03            [12]  253         anl     a,#3
      0050C4 FA               [12]  254         mov     r2,a                    ; head
      0050C5 C3               [12]  255         clr     c
      0050C6 9B               [12]  256         subb    a,r3
      0050C7 54 03            [12]  257         anl     a,#3
      0050C9 B4 02 00         [24]  258         cjne    a,#2,eq_room            ; C = 1 als aantal < 2
      0050CC                        259 eq_room:
      0050CC 50 2A            [24]  260         jnc     eq_full
      0050CE EA               [12]  261         mov     a,r2
      0050CF 04               [12]  262         inc     a
      0050D0 54 03            [12]  263         anl     a,#3
      0050D2 FB               [12]  264         mov     r3,a                    ; nieuwe head
      0050D3 C0 A0            [24]  265         push    P2
      0050D5 EA               [12]  266         mov     a,r2
      0050D6 54 01            [12]  267         anl     a,#1                    ; slot
      0050D8 25 E0            [12]  268         add     a,acc
      0050DA 24 09            [12]  269         add     a,#QBASE
      0050DC F5 A0            [12]  270         mov     P2,a                    ; doel via MOVX @R1 (P2 = hoge byte)
      0050DE 79 00            [12]  271         mov     r1,#0
      0050E0 90 03 5F         [24]  272         mov     dptr,#BUF
      0050E3                        273 eq_loop:
      0050E3 E0               [24]  274         movx    a,@dptr
      0050E4 F3               [24]  275         movx    @r1,a
      0050E5 A3               [24]  276         inc     dptr
      0050E6 09               [12]  277         inc     r1
      0050E7 B9 00 02         [24]  278         cjne    r1,#0,eq_cr
      0050EA 05 A0            [12]  279         inc     P2
      0050EC B4 0D F4         [24]  280 eq_cr:  cjne    a,#CR,eq_loop
      0050EF D0 A0            [24]  281         pop     P2
      0050F1 90 0E 02         [24]  282         mov     dptr,#Q_HEAD
      0050F4 EB               [12]  283         mov     a,r3
      0050F5 F0               [24]  284         movx    @dptr,a
      0050F6 C3               [12]  285         clr     c
      0050F7 22               [24]  286         ret
      0050F8                        287 eq_full:
      0050F8 D3               [12]  288         setb    c
      0050F9 22               [24]  289         ret
                                    290 
                                    291 ; ---------- hoofdlus ----------
                                    292 ; vervangt MOV DPTR,#0571h op 0x2FD9: wachtrij niet leeg en geen ander verzoek -> REQ = 5
      0050FA                        293 main_poll:
      0050FA 90 0E 03         [24]  294         mov     dptr,#Q_TAIL
      0050FD E0               [24]  295         movx    a,@dptr
      0050FE F5 F0            [12]  296         mov     b,a
      005100 90 0E 02         [24]  297         mov     dptr,#Q_HEAD
      005103 E0               [24]  298         movx    a,@dptr
      005104 65 F0            [12]  299         xrl     a,b
      005106 60 09            [24]  300         jz      mp_done
      005108 90 05 71         [24]  301         mov     dptr,#REQ
      00510B E0               [24]  302         movx    a,@dptr
      00510C 70 03            [24]  303         jnz     mp_done                 ; testbeeld eerst afhandelen
      00510E 74 05            [12]  304         mov     a,#REQ_REFRESH
      005110 F0               [24]  305         movx    @dptr,a
      005111                        306 mp_done:
      005111 90 05 71         [24]  307         mov     dptr,#REQ
      005114 02 2F DC         [24]  308         ljmp    POLL_CONT
                                    309 
                                    310 ; omhulsel om de verversing (0x30E0)
      005117                        311 refresh_wrap:
      005117 90 05 71         [24]  312         mov     dptr,#REQ
      00511A E0               [24]  313         movx    a,@dptr
      00511B B4 05 11         [24]  314         cjne    a,#REQ_REFRESH,rw_plain
      00511E 12r51rBA         [24]  315         lcall   q_process
      005121 90 0E 00         [24]  316         mov     dptr,#BM_FLAG
      005124 E0               [24]  317         movx    a,@dptr
      005125 60 03            [24]  318         jz      rw_go                   ; bitmapmodus intussen beëindigd
      005127 12r52rE6         [24]  319         lcall   sh_to_fb
      00512A                        320 rw_go:
      00512A C2 10            [12]  321         clr     B_PARTIAL               ; wisseltekst stoppen
      00512C 02r51r32         [24]  322         ljmp    fast_refresh            ; alleen veranderde dots, zonder paginawachttijd
      00512F                        323 rw_plain:
      00512F 02 06 92         [24]  324         ljmp    REFRESH                 ; testbeeld: origineel gedrag
                                    325 
                                    326 ; ---------- snelle verversing (hoofdlus) ----------
                                    327 ; Vervangt 0x0692 voor de bitmapmodus. 0x0692 rekent voor elk van de (tot) 1792 dots
                                    328 ; apart het verschil uit (645 ms bij 6 MHz, ook als er niets verandert) en wacht bij
                                    329 ; wisseltekst eerst de paginatijd af. Deze routine vergelijkt per kolom de 16-bit woorden
                                    330 ; en vraagt alleen voor veranderde dots een puls aan, op dezelfde manier als 0x0692:
                                    331 ; 056B = rij, 056C = kolom, 21h.6 = kleur (XOR 21h.7 'omgekeerd'), 21h.4 = puls gevraagd;
                                    332 ; de timer-interrupt geeft de puls en wist 21h.4. Rijmaskers uit de ASFP-tabel (10h:11h).
                           000010   333 ROWMASK_H  = 0x10          ; iRAM: pointer naar rijmasker-tabel (code), hoog
                           000011   334 ROWMASK_L  = 0x11          ;                                        laag
                           00056B   335 DOT_ROW    = 0x056B
                           00056C   336 DOT_COL    = 0x056C
                           00000C   337 B_DOTREQ   = 0x0C          ; 21h.4
                           00000E   338 B_COLOR    = 0x0E          ; 21h.6
                           00000F   339 B_INVERSE  = 0x0F          ; 21h.7
                           000087   340 PCON       = 0x87
                           000554   341 DISP_BUSY  = 0x0554        ; 0x0692 zet deze op 0 na afloop
                                    342 
      005132                        343 fast_refresh:
      005132 12r53r41         [24]  344         lcall   dirty_start             ; alleen gewijzigde kolommen
      005135                        345 fr_col:
      005135 12r53r5C         [24]  346         lcall   in_range
      005138 50 78            [24]  347         jnc     fr_done
      00513A 7E 05            [12]  348         mov     r6,#>FB_NEW
      00513C 7F 7E            [12]  349         mov     r7,#<FB_NEW
      00513E 12r53r72         [24]  350         lcall   colptr
      005141 E0               [24]  351         movx    a,@dptr
