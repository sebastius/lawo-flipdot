                                      1 ; ASFP-bitmap: uitbreiding van ASFP.bin (LAWO AZR 802/24) met pixel-, bitmap- en
                                      2 ; ververs-telegrammen en gedeeltelijke verversing (partial update).
                                      3 ; Alleen getest in de emulator (emulator/), niet op hardware.
                                      4 ;
                                      5 ; Nieuwe IBIS-telegrammen (CR + XOR-checksum zoals altijd):
                                      6 ;   aP<a><XXX><YY><C>[<XXX><YY><C>...]   pixels: kolom (3 cijfers), rij (2 cijfers, 0 = boven),
                                      7 ;                                        kleur 0 = zwart / 1 = geel
                                      8 ;   aB<a><XXX><HHHH>[<HHHH>...]          kolommen vanaf XXX; per kolom 16 bits hex,
                                      9 ;                                        bit y = rij y van boven (0001 = bovenste dot)
                                     10 ;   aU<a>                                alle dots opnieuw omzetten (tegen vastzittende dots)
                                     11 ; <a> = displayadres als teken ('1'..'?'); '0' = alle displays, dan geen antwoord.
                                     12 ; aB en aP mogen tot 500 tekens lang zijn (ASFP: 250), zodat een volledige bitmap van
                                     13 ; 112 x 16 (455 tekens) in één telegram past.
                                     14 ; Na elk geaccepteerd telegram antwoordt het display "a0"; daarna worden alleen de
                                     15 ; veranderde dots omgezet. Is de wachtrij vol, dan volgt geen antwoord (later opnieuw).
                                     16 ;
                                     17 ; Bitmapmodus: het eerste pixel/bitmap-telegram neemt het getoonde beeld over in een
                                     18 ; schaduwbuffer; daarna tekent alles in die schaduw. Een inhoudelijk ASFP-telegram
                                     19 ; (tekst, lijn, bestemming, testbeeld, ...) beëindigt de bitmapmodus; status- en
                                     20 ; versievragen (a<a>, aV<a>) niet.
                                     21 ;
                                     22 ; Werking in ASFP:
                                     23 ;   0x035F  ontvangstbuffer, index iRAM 2Dh (8 bit, max 0xF9); 0x0553 = ontvangststatus
                                     24 ;   0x057E  gewenst beeld, 2 bytes per kolom (hoog, laag); bit y = rij y van boven
                                     25 ;   0x07AE  getoond beeld (kopie na elke verversing)
                                     26 ;   0x0692  verversroutine; slaat onveranderde dots alleen over als 22h.0 = 1
                                     27 ;   22h.0   "wisseltekst actief": zolang gezet tekent de hoofdlus steeds de volgende pagina
                                     28 ;   0x0571  verzoek aan de hoofdlus (testbeeld aT gebruikt 1..4); 5 = verversen zonder vullen
                                     29 ;
                                     30 ; Opbouw van de patch:
                                     31 ;   - Ontvangst (interrupt): voor aB/aP telt de index door tot 500 (extra byte RX_HI).
                                     32 ;   - Herkenning (interrupt): adres controleren en het ruwe telegram in een wachtrij
                                     33 ;     kopiëren (2 x 512 bytes), "a0" antwoorden. Kort, zodat er geen tekens verloren gaan.
                                     34 ;   - Hoofdlus: zolang de wachtrij niet leeg is wordt 0x0571 = 5. Het omhulsel om de
                                     35 ;     verversing verwerkt dan alle telegrammen in de schaduw, kopieert die naar 0x057E en
                                     36 ;     ververst met 22h.0 = 1 (alleen verschillen); daarna 22h.0 = 0 (wisseltekst stopt).
                                     37 ;   - Reset: eigen variabelen wissen (het werk-RAM is batterijgebufferd).
                                     38 ;
                                     39 ; Haken in ASFP (origineel -> patch):
                                     40 ;   0x0000  LJMP 0x4EBF            -> LJMP init
                                     41 ;   0x001F  (opvulling 00 00 00)   -> LJMP ext_a
                                     42 ;   0x018B  SJMP 0x0204            -> AJMP 0x001F    (einde a-telegramherkenning)
                                     43 ;   0x0481  MOV 2Dh,#01h           -> LCALL rx_start (begin telegram)
                                     44 ;   0x04A9  MOV A,2Dh / SETB C     -> LJMP rx_store  (teken opslaan)
                                     45 ;   0x2FD9  MOV DPTR,#0571h        -> LJMP main_poll (hoofdlus)
                                     46 ;   0x30E0  LCALL 0x0692           -> LCALL refresh_wrap
                                     47 ; Nieuwe code vanaf 0x5000 (was 0xFF). Werk-RAM 0x0900-0x0F27 (ASFP gebruikt tot 0x08D0).
                                     48 ;
                                     49 ; Interruptcode draait in registerbank 1, hoofdluscode in bank 0. Gebruikt worden alleen
                                     50 ; R0-R7, ACC, B, DPTR en (tijdelijk, met herstel) P2, net als de ASFP-routines.
                                     51 
                                     52         .module asfp_bitmap
                                     53         .area   PATCH (ABS,CODE)
                                     54 
                                     55 ; ---------- ASFP ----------
                           00035F    56 BUF        = 0x035F        ; ontvangstbuffer, afgesloten met CR
                           00002E    57 RX_CS      = 0x002E        ; lopende checksum
                           000042    58 RAW_CH     = 0x42          ; iRAM: ontvangen byte incl. pariteit
                           000043    59 CH7        = 0x43          ; iRAM: ontvangen teken (7 bit)
                           00002D    60 RX_IDX     = 0x2D          ; iRAM: ontvangstindex (laag)
                           00055B    61 ADDR       = 0x055B        ; displayadres (binair)
                           00055C    62 WIDTH      = 0x055C        ; breedte in kolommen
                           00055D    63 HEIGHT     = 0x055D        ; hoogte in rijen
                           00057E    64 FB_NEW     = 0x057E        ; gewenst beeld
                           0007AE    65 FB_OLD     = 0x07AE        ; getoond beeld
                           000571    66 REQ        = 0x0571        ; verzoek aan hoofdlus
                           000005    67 REQ_REFRESH = 5
                           00031E    68 TXBUF      = 0x031E
                           00002F    69 TXLEN      = 0x002F
                           000555    70 TXIDX      = 0x0555
                           000038    71 TYPE       = 0x38          ; iRAM: telegramtype in de verdeler (0 = onbekend)
                           000007    72 T_STATUS   = 7
                           000008    73 T_VERSION  = 8
                           00003A    74 LEN_CS     = 0x3A          ; iRAM: lengte voor de checksumroutine
                           000204    75 DISPATCH_TAIL = 0x0204
                           0000B2    76 REPLY_CS   = 0x00B2
                           000692    77 REFRESH    = 0x0692
                           004EBF    78 RESET_ORIG = 0x4EBF
                           0004B0    79 RX_STORE_ORIG = 0x04B0     ; origineel: opslaan, aA-kopie, INC 2Dh
                           0004FB    80 RX_AFTER   = 0x04FB        ; origineel: CR-controle
                           002FDC    81 POLL_CONT  = 0x2FDC        ; origineel: MOVX A,@DPTR (DPTR = 0x0571)
                           000004    82 B_TXBUSY   = 0x04          ; 20h.4
                           000099    83 B_TI       = 0x99          ; SCON.1
                           000010    84 B_PARTIAL  = 0x10          ; 22h.0
                           0000A0    85 P2         = 0xA0
                                     86 
                                     87 ; ---------- eigen werk-RAM ----------
                           000009    88 QBASE      = 0x09          ; wachtrij: slot i op (QBASE + 2*i) * 256, 512 bytes per slot
                           000E00    89 BM_FLAG    = 0x0E00        ; 1 = bitmapmodus (schaduw geldig)
                           000E01    90 FULL_REQ   = 0x0E01        ; 1 = volgende verversing alles omzetten
                           000E02    91 Q_HEAD     = 0x0E02        ; volgend te vullen slot (0/1)
                           000E03    92 Q_TAIL     = 0x0E03        ; volgend te verwerken slot (0/1)
                           000E04    93 RX_HI      = 0x0E04        ; ontvangstindex (hoog) voor lange telegrammen
                           000E10    94 SH         = 0x0E10        ; schaduwbuffer, max 140 kolommen x 2 bytes
                           0001F4    95 RX_MAX     = 0x01F4        ; max. lengte aB/aP incl. CR (buffer tot vlak voor 0x0553)
                                     96 
                           00000D    97 CR         = 0x0D
                                     98 
                                     99 ; ---------- haken ----------
      000000                        100         .org    0x0000
      000000 02r50r00         [24]  101         ljmp    init
                                    102 
      00001F                        103         .org    0x001F
      00001F 02r50r69         [24]  104         ljmp    ext_a
                                    105 
      00018B                        106         .org    0x018B
      00018B 00 1F            [12]  107         ajmp    0x001F
                                    108 
      000481                        109         .org    0x0481
      000481 12r50r10         [24]  110         lcall   rx_start
                                    111 
      0004A9                        112         .org    0x04A9
      0004A9 02r50r19         [24]  113         ljmp    rx_store
                                    114 
      002FD9                        115         .org    0x2FD9
      002FD9 02r50rEE         [24]  116         ljmp    main_poll
                                    117 
      0030E0                        118         .org    0x30E0
      0030E0 12r51r0B         [24]  119         lcall   refresh_wrap
                                    120 
      005000                        121         .org    0x5000
                                    122 
                                    123 ; ---------- reset ----------
      005000                        124 init:
      005000 E4               [12]  125         clr     a
      005001 90 0E 00         [24]  126         mov     dptr,#BM_FLAG
      005004 F0               [24]  127         movx    @dptr,a
      005005 A3               [24]  128         inc     dptr                    ; FULL_REQ
      005006 F0               [24]  129         movx    @dptr,a
      005007 A3               [24]  130         inc     dptr                    ; Q_HEAD
      005008 F0               [24]  131         movx    @dptr,a
      005009 A3               [24]  132         inc     dptr                    ; Q_TAIL
      00500A F0               [24]  133         movx    @dptr,a
      00500B A3               [24]  134         inc     dptr                    ; RX_HI
      00500C F0               [24]  135         movx    @dptr,a
      00500D 02 4E BF         [24]  136         ljmp    RESET_ORIG
                                    137 
                                    138 ; ---------- ontvangst (seriële interrupt) ----------
                                    139 ; begin van een telegram (vervangt MOV 2Dh,#01h; daarna laadt ASFP A en DPTR opnieuw)
      005010                        140 rx_start:
      005010 75 2D 01         [24]  141         mov     RX_IDX,#1
      005013 90 0E 04         [24]  142         mov     dptr,#RX_HI
      005016 E4               [12]  143         clr     a
      005017 F0               [24]  144         movx    @dptr,a
      005018 22               [24]  145         ret
                                    146 
                                    147 ; teken opslaan (vervangt MOV A,2Dh / SETB C op 0x04A9)
      005019                        148 rx_store:
      005019 90 0E 04         [24]  149         mov     dptr,#RX_HI
      00501C E0               [24]  150         movx    a,@dptr
      00501D FF               [12]  151         mov     r7,a                    ; index hoog
      00501E 70 0A            [24]  152         jnz     rs_long
      005020 E5 2D            [12]  153         mov     a,RX_IDX
      005022 D3               [12]  154         setb    c
      005023 94 F9            [12]  155         subb    a,#0xF9
      005025 50 03            [24]  156         jnc     rs_long                 ; index >= 0xFA: voorbij de ASFP-grens
      005027 02 04 B0         [24]  157         ljmp    RX_STORE_ORIG           ; normaal: originele code
      00502A                        158 rs_long:
      00502A 90 03 5F         [24]  159         mov     dptr,#BUF               ; alleen aB en aP mogen langer zijn
      00502D E0               [24]  160         movx    a,@dptr
      00502E B4 61 35         [24]  161         cjne    a,#0x61,rs_skip
      005031 A3               [24]  162         inc     dptr
      005032 E0               [24]  163         movx    a,@dptr
      005033 B4 42 02         [24]  164         cjne    a,#0x42,rs_p
      005036 80 03            [24]  165         sjmp    rs_ok
      005038 B4 50 2B         [24]  166 rs_p:   cjne    a,#0x50,rs_skip
      00503B                        167 rs_ok:
      00503B E5 2D            [12]  168         mov     a,RX_IDX                ; index < RX_MAX ?
      00503D C3               [12]  169         clr     c
      00503E 94 F4            [12]  170         subb    a,#<RX_MAX
      005040 EF               [12]  171         mov     a,r7
      005041 94 01            [12]  172         subb    a,#>RX_MAX
      005043 50 21            [24]  173         jnc     rs_skip
      005045 90 00 2E         [24]  174         mov     dptr,#RX_CS             ; checksum bijwerken
      005048 E0               [24]  175         movx    a,@dptr
      005049 65 42            [12]  176         xrl     a,RAW_CH
      00504B F0               [24]  177         movx    @dptr,a
      00504C E5 2D            [12]  178         mov     a,RX_IDX                ; BUF[index] = teken
      00504E 24 5F            [12]  179         add     a,#<BUF
      005050 F5 82            [12]  180         mov     dpl,a
      005052 EF               [12]  181         mov     a,r7
      005053 34 03            [12]  182         addc    a,#>BUF
      005055 F5 83            [12]  183         mov     dph,a
      005057 E5 43            [12]  184         mov     a,CH7
      005059 F0               [24]  185         movx    @dptr,a
      00505A 05 2D            [12]  186         inc     RX_IDX                  ; index++ (16 bit)
      00505C E5 2D            [12]  187         mov     a,RX_IDX
      00505E 70 06            [24]  188         jnz     rs_skip
      005060 0F               [12]  189         inc     r7
      005061 90 0E 04         [24]  190         mov     dptr,#RX_HI
      005064 EF               [12]  191         mov     a,r7
      005065 F0               [24]  192         movx    @dptr,a
      005066                        193 rs_skip:
      005066 02 04 FB         [24]  194         ljmp    RX_AFTER                ; CR-controle zoals origineel
                                    195 
                                    196 ; ---------- telegramherkenning (seriële interrupt) ----------
      005069                        197 ext_a:
      005069 E5 38            [12]  198         mov     a,TYPE
      00506B 60 11            [24]  199         jz      ext_ours
      00506D B4 07 02         [24]  200         cjne    a,#T_STATUS,ext_k1      ; ASFP-telegram: inhoud beëindigt bitmapmodus,
      005070 80 41            [24]  201         sjmp    ext_exit                ; status- en versievragen niet
      005072 B4 08 02         [24]  202 ext_k1: cjne    a,#T_VERSION,ext_k2
      005075 80 3C            [24]  203         sjmp    ext_exit
      005077 90 0E 00         [24]  204 ext_k2: mov     dptr,#BM_FLAG
      00507A E4               [12]  205         clr     a
      00507B F0               [24]  206         movx    @dptr,a
      00507C 80 35            [24]  207         sjmp    ext_exit
      00507E                        208 ext_ours:
      00507E 90 03 5F         [24]  209         mov     dptr,#BUF
      005081 E0               [24]  210         movx    a,@dptr
      005082 B4 61 2E         [24]  211         cjne    a,#0x61,ext_exit        ; 'a'
      005085 A3               [24]  212         inc     dptr
      005086 E0               [24]  213         movx    a,@dptr
      005087 B4 50 02         [24]  214         cjne    a,#0x50,ext_c1          ; 'P'
      00508A 80 08            [24]  215         sjmp    ext_addr
      00508C B4 42 02         [24]  216 ext_c1: cjne    a,#0x42,ext_c2          ; 'B'
      00508F 80 03            [24]  217         sjmp    ext_addr
      005091 B4 55 1F         [24]  218 ext_c2: cjne    a,#0x55,ext_exit        ; 'U'
      005094                        219 ext_addr:
      005094 A3               [24]  220         inc     dptr
      005095 E0               [24]  221         movx    a,@dptr
      005096 FE               [12]  222         mov     r6,a                    ; adresteken
      005097 7D 00            [12]  223         mov     r5,#0                   ; 1 = rondzending, geen antwoord
      005099 90 05 5B         [24]  224         mov     dptr,#ADDR
      00509C E0               [24]  225         movx    a,@dptr
      00509D 24 30            [12]  226         add     a,#0x30
      00509F 6E               [12]  227         xrl     a,r6
      0050A0 60 06            [24]  228         jz      ext_go
      0050A2 EE               [12]  229         mov     a,r6
      0050A3 B4 30 0D         [24]  230         cjne    a,#0x30,ext_exit
      0050A6 7D 01            [12]  231         mov     r5,#1
      0050A8                        232 ext_go:
      0050A8 12r50rB6         [24]  233         lcall   enqueue
      0050AB 40 06            [24]  234         jc      ext_exit                ; wachtrij vol: geen antwoord
      0050AD ED               [12]  235         mov     a,r5
      0050AE 70 03            [24]  236         jnz     ext_exit
      0050B0 12r52rF9         [24]  237         lcall   reply_ok
      0050B3                        238 ext_exit:
      0050B3 02 02 04         [24]  239         ljmp    DISPATCH_TAIL
                                    240 
                                    241 ; ruw telegram (tot en met CR) naar slot Q_HEAD; C = 1 als de wachtrij vol is
      0050B6                        242 enqueue:
      0050B6 90 0E 02         [24]  243         mov     dptr,#Q_HEAD
      0050B9 E0               [24]  244         movx    a,@dptr
      0050BA 54 01            [12]  245         anl     a,#1
      0050BC FA               [12]  246         mov     r2,a                    ; head
      0050BD 04               [12]  247         inc     a
      0050BE 54 01            [12]  248         anl     a,#1
      0050C0 FB               [12]  249         mov     r3,a                    ; head + 1
      0050C1 90 0E 03         [24]  250         mov     dptr,#Q_TAIL
      0050C4 E0               [24]  251         movx    a,@dptr
      0050C5 54 01            [12]  252         anl     a,#1
      0050C7 6B               [12]  253         xrl     a,r3
      0050C8 60 22            [24]  254         jz      eq_full
      0050CA C0 A0            [24]  255         push    P2
      0050CC EA               [12]  256         mov     a,r2
      0050CD 2A               [12]  257         add     a,r2
      0050CE 24 09            [12]  258         add     a,#QBASE
      0050D0 F5 A0            [12]  259         mov     P2,a                    ; doel via MOVX @R1 (P2 = hoge byte)
      0050D2 79 00            [12]  260         mov     r1,#0
      0050D4 90 03 5F         [24]  261         mov     dptr,#BUF
      0050D7                        262 eq_loop:
      0050D7 E0               [24]  263         movx    a,@dptr
      0050D8 F3               [24]  264         movx    @r1,a
      0050D9 A3               [24]  265         inc     dptr
      0050DA 09               [12]  266         inc     r1
      0050DB B9 00 02         [24]  267         cjne    r1,#0,eq_cr
      0050DE 05 A0            [12]  268         inc     P2
      0050E0 B4 0D F4         [24]  269 eq_cr:  cjne    a,#CR,eq_loop
      0050E3 D0 A0            [24]  270         pop     P2
      0050E5 90 0E 02         [24]  271         mov     dptr,#Q_HEAD
      0050E8 EB               [12]  272         mov     a,r3
      0050E9 F0               [24]  273         movx    @dptr,a
      0050EA C3               [12]  274         clr     c
      0050EB 22               [24]  275         ret
      0050EC                        276 eq_full:
      0050EC D3               [12]  277         setb    c
      0050ED 22               [24]  278         ret
                                    279 
                                    280 ; ---------- hoofdlus ----------
                                    281 ; vervangt MOV DPTR,#0571h op 0x2FD9: wachtrij niet leeg en geen ander verzoek -> REQ = 5
      0050EE                        282 main_poll:
      0050EE 90 0E 03         [24]  283         mov     dptr,#Q_TAIL
      0050F1 E0               [24]  284         movx    a,@dptr
      0050F2 F5 F0            [12]  285         mov     b,a
      0050F4 90 0E 02         [24]  286         mov     dptr,#Q_HEAD
      0050F7 E0               [24]  287         movx    a,@dptr
      0050F8 65 F0            [12]  288         xrl     a,b
      0050FA 60 09            [24]  289         jz      mp_done
      0050FC 90 05 71         [24]  290         mov     dptr,#REQ
      0050FF E0               [24]  291         movx    a,@dptr
      005100 70 03            [24]  292         jnz     mp_done                 ; testbeeld eerst afhandelen
      005102 74 05            [12]  293         mov     a,#REQ_REFRESH
      005104 F0               [24]  294         movx    @dptr,a
      005105                        295 mp_done:
      005105 90 05 71         [24]  296         mov     dptr,#REQ
      005108 02 2F DC         [24]  297         ljmp    POLL_CONT
                                    298 
                                    299 ; omhulsel om de verversing (0x30E0)
      00510B                        300 refresh_wrap:
      00510B 90 05 71         [24]  301         mov     dptr,#REQ
      00510E E0               [24]  302         movx    a,@dptr
      00510F B4 05 14         [24]  303         cjne    a,#REQ_REFRESH,rw_plain
      005112 12r51r29         [24]  304         lcall   q_process
      005115 90 0E 00         [24]  305         mov     dptr,#BM_FLAG
      005118 E0               [24]  306         movx    a,@dptr
      005119 60 03            [24]  307         jz      rw_go                   ; bitmapmodus intussen beëindigd
      00511B 12r52r3B         [24]  308         lcall   sh_to_fb
      00511E                        309 rw_go:
      00511E D2 10            [12]  310         setb    B_PARTIAL               ; alleen veranderde dots omzetten
      005120 12 06 92         [24]  311         lcall   REFRESH
      005123 C2 10            [12]  312         clr     B_PARTIAL               ; geen wisseltekst meer
      005125 22               [24]  313         ret
      005126                        314 rw_plain:
      005126 02 06 92         [24]  315         ljmp    REFRESH                 ; testbeeld: origineel gedrag
                                    316 
                                    317 ; alle wachtende telegrammen verwerken in de schaduw
      005129                        318 q_process:
      005129 90 0E 03         [24]  319         mov     dptr,#Q_TAIL
      00512C E0               [24]  320         movx    a,@dptr
      00512D 54 01            [12]  321         anl     a,#1
      00512F FD               [12]  322         mov     r5,a                    ; tail
      005130 90 0E 02         [24]  323         mov     dptr,#Q_HEAD
      005133 E0               [24]  324         movx    a,@dptr
      005134 54 01            [12]  325         anl     a,#1
      005136 6D               [12]  326         xrl     a,r5
      005137 60 33            [24]  327         jz      qp_end
      005139 12r52r0F         [24]  328         lcall   bm_enter                ; schaduw = getoond beeld (eerste keer)
      00513C ED               [12]  329         mov     a,r5
      00513D 2D               [12]  330         add     a,r5
      00513E 24 09            [12]  331         add     a,#QBASE
      005140 F5 83            [12]  332         mov     dph,a
      005142 75 82 01         [24]  333         mov     dpl,#1
      005145 E0               [24]  334         movx    a,@dptr                 ; commando
      005146 F5 F0            [12]  335         mov     b,a
      005148 A3               [24]  336         inc     dptr
      005149 A3               [24]  337         inc     dptr                    ; eerste dataveld
      00514A E5 F0            [12]  338         mov     a,b
      00514C B4 50 05         [24]  339         cjne    a,#0x50,qp_1
      00514F 12r51r6D         [24]  340         lcall   do_pixels
      005152 80 0E            [24]  341         sjmp    qp_next
      005154 B4 42 05         [24]  342 qp_1:   cjne    a,#0x42,qp_2
      005157 12r51rCB         [24]  343         lcall   do_bitmap
      00515A 80 06            [24]  344         sjmp    qp_next
      00515C 90 0E 01         [24]  345 qp_2:   mov     dptr,#FULL_REQ          ; 'U'
      00515F 74 01            [12]  346         mov     a,#1
      005161 F0               [24]  347         movx    @dptr,a
      005162                        348 qp_next:
      005162 ED               [12]  349         mov     a,r5
      005163 04               [12]  350         inc     a
      005164 54 01            [12]  351         anl     a,#1
      005166 90 0E 03         [24]  352         mov     dptr,#Q_TAIL
      005169 F0               [24]  353         movx    @dptr,a
      00516A 80 BD            [24]  354         sjmp    q_process
      00516C                        355 qp_end:
      00516C 22               [24]  356         ret
                                    357 
                                    358 ; ---------- aP: pixels in de schaduw ----------
      00516D                        359 do_pixels:
      00516D E0               [24]  360         movx    a,@dptr
      00516E B4 0D 01         [24]  361         cjne    a,#CR,px_go
      005171 22               [24]  362         ret
