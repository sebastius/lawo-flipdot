                                    986 ; a naar TXBUF[r2], r2++
      0054D0                        987 put_ch:
      0054D0 C0 E0            [24]  988         push    acc
      0054D2 EA               [12]  989         mov     a,r2
      0054D3 24 1E            [12]  990         add     a,#<TXBUF
      0054D5 F5 82            [12]  991         mov     dpl,a
      0054D7 E4               [12]  992         clr     a
      0054D8 34 03            [12]  993         addc    a,#>TXBUF
      0054DA F5 83            [12]  994         mov     dph,a
      0054DC D0 E0            [24]  995         pop     acc
      0054DE F0               [24]  996         movx    @dptr,a
      0054DF 0A               [12]  997         inc     r2
      0054E0 22               [24]  998         ret
