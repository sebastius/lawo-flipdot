      005455 2F               [12]  906         add     a,r7
      005456 F5 82            [12]  907         mov     dpl,a
      005458 E8               [12]  908         mov     a,r0
      005459 3E               [12]  909         addc    a,r6
      00545A F5 83            [12]  910         mov     dph,a
      00545C 22               [24]  911         ret
