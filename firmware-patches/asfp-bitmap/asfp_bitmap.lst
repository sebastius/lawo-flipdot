      0053CF 9C               [12]  812         subb    a,r4
      0053D0 40 03            [24]  813         jc      ir_no
      0053D2 02r53rD7         [24]  814         ljmp    x_lt_width
      0053D5 C3               [12]  815 ir_no:  clr     c
      0053D6 22               [24]  816         ret
                                    817 
