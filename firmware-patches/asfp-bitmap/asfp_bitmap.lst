                                    856 ; drie cijfers -> a (0..255); C = 1 bij fout of > 255
      0053FC                        857 getnum3:
      0053FC 12r53rEE         [24]  858         lcall   getdig
      0053FF 40 1D            [24]  859         jc      gn_bad
      005401 75 F0 64         [24]  860         mov     b,#100
      005404 A4               [48]  861         mul     ab
      005405 F8               [12]  862         mov     r0,a
      005406 E5 F0            [12]  863         mov     a,b
      005408 70 14            [24]  864         jnz     gn_bad
      00540A 12r53rEE         [24]  865         lcall   getdig
      00540D 40 0F            [24]  866         jc      gn_bad
      00540F 75 F0 0A         [24]  867         mov     b,#10
      005412 A4               [48]  868         mul     ab
      005413 28               [12]  869         add     a,r0
      005414 40 08            [24]  870         jc      gn_bad
      005416 F8               [12]  871         mov     r0,a
      005417 12r53rEE         [24]  872         lcall   getdig
      00541A 40 02            [24]  873         jc      gn_bad
      00541C 28               [12]  874         add     a,r0
      00541D 22               [24]  875         ret                             ; C uit add: 1 bij overloop
      00541E D3               [12]  876 gn_bad: setb    c
      00541F 22               [24]  877         ret
