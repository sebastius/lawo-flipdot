                                    753 ; ---------- hulproutines ----------
                                    754 ; bereik gewijzigde kolommen
      00539A                        755 dirty_clear:
      00539A 90 0E 05         [24]  756         mov     dptr,#DIRTY_MIN
      00539D 74 FF            [12]  757         mov     a,#0xFF
      00539F F0               [24]  758         movx    @dptr,a
