      005430 40 16            [24]  896 gh_c1:  jc      gh_ok                   ; '0'..'9'
      005432 C3               [12]  897         clr     c
      005433 94 11            [12]  898         subb    a,#17                   ; 'A' -> 0
      005435 40 13            [24]  899         jc      gh_bad
      005437 B4 06 00         [24]  900         cjne    a,#6,gh_c2
      00543A 40 0A            [24]  901 gh_c2:  jc      gh_let                  ; 'A'..'F'
