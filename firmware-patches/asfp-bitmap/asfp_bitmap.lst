      0053E1 2C               [12]  831         add     a,r4
      0053E2 F8               [12]  832         mov     r0,a
      0053E3 E4               [12]  833         clr     a
      0053E4 33               [12]  834         rlc     a
      0053E5 C8               [12]  835         xch     a,r0                    ; a = laag, r0 = hoog
      0053E6 2F               [12]  836         add     a,r7
      0053E7 F5 82            [12]  837         mov     dpl,a
      0053E9 E8               [12]  838         mov     a,r0
      0053EA 3E               [12]  839         addc    a,r6
      0053EB F5 83            [12]  840         mov     dph,a
      0053ED 22               [24]  841         ret
