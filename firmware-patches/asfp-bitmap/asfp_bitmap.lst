                                    646 ; antwoord "a0" + CR + checksum, zoals ASFP bij statusvragen doet
      0052F9                        647 reply_ok:
      0052F9 90 03 1E         [24]  648         mov     dptr,#TXBUF
      0052FC 74 61            [12]  649         mov     a,#0x61
      0052FE F0               [24]  650         movx    @dptr,a
      0052FF A3               [24]  651         inc     dptr
      005300 74 30            [12]  652         mov     a,#0x30
      005302 F0               [24]  653         movx    @dptr,a
      005303 A3               [24]  654         inc     dptr
      005304 74 0D            [12]  655         mov     a,#CR
      005306 F0               [24]  656         movx    @dptr,a
      005307 75 3A 03         [24]  657         mov     LEN_CS,#3
      00530A 12 00 B2         [24]  658         lcall   REPLY_CS
      00530D 90 00 2F         [24]  659         mov     dptr,#TXLEN
      005310 74 04            [12]  660         mov     a,#4
      005312 F0               [24]  661         movx    @dptr,a
      005313 D2 04            [12]  662         setb    B_TXBUSY
      005315 90 05 55         [24]  663         mov     dptr,#TXIDX
      005318 E4               [12]  664         clr     a
      005319 F0               [24]  665         movx    @dptr,a
      00531A D2 99            [12]  666         setb    B_TI
      00531C 22               [24]  667         ret
