                                    969 ; a als twee hextekens naar TXBUF (gebruikt r3)
      0054B5                        970 put_hex:
      0054B5 FB               [12]  971         mov     r3,a
      0054B6 C4               [12]  972         swap    a
      0054B7 12r54rC4         [24]  973         lcall   hexch
      0054BA 12r54rD0         [24]  974         lcall   put_ch
      0054BD EB               [12]  975         mov     a,r3
      0054BE 12r54rC4         [24]  976         lcall   hexch
      0054C1 02r54rD0         [24]  977         ljmp    put_ch
                                    978 
      0054C4 54 0F            [12]  979 hexch:  anl     a,#0x0F
      0054C6 B4 0A 00         [24]  980         cjne    a,#10,hx_c
      0054C9 40 02            [24]  981 hx_c:   jc      hx_d
      0054CB 24 07            [12]  982         add     a,#7
      0054CD 24 30            [12]  983 hx_d:   add     a,#0x30
      0054CF 22               [24]  984         ret
