      00527D                        572 px_go:
      00527D 12r54r02         [24]  573         lcall   getnum3
      005280 40 59            [24]  574         jc      px_end
      005282 12r55r2C         [24]  575         lcall   add_xoff
      005285 FC               [12]  576         mov     r4,a                    ; x (+ verschuiving)
      005286 12r53rF4         [24]  577         lcall   getdig
      005289 40 50            [24]  578         jc      px_end
      00528B 75 F0 0A         [24]  579         mov     b,#10
