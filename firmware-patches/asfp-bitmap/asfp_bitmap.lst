                                   1023 ; volgorde van de 28 bytes in het aD-antwoord (zie README)
      0054E7                       1024 diag_tab:
      0054E7 0E 02 0E 03           1025         .db     >Q_HEAD, <Q_HEAD,       >Q_TAIL, <Q_TAIL
      0054EB 0E 00 0E 01           1026         .db     >BM_FLAG, <BM_FLAG,     >FULL_REQ, <FULL_REQ
      0054EF 0E 05 0E 06           1027         .db     >DIRTY_MIN, <DIRTY_MIN, >DIRTY_MAX, <DIRTY_MAX
      0054F3 05 71 05 54           1028         .db     >REQ, <REQ,             >DISP_BUSY, <DISP_BUSY
      0054F7 0E 07 0E 08           1029         .db     >CNT_POLL5, <CNT_POLL5, >CNT_ITEMS, <CNT_ITEMS
      0054FB 0E 09 0E 0A 0E 0B     1030         .db     >CNT_FR, <CNT_FR,       >CNT_DOT_H, <CNT_DOT_H, >CNT_DOT_L, <CNT_DOT_L
      005501 FE 10 FE 11           1031         .db     0xFE, 0x10,  0xFE, 0x11                         ; rijmasker-pointer
      005505 FE 20 FE 21 FE 22     1032         .db     0xFE, 0x20,  0xFE, 0x21,  0xFE, 0x22            ; bitvariabelen
      00550B FD 00                 1033         .db     0xFD, 0x00                                      ; P1
      00550D 05 5C 05 5D           1034         .db     >WIDTH, <WIDTH,         >HEIGHT, <HEIGHT
      005511 00 10                 1035         .db     0x00, 0x10                                      ; xdata 0x0010 (timer-isr)
      005513 05 88 05 89           1036         .db     >(FB_NEW+10), <(FB_NEW+10), >(FB_NEW+11), <(FB_NEW+11)   ; kolom 5
      005517 07 B8 07 B9           1037         .db     >(FB_OLD+10), <(FB_OLD+10), >(FB_OLD+11), <(FB_OLD+11)
      00551B 0E 1A 0E 1B           1038         .db     >(SH+10), <(SH+10),     >(SH+11), <(SH+11)
      00551F FF FF                 1039         .db     0xFF, 0xFF
