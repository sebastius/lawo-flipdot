                                    827 ; cijfer op @dptr -> a (0..9), dptr++; C = 1 als geen cijfer
      0053E3                        828 getdig:
      0053E3 E0               [24]  829         movx    a,@dptr
      0053E4 A3               [24]  830         inc     dptr
      0053E5 C3               [12]  831         clr     c
      0053E6 94 30            [12]  832         subb    a,#0x30
      0053E8 40 05            [24]  833         jc      gd_bad
      0053EA B4 0A 00         [24]  834         cjne    a,#10,gd_cmp
      0053ED B3               [12]  835 gd_cmp: cpl     c                       ; C was 1 als a < 10
      0053EE 22               [24]  836         ret
      0053EF D3               [12]  837 gd_bad: setb    c
      0053F0 22               [24]  838         ret
