                                      1 ; ASFP-bitmap: uitbreiding van ASFP.bin (LAWO AZR 802/24) met pixel-, bitmap- en
                                      2 ; ververs-telegrammen en gedeeltelijke verversing (partial update).
                                      3 ; Getest in de emulator (emulator/). Op hardware (17-11-2026): telegrammen worden aangenomen,
                                      4 ; maar er klapten nog geen dots om; daarom het diagnosetelegram aD.
                                      5 ;
                                      6 ; Nieuwe IBIS-telegrammen (CR + XOR-checksum zoals altijd):
                                      7 ;   aP<a><XXX><YY><C>[<XXX><YY><C>...]   pixels: kolom (3 cijfers), rij (2 cijfers, 0 = boven),
                                      8 ;                                        kleur 0 = zwart / 1 = geel
                                      9 ;   aB<a><XXX><HHHH>[<HHHH>...]          kolommen vanaf XXX; per kolom 16 bits hex,
                                     10 ;                                        bit y = rij y van boven (0001 = bovenste dot)
                                     11 ;   aU<a>                                alle dots opnieuw omzetten (tegen vastzittende dots)
                                     12 ;   aD<a>                                diagnose: antwoord "aD" + 28 bytes interne toestand in hex
                                     13 ;                                        (zie diag_tab); geen a0, beëindigt de bitmapmodus niet
                                     14 ; <a> = displayadres als teken ('1'..'?'); '0' = alle displays, dan geen antwoord.
                                     15 ; aB en aP mogen tot 500 tekens lang zijn (ASFP: 250), zodat een volledige bitmap van
                                     16 ; 112 x 16 (455 tekens) in één telegram past.
                                     17 ; Na elk geaccepteerd telegram antwoordt het display "a0"; daarna worden alleen de
                                     18 ; veranderde dots omgezet. Is de wachtrij vol, dan volgt geen antwoord (later opnieuw).
                                     19 ;
                                     20 ; Bitmapmodus: het eerste pixel/bitmap-telegram neemt het getoonde beeld over in een
                                     21 ; schaduwbuffer; daarna tekent alles in die schaduw. Een inhoudelijk ASFP-telegram
                                     22 ; (tekst, lijn, bestemming, testbeeld, ...) beëindigt de bitmapmodus; status- en
                                     23 ; versievragen (a<a>, aV<a>) niet.
                                     24 ;
                                     25 ; Werking in ASFP:
                                     26 ;   0x035F  ontvangstbuffer, index iRAM 2Dh (8 bit, max 0xF9); 0x0553 = ontvangststatus
                                     27 ;   0x057E  gewenst beeld, 2 bytes per kolom (hoog, laag); bit y = rij y van boven
                                     28 ;   0x07AE  getoond beeld (kopie na elke verversing)
                                     29 ;   0x0692  verversroutine; slaat onveranderde dots alleen over als 22h.0 = 1
                                     30 ;   22h.0   "wisseltekst actief": zolang gezet tekent de hoofdlus steeds de volgende pagina
                                     31 ;   0x0571  verzoek aan de hoofdlus (testbeeld aT gebruikt 1..4); 5 = verversen zonder vullen
                                     32 ;
                                     33 ; Opbouw van de patch:
                                     34 ;   - Ontvangst (interrupt): voor aB/aP telt de index door tot 500 (extra byte RX_HI).
                                     35 ;   - Herkenning (interrupt): adres controleren en het ruwe telegram in een wachtrij
                                     36 ;     kopiëren (2 x 512 bytes), "a0" antwoorden. Kort, zodat er geen tekens verloren gaan.
                                     37 ;   - Hoofdlus: zolang de wachtrij niet leeg is wordt 0x0571 = 5. Het omhulsel om de
                                     38 ;     verversing verwerkt dan alle telegrammen in de schaduw, kopieert die naar 0x057E en
                                     39 ;     ververst met een eigen snelle routine (alleen veranderde dots); 22h.0 = 0 (wisseltekst stopt).
                                     40 ;   - Reset: eigen variabelen wissen (het werk-RAM is batterijgebufferd).
                                     41 ;
                                     42 ; Haken in ASFP (origineel -> patch):
                                     43 ;   0x0000  LJMP 0x4EBF            -> LJMP init
                                     44 ;   0x001F  (opvulling 00 00 00)   -> LJMP ext_a
                                     45 ;   0x018B  SJMP 0x0204            -> AJMP 0x001F    (einde a-telegramherkenning)
                                     46 ;   0x0481  MOV 2Dh,#01h           -> LCALL rx_start (begin telegram)
                                     47 ;   0x04A9  MOV A,2Dh / SETB C     -> LJMP rx_store  (teken opslaan)
                                     48 ;   0x2FD9  MOV DPTR,#0571h        -> LJMP main_poll (hoofdlus)
                                     49 ;   0x30E0  LCALL 0x0692           -> LCALL refresh_wrap
                                     50 ; Nieuwe code vanaf 0x5000 (was 0xFF). Werk-RAM 0x0900-0x0F27 (ASFP gebruikt tot 0x08D0).
                                     51 ;
                                     52 ; Interruptcode draait in registerbank 1, hoofdluscode in bank 0. Gebruikt worden alleen
                                     53 ; R0-R7, ACC, B, DPTR en (tijdelijk, met herstel) P2, net als de ASFP-routines.
                                     54 
                                     55         .module asfp_bitmap
                                     56 
                                     57 ; 1 = eigen snelle verversing (alleen veranderde kolommen), 0 = originele routine 0x0692.
                                     58 ; Op hardware klapten met fast_refresh geen dots om (17-11-2026); daarom voorlopig 0.
                           000001    59 USE_FAST_REFRESH = 1
                                     60 
                                     61 ; Kolomverschuiving voor aP en aB: byte op XOFF_ADDR (standaard 28). Op een display waarvan de
                                     62 ; eerste module (kolom 0-27) ontbreekt, valt x = 0 dan op de eerste zichtbare kolom.
                                     63 ; Zet het byte op 0 voor een volledig display (build.py --xoff, of met een hex-editor).
                           005FFF    64 XOFF_ADDR  = 0x5FFF
                                     65         .area   PATCH (ABS,CODE)
                                     66 
                                     67 ; ---------- ASFP ----------
                           00035F    68 BUF        = 0x035F        ; ontvangstbuffer, afgesloten met CR
                           00002E    69 RX_CS      = 0x002E        ; lopende checksum
                           000042    70 RAW_CH     = 0x42          ; iRAM: ontvangen byte incl. pariteit
                           000043    71 CH7        = 0x43          ; iRAM: ontvangen teken (7 bit)
                           00002D    72 RX_IDX     = 0x2D          ; iRAM: ontvangstindex (laag)
                           00055B    73 ADDR       = 0x055B        ; displayadres (binair)
                           00055C    74 WIDTH      = 0x055C        ; breedte in kolommen
                           00055D    75 HEIGHT     = 0x055D        ; hoogte in rijen
                           00057E    76 FB_NEW     = 0x057E        ; gewenst beeld
                           0007AE    77 FB_OLD     = 0x07AE        ; getoond beeld
                           000571    78 REQ        = 0x0571        ; verzoek aan hoofdlus
                           000005    79 REQ_REFRESH = 5
                           00031E    80 TXBUF      = 0x031E
                           00002F    81 TXLEN      = 0x002F
                           000555    82 TXIDX      = 0x0555
                           000038    83 TYPE       = 0x38          ; iRAM: telegramtype in de verdeler (0 = onbekend)
                           000007    84 T_STATUS   = 7
                           000008    85 T_VERSION  = 8
                           00003A    86 LEN_CS     = 0x3A          ; iRAM: lengte voor de checksumroutine
                           000204    87 DISPATCH_TAIL = 0x0204
                           0000B2    88 REPLY_CS   = 0x00B2
                           000692    89 REFRESH    = 0x0692
                           004EBF    90 RESET_ORIG = 0x4EBF
                           0004B0    91 RX_STORE_ORIG = 0x04B0     ; origineel: opslaan, aA-kopie, INC 2Dh
                           0004FB    92 RX_AFTER   = 0x04FB        ; origineel: CR-controle
                           002FDC    93 POLL_CONT  = 0x2FDC        ; origineel: MOVX A,@DPTR (DPTR = 0x0571)
                           000004    94 B_TXBUSY   = 0x04          ; 20h.4
                           000099    95 B_TI       = 0x99          ; SCON.1
                           000010    96 B_PARTIAL  = 0x10          ; 22h.0
                           0000A0    97 P2         = 0xA0
                                     98 
                                     99 ; ---------- eigen werk-RAM ----------
                           000009   100 QBASE      = 0x09          ; wachtrij: slot i op (QBASE + 2*i) * 256, 512 bytes per slot
                           000E00   101 BM_FLAG    = 0x0E00        ; 1 = bitmapmodus (schaduw geldig)
                           000E01   102 FULL_REQ   = 0x0E01        ; 1 = volgende verversing alles omzetten
                           000E02   103 Q_HEAD     = 0x0E02        ; aantal gevulde slots (modulo 4), alleen de interrupt schrijft
                           000E03   104 Q_TAIL     = 0x0E03        ; aantal verwerkte slots (modulo 4), alleen de hoofdlus schrijft
                           000E04   105 RX_HI      = 0x0E04        ; ontvangstindex (hoog) voor lange telegrammen
                           000E05   106 DIRTY_MIN  = 0x0E05        ; laagste gewijzigde kolom sinds de vorige verversing (0xFF = geen)
                           000E06   107 DIRTY_MAX  = 0x0E06        ; hoogste gewijzigde kolom
                           000E07   108 CNT_POLL5  = 0x0E07        ; tellers (diagnose, modulo 256): hoofdlus zette REQ = 5
                           000E08   109 CNT_ITEMS  = 0x0E08        ;   verwerkte telegrammen uit de wachtrij
                           000E09   110 CNT_FR     = 0x0E09        ;   aanroepen van fast_refresh
                           000E0A   111 CNT_DOT_H  = 0x0E0A        ;   aangevraagde dotpulsen (16 bit)
                           000E0B   112 CNT_DOT_L  = 0x0E0B
                           000E0C   113 VARS_END   = 0x0E0C
                           000E10   114 SH         = 0x0E10        ; schaduwbuffer, max 140 kolommen x 2 bytes
                           0001F4   115 RX_MAX     = 0x01F4        ; max. lengte aB/aP incl. CR (buffer tot vlak voor 0x0553)
                                    116 
                           00000D   117 CR         = 0x0D
                                    118 
                                    119 ; ---------- haken ----------
      000000                        120         .org    0x0000
      000000 02r50r00         [24]  121         ljmp    init
                                    122 
      00001F                        123         .org    0x001F
      00001F 02r50r6A         [24]  124         ljmp    ext_a
                                    125 
      00018B                        126         .org    0x018B
      00018B 00 1F            [12]  127         ajmp    0x001F
                                    128 
      000481                        129         .org    0x0481
      000481 12r50r11         [24]  130         lcall   rx_start
                                    131 
      0004A9                        132         .org    0x04A9
      0004A9 02r50r1A         [24]  133         ljmp    rx_store
                                    134 
      002FD9                        135         .org    0x2FD9
      002FD9 02r51r0E         [24]  136         ljmp    main_poll
                                    137 
      0030E0                        138         .org    0x30E0
      0030E0 12r51r31         [24]  139         lcall   refresh_wrap
                                    140 
      005000                        141         .org    0x5000
                                    142 
                                    143 ; ---------- reset ----------
      005000                        144 init:
      005000 E4               [12]  145         clr     a
      005001 90 0E 00         [24]  146         mov     dptr,#BM_FLAG           ; 0x0E00 .. VARS_END-1 wissen
      005004 F0               [24]  147 in_clr: movx    @dptr,a
      005005 A3               [24]  148         inc     dptr
      005006 AF 82            [24]  149         mov     r7,dpl
      005008 BF 0C F9         [24]  150         cjne    r7,#<VARS_END,in_clr
      00500B 12r53rA0         [24]  151         lcall   dirty_clear
      00500E 02 4E BF         [24]  152         ljmp    RESET_ORIG
                                    153 
                                    154 ; ---------- ontvangst (seriële interrupt) ----------
                                    155 ; begin van een telegram (vervangt MOV 2Dh,#01h; daarna laadt ASFP A en DPTR opnieuw)
      005011                        156 rx_start:
      005011 75 2D 01         [24]  157         mov     RX_IDX,#1
      005014 90 0E 04         [24]  158         mov     dptr,#RX_HI
      005017 E4               [12]  159         clr     a
      005018 F0               [24]  160         movx    @dptr,a
      005019 22               [24]  161         ret
                                    162 
                                    163 ; teken opslaan (vervangt MOV A,2Dh / SETB C op 0x04A9)
      00501A                        164 rx_store:
      00501A 90 0E 04         [24]  165         mov     dptr,#RX_HI
      00501D E0               [24]  166         movx    a,@dptr
      00501E FF               [12]  167         mov     r7,a                    ; index hoog
      00501F 70 0A            [24]  168         jnz     rs_long
      005021 E5 2D            [12]  169         mov     a,RX_IDX
      005023 D3               [12]  170         setb    c
      005024 94 F9            [12]  171         subb    a,#0xF9
      005026 50 03            [24]  172         jnc     rs_long                 ; index >= 0xFA: voorbij de ASFP-grens
      005028 02 04 B0         [24]  173         ljmp    RX_STORE_ORIG           ; normaal: originele code
      00502B                        174 rs_long:
      00502B 90 03 5F         [24]  175         mov     dptr,#BUF               ; alleen aB en aP mogen langer zijn
      00502E E0               [24]  176         movx    a,@dptr
      00502F B4 61 35         [24]  177         cjne    a,#0x61,rs_skip
      005032 A3               [24]  178         inc     dptr
      005033 E0               [24]  179         movx    a,@dptr
      005034 B4 42 02         [24]  180         cjne    a,#0x42,rs_p
      005037 80 03            [24]  181         sjmp    rs_ok
      005039 B4 50 2B         [24]  182 rs_p:   cjne    a,#0x50,rs_skip
      00503C                        183 rs_ok:
      00503C E5 2D            [12]  184         mov     a,RX_IDX                ; index < RX_MAX ?
      00503E C3               [12]  185         clr     c
      00503F 94 F4            [12]  186         subb    a,#<RX_MAX
      005041 EF               [12]  187         mov     a,r7
      005042 94 01            [12]  188         subb    a,#>RX_MAX
      005044 50 21            [24]  189         jnc     rs_skip
      005046 90 00 2E         [24]  190         mov     dptr,#RX_CS             ; checksum bijwerken
      005049 E0               [24]  191         movx    a,@dptr
      00504A 65 42            [12]  192         xrl     a,RAW_CH
      00504C F0               [24]  193         movx    @dptr,a
      00504D E5 2D            [12]  194         mov     a,RX_IDX                ; BUF[index] = teken
      00504F 24 5F            [12]  195         add     a,#<BUF
      005051 F5 82            [12]  196         mov     dpl,a
      005053 EF               [12]  197         mov     a,r7
      005054 34 03            [12]  198         addc    a,#>BUF
      005056 F5 83            [12]  199         mov     dph,a
      005058 E5 43            [12]  200         mov     a,CH7
      00505A F0               [24]  201         movx    @dptr,a
      00505B 05 2D            [12]  202         inc     RX_IDX                  ; index++ (16 bit)
      00505D E5 2D            [12]  203         mov     a,RX_IDX
      00505F 70 06            [24]  204         jnz     rs_skip
      005061 0F               [12]  205         inc     r7
      005062 90 0E 04         [24]  206         mov     dptr,#RX_HI
      005065 EF               [12]  207         mov     a,r7
      005066 F0               [24]  208         movx    @dptr,a
      005067                        209 rs_skip:
      005067 02 04 FB         [24]  210         ljmp    RX_AFTER                ; CR-controle zoals origineel
                                    211 
                                    212 ; ---------- telegramherkenning (seriële interrupt) ----------
      00506A                        213 ext_a:
      00506A E5 38            [12]  214         mov     a,TYPE
      00506C 60 11            [24]  215         jz      ext_ours
      00506E B4 07 02         [24]  216         cjne    a,#T_STATUS,ext_k1      ; ASFP-telegram: inhoud beëindigt bitmapmodus,
      005071 80 57            [24]  217         sjmp    ext_exit                ; status- en versievragen niet
      005073 B4 08 02         [24]  218 ext_k1: cjne    a,#T_VERSION,ext_k2
      005076 80 52            [24]  219         sjmp    ext_exit
      005078 90 0E 00         [24]  220 ext_k2: mov     dptr,#BM_FLAG
      00507B E4               [12]  221         clr     a
      00507C F0               [24]  222         movx    @dptr,a
      00507D 80 4B            [24]  223         sjmp    ext_exit
      00507F                        224 ext_ours:
      00507F 90 03 5F         [24]  225         mov     dptr,#BUF
      005082 E0               [24]  226         movx    a,@dptr
      005083 B4 61 44         [24]  227         cjne    a,#0x61,ext_exit        ; 'a'
      005086 A3               [24]  228         inc     dptr
      005087 E0               [24]  229         movx    a,@dptr
      005088 B4 50 02         [24]  230         cjne    a,#0x50,ext_c1          ; 'P'
      00508B 80 1E            [24]  231         sjmp    ext_addr
      00508D B4 42 02         [24]  232 ext_c1: cjne    a,#0x42,ext_c2          ; 'B'
      005090 80 19            [24]  233         sjmp    ext_addr
      005092 B4 55 02         [24]  234 ext_c2: cjne    a,#0x55,ext_c3          ; 'U'
      005095 80 14            [24]  235         sjmp    ext_addr
      005097 B4 44 30         [24]  236 ext_c3: cjne    a,#0x44,ext_exit        ; 'D': diagnose, alleen op het eigen adres
      00509A A3               [24]  237         inc     dptr
      00509B E0               [24]  238         movx    a,@dptr
      00509C FE               [12]  239         mov     r6,a
      00509D 90 05 5B         [24]  240         mov     dptr,#ADDR
      0050A0 E0               [24]  241         movx    a,@dptr
      0050A1 24 30            [12]  242         add     a,#0x30
      0050A3 6E               [12]  243         xrl     a,r6
      0050A4 70 24            [24]  244         jnz     ext_exit
      0050A6 12r54r69         [24]  245         lcall   reply_diag
      0050A9 80 1F            [24]  246         sjmp    ext_exit
      0050AB                        247 ext_addr:
      0050AB A3               [24]  248         inc     dptr
      0050AC E0               [24]  249         movx    a,@dptr
      0050AD FE               [12]  250         mov     r6,a                    ; adresteken
      0050AE 7D 00            [12]  251         mov     r5,#0                   ; 1 = rondzending, geen antwoord
      0050B0 90 05 5B         [24]  252         mov     dptr,#ADDR
      0050B3 E0               [24]  253         movx    a,@dptr
      0050B4 24 30            [12]  254         add     a,#0x30
      0050B6 6E               [12]  255         xrl     a,r6
      0050B7 60 06            [24]  256         jz      ext_go
      0050B9 EE               [12]  257         mov     a,r6
      0050BA B4 30 0D         [24]  258         cjne    a,#0x30,ext_exit
      0050BD 7D 01            [12]  259         mov     r5,#1
      0050BF                        260 ext_go:
      0050BF 12r50rCD         [24]  261         lcall   enqueue
      0050C2 40 06            [24]  262         jc      ext_exit                ; wachtrij vol: geen antwoord
      0050C4 ED               [12]  263         mov     a,r5
      0050C5 70 03            [24]  264         jnz     ext_exit
      0050C7 12r54r41         [24]  265         lcall   reply_ok
      0050CA                        266 ext_exit:
      0050CA 02 02 04         [24]  267         ljmp    DISPATCH_TAIL
                                    268 
                                    269 ; ruw telegram (tot en met CR) naar slot Q_HEAD; C = 1 als de wachtrij vol is
                                    270 ; head en tail tellen modulo 4 (slot = teller AND 1); aantal = (head - tail) AND 3.
                                    271 ; Alleen de interrupt schrijft head, alleen de hoofdlus schrijft tail: geen vergrendeling nodig.
      0050CD                        272 enqueue:
      0050CD 90 0E 03         [24]  273         mov     dptr,#Q_TAIL
      0050D0 E0               [24]  274         movx    a,@dptr
      0050D1 FB               [12]  275         mov     r3,a                    ; tail
      0050D2 90 0E 02         [24]  276         mov     dptr,#Q_HEAD
      0050D5 E0               [24]  277         movx    a,@dptr
      0050D6 54 03            [12]  278         anl     a,#3
      0050D8 FA               [12]  279         mov     r2,a                    ; head
      0050D9 C3               [12]  280         clr     c
      0050DA 9B               [12]  281         subb    a,r3
      0050DB 54 03            [12]  282         anl     a,#3
      0050DD B4 02 00         [24]  283         cjne    a,#2,eq_room            ; C = 1 als aantal < 2
      0050E0                        284 eq_room:
      0050E0 50 2A            [24]  285         jnc     eq_full
      0050E2 EA               [12]  286         mov     a,r2
      0050E3 04               [12]  287         inc     a
      0050E4 54 03            [12]  288         anl     a,#3
      0050E6 FB               [12]  289         mov     r3,a                    ; nieuwe head
      0050E7 C0 A0            [24]  290         push    P2
      0050E9 EA               [12]  291         mov     a,r2
      0050EA 54 01            [12]  292         anl     a,#1                    ; slot
      0050EC 25 E0            [12]  293         add     a,acc
      0050EE 24 09            [12]  294         add     a,#QBASE
      0050F0 F5 A0            [12]  295         mov     P2,a                    ; doel via MOVX @R1 (P2 = hoge byte)
      0050F2 79 00            [12]  296         mov     r1,#0
      0050F4 90 03 5F         [24]  297         mov     dptr,#BUF
      0050F7                        298 eq_loop:
      0050F7 E0               [24]  299         movx    a,@dptr
      0050F8 F3               [24]  300         movx    @r1,a
      0050F9 A3               [24]  301         inc     dptr
      0050FA 09               [12]  302         inc     r1
      0050FB B9 00 02         [24]  303         cjne    r1,#0,eq_cr
      0050FE 05 A0            [12]  304         inc     P2
      005100 B4 0D F4         [24]  305 eq_cr:  cjne    a,#CR,eq_loop
      005103 D0 A0            [24]  306         pop     P2
      005105 90 0E 02         [24]  307         mov     dptr,#Q_HEAD
      005108 EB               [12]  308         mov     a,r3
      005109 F0               [24]  309         movx    @dptr,a
      00510A C3               [12]  310         clr     c
      00510B 22               [24]  311         ret
      00510C                        312 eq_full:
      00510C D3               [12]  313         setb    c
      00510D 22               [24]  314         ret
                                    315 
                                    316 ; ---------- hoofdlus ----------
                                    317 ; vervangt MOV DPTR,#0571h op 0x2FD9: wachtrij niet leeg en geen ander verzoek -> REQ = 5
      00510E                        318 main_poll:
      00510E 90 0E 03         [24]  319         mov     dptr,#Q_TAIL
      005111 E0               [24]  320         movx    a,@dptr
      005112 F5 F0            [12]  321         mov     b,a
      005114 90 0E 02         [24]  322         mov     dptr,#Q_HEAD
      005117 E0               [24]  323         movx    a,@dptr
      005118 65 F0            [12]  324         xrl     a,b
      00511A 60 0F            [24]  325         jz      mp_done
      00511C 90 05 71         [24]  326         mov     dptr,#REQ
      00511F E0               [24]  327         movx    a,@dptr
      005120 70 09            [24]  328         jnz     mp_done                 ; testbeeld eerst afhandelen
      005122 74 05            [12]  329         mov     a,#REQ_REFRESH
      005124 F0               [24]  330         movx    @dptr,a
      005125 90 0E 07         [24]  331         mov     dptr,#CNT_POLL5
      005128 12r54r65         [24]  332         lcall   inc_x
      00512B                        333 mp_done:
      00512B 90 05 71         [24]  334         mov     dptr,#REQ
      00512E 02 2F DC         [24]  335         ljmp    POLL_CONT
                                    336 
                                    337 ; omhulsel om de verversing (0x30E0)
      005131                        338 refresh_wrap:
      005131 90 05 71         [24]  339         mov     dptr,#REQ
      005134 E0               [24]  340         movx    a,@dptr
      005135 B4 05 17         [24]  341         cjne    a,#REQ_REFRESH,rw_plain
      005138 12r52r17         [24]  342         lcall   q_process
      00513B 90 0E 00         [24]  343         mov     dptr,#BM_FLAG
      00513E E0               [24]  344         movx    a,@dptr
      00513F 60 03            [24]  345         jz      rw_go                   ; bitmapmodus intussen beëindigd
      005141 12r53r4F         [24]  346         lcall   sh_to_fb
      005144                        347 rw_go:
      005144 90 0E 09         [24]  348         mov     dptr,#CNT_FR
      005147 12r54r65         [24]  349         lcall   inc_x
                           000001   350 .if USE_FAST_REFRESH
      00514A C2 10            [12]  351         clr     B_PARTIAL               ; wisseltekst stoppen
      00514C 02r51r52         [24]  352         ljmp    fast_refresh            ; alleen veranderde dots, zonder paginawachttijd
                           000000   353 .else
                                    354         ; originele verversroutine: met 22h.0 = 1 slaat 0x0692 onveranderde dots over; de
                                    355         ; paginatimer (32h/33h) op 0, anders wacht 0x0692 eerst de wisseltekst-paginatijd af.
                                    356         ; Daarna 22h.0 = 0, zodat de hoofdlus geen volgende tekstpagina over het beeld tekent.
                                    357         mov     0x32,#0
                                    358         mov     0x33,#0
                                    359         setb    B_PARTIAL
                                    360         lcall   REFRESH
                                    361         clr     B_PARTIAL
                                    362         ljmp    dirty_clear
                                    363 .endif
      00514F                        364 rw_plain:
      00514F 02 06 92         [24]  365         ljmp    REFRESH                 ; testbeeld: origineel gedrag
                                    366 
                                    367 ; ---------- snelle verversing (hoofdlus) ----------
                                    368 ; Vervangt 0x0692 voor de bitmapmodus. 0x0692 rekent voor elk van de (tot) 1792 dots
                                    369 ; apart het verschil uit (645 ms bij 6 MHz, ook als er niets verandert) en wacht bij
                                    370 ; wisseltekst eerst de paginatijd af. Deze routine vergelijkt per kolom de 16-bit woorden
                                    371 ; en vraagt alleen voor veranderde dots een puls aan, op dezelfde manier als 0x0692:
                                    372 ; 056B = rij, 056C = kolom, 21h.6 = kleur (XOR 21h.7 'omgekeerd'), 21h.4 = puls gevraagd;
                                    373 ; de timer-interrupt geeft de puls en wist 21h.4. Rijmaskers uit de ASFP-tabel (10h:11h);
                                    374 ; fr_setup laadt die pointer en 21h.7 zelf, zoals 0x0692 op 0x0732-0x0766 doet (10h:11h is
                                    375 ; elders in ASFP ook kladgeheugen).
                           000010   376 ROWMASK_H  = 0x10          ; iRAM: pointer naar rijmasker-tabel (code), hoog
                           000011   377 ROWMASK_L  = 0x11          ;                                        laag
                           00056B   378 DOT_ROW    = 0x056B
                           00056C   379 DOT_COL    = 0x056C
                           00000C   380 B_DOTREQ   = 0x0C          ; 21h.4
                           00000E   381 B_COLOR    = 0x0E          ; 21h.6
                           00000F   382 B_INVERSE  = 0x0F          ; 21h.7
                           000087   383 PCON       = 0x87
                           000554   384 DISP_BUSY  = 0x0554        ; 0x0692 zet deze op 0 na afloop
                                    385 
      005152                        386 fast_refresh:
      005152 12r51rEF         [24]  387         lcall   fr_setup                ; rijmasker-pointer en 'omgekeerd' zoals 0x0692
      005155 12r53rAA         [24]  388         lcall   dirty_start             ; alleen gewijzigde kolommen
      005158                        389 fr_col:
      005158 12r53rC5         [24]  390         lcall   in_range
      00515B 40 03            [24]  391         jc      fr_col_go
      00515D 02r51rE7         [24]  392         ljmp    fr_done
      005160                        393 fr_col_go:
      005160 7E 05            [12]  394         mov     r6,#>FB_NEW
      005162 7F 7E            [12]  395         mov     r7,#<FB_NEW
      005164 12r53rDB         [24]  396         lcall   colptr
      005167 E0               [24]  397         movx    a,@dptr
      005168 FB               [12]  398         mov     r3,a                    ; nieuw hoog
      005169 A3               [24]  399         inc     dptr
      00516A E0               [24]  400         movx    a,@dptr
      00516B FA               [12]  401         mov     r2,a                    ; nieuw laag
      00516C 7E 07            [12]  402         mov     r6,#>FB_OLD
      00516E 7F AE            [12]  403         mov     r7,#<FB_OLD
      005170 12r53rDB         [24]  404         lcall   colptr
      005173 E0               [24]  405         movx    a,@dptr
      005174 6B               [12]  406         xrl     a,r3
      005175 F5 F0            [12]  407         mov     b,a                     ; verschil hoog
      005177 A3               [24]  408         inc     dptr
      005178 E0               [24]  409         movx    a,@dptr
      005179 6A               [12]  410         xrl     a,r2
      00517A FD               [12]  411         mov     r5,a                    ; verschil laag
      00517B 45 F0            [12]  412         orl     a,b
      00517D 60 64            [24]  413         jz      fr_next                 ; kolom ongewijzigd
      00517F 7F 00            [12]  414         mov     r7,#0                   ; rij-index
      005181                        415 fr_row:
      005181 90 05 5D         [24]  416         mov     dptr,#HEIGHT
      005184 E0               [24]  417         movx    a,@dptr
      005185 F9               [12]  418         mov     r1,a
      005186 EF               [12]  419         mov     a,r7
      005187 C3               [12]  420         clr     c
      005188 99               [12]  421         subb    a,r1
      005189 50 4C            [24]  422         jnc     fr_store
      00518B EF               [12]  423         mov     a,r7                    ; dptr = rijmasker-tabel + 2*rij
      00518C 2F               [12]  424         add     a,r7
      00518D 25 11            [12]  425         add     a,ROWMASK_L
      00518F F5 82            [12]  426         mov     dpl,a
      005191 E4               [12]  427         clr     a
      005192 35 10            [12]  428         addc    a,ROWMASK_H
      005194 F5 83            [12]  429         mov     dph,a
      005196 E4               [12]  430         clr     a
      005197 93               [24]  431         movc    a,@a+dptr
      005198 FE               [12]  432         mov     r6,a                    ; masker hoog
      005199 74 01            [12]  433         mov     a,#1
      00519B 93               [24]  434         movc    a,@a+dptr
      00519C F9               [12]  435         mov     r1,a                    ; masker laag
      00519D EE               [12]  436         mov     a,r6
      00519E 55 F0            [12]  437         anl     a,b
      0051A0 70 04            [24]  438         jnz     fr_flip
      0051A2 E9               [12]  439         mov     a,r1
      0051A3 5D               [12]  440         anl     a,r5
      0051A4 60 2E            [24]  441         jz      fr_rnext
      0051A6                        442 fr_flip:
      0051A6 EE               [12]  443         mov     a,r6                    ; kleur = (nieuw AND masker) <> 0
      0051A7 5B               [12]  444         anl     a,r3
      0051A8 F8               [12]  445         mov     r0,a
      0051A9 E9               [12]  446         mov     a,r1
      0051AA 5A               [12]  447         anl     a,r2
      0051AB 48               [12]  448         orl     a,r0
      0051AC 24 FF            [12]  449         add     a,#0xFF                 ; C = 1 als a <> 0
      0051AE 30 0F 01         [24]  450         jnb     B_INVERSE,fr_col_ok
      0051B1 B3               [12]  451         cpl     c
      0051B2                        452 fr_col_ok:
      0051B2 92 0E            [24]  453         mov     B_COLOR,c
      0051B4 90 05 6B         [24]  454         mov     dptr,#DOT_ROW
      0051B7 EF               [12]  455         mov     a,r7
      0051B8 F0               [24]  456         movx    @dptr,a
      0051B9 A3               [24]  457         inc     dptr                    ; DOT_COL
      0051BA EC               [12]  458         mov     a,r4
      0051BB F0               [24]  459         movx    @dptr,a
      0051BC 90 0E 0B         [24]  460         mov     dptr,#CNT_DOT_L
      0051BF 12r54r65         [24]  461         lcall   inc_x
      0051C2 70 06            [24]  462         jnz     fr_req
      0051C4 90 0E 0A         [24]  463         mov     dptr,#CNT_DOT_H
      0051C7 12r54r65         [24]  464         lcall   inc_x
      0051CA                        465 fr_req:
      0051CA D2 0C            [12]  466         setb    B_DOTREQ
      0051CC                        467 fr_wait:
      0051CC 30 0C 05         [24]  468         jnb     B_DOTREQ,fr_rnext       ; wachten tot de timer-interrupt gepulst heeft
      0051CF 75 87 81         [24]  469         mov     PCON,#0x81              ; idle, SMOD blijft 1 (zoals ASFP)
      0051D2 80 F8            [24]  470         sjmp    fr_wait
      0051D4                        471 fr_rnext:
      0051D4 0F               [12]  472         inc     r7
      0051D5 80 AA            [24]  473         sjmp    fr_row
      0051D7                        474 fr_store:
      0051D7 7E 07            [12]  475         mov     r6,#>FB_OLD             ; getoond := nieuw voor deze kolom
      0051D9 7F AE            [12]  476         mov     r7,#<FB_OLD
      0051DB 12r53rDB         [24]  477         lcall   colptr
      0051DE EB               [12]  478         mov     a,r3
      0051DF F0               [24]  479         movx    @dptr,a
      0051E0 A3               [24]  480         inc     dptr
      0051E1 EA               [12]  481         mov     a,r2
      0051E2 F0               [24]  482         movx    @dptr,a
      0051E3                        483 fr_next:
      0051E3 0C               [12]  484         inc     r4
      0051E4 02r51r58         [24]  485         ljmp    fr_col
      0051E7                        486 fr_done:
      0051E7 90 05 54         [24]  487         mov     dptr,#DISP_BUSY
      0051EA E4               [12]  488         clr     a
      0051EB F0               [24]  489         movx    @dptr,a
      0051EC 02r53rA0         [24]  490         ljmp    dirty_clear
                                    491 
                                    492 ; voorbereiding zoals 0x0692 (0x0732-0x0766): 21h.7 = 'omgekeerd' uit tabel 0x4B33 per adres
                                    493 ; (XOR 20h.0), 10h:11h = rijmasker-pointer uit tabel 0x4B2B per adres (14 bytes per adres)
      0051EF                        494 fr_setup:
      0051EF 90 05 5B         [24]  495         mov     dptr,#ADDR
      0051F2 E0               [24]  496         movx    a,@dptr
      0051F3 7F 0E            [12]  497         mov     r7,#0x0E
      0051F5 90 4B 33         [24]  498         mov     dptr,#0x4B33
      0051F8 12 4E 13         [24]  499         lcall   0x4E13                  ; dptr += a * r7
      0051FB E4               [12]  500         clr     a
      0051FC 93               [24]  501         movc    a,@a+dptr
      0051FD 24 FF            [12]  502         add     a,#0xFF                 ; C = 1 als tabelwaarde <> 0
      0051FF B3               [12]  503         cpl     c                       ; omgekeerd = (waarde == 0)
      005200 30 00 01         [24]  504         jnb     0x00,fs_inv             ; 20h.0 keert om
      005203 B3               [12]  505         cpl     c
      005204 92 0F            [24]  506 fs_inv: mov     B_INVERSE,c
      005206 90 05 5B         [24]  507         mov     dptr,#ADDR
      005209 E0               [24]  508         movx    a,@dptr
      00520A 7F 0E            [12]  509         mov     r7,#0x0E
      00520C 90 4B 2B         [24]  510         mov     dptr,#0x4B2B
      00520F 12 4E 13         [24]  511         lcall   0x4E13
      005212 78 10            [12]  512         mov     r0,#ROWMASK_H
      005214 02 4E B6         [24]  513         ljmp    0x4EB6                  ; 2 bytes uit de tabel naar @r0 (10h, 11h)
                                    514 
                                    515 ; alle wachtende telegrammen verwerken in de schaduw
      005217                        516 q_process:
      005217 90 0E 03         [24]  517         mov     dptr,#Q_TAIL
      00521A E0               [24]  518         movx    a,@dptr
      00521B 54 03            [12]  519         anl     a,#3
      00521D FD               [12]  520         mov     r5,a                    ; tail
      00521E 90 0E 02         [24]  521         mov     dptr,#Q_HEAD
      005221 E0               [24]  522         movx    a,@dptr
      005222 54 03            [12]  523         anl     a,#3
      005224 6D               [12]  524         xrl     a,r5
      005225 60 45            [24]  525         jz      qp_end
      005227 12r53r1B         [24]  526         lcall   bm_enter                ; schaduw = getoond beeld (eerste keer)
      00522A ED               [12]  527         mov     a,r5
      00522B 54 01            [12]  528         anl     a,#1                    ; slot
      00522D 25 E0            [12]  529         add     a,acc
      00522F 24 09            [12]  530         add     a,#QBASE
      005231 F5 83            [12]  531         mov     dph,a
      005233 75 82 01         [24]  532         mov     dpl,#1
      005236 E0               [24]  533         movx    a,@dptr                 ; commando
      005237 F5 F0            [12]  534         mov     b,a
      005239 A3               [24]  535         inc     dptr
      00523A A3               [24]  536         inc     dptr                    ; eerste dataveld
      00523B E5 F0            [12]  537         mov     a,b
      00523D B4 50 05         [24]  538         cjne    a,#0x50,qp_1
      005240 12r52r6D         [24]  539         lcall   do_pixels
      005243 80 17            [24]  540         sjmp    qp_next
      005245 B4 42 05         [24]  541 qp_1:   cjne    a,#0x42,qp_2
      005248 12r52rD1         [24]  542         lcall   do_bitmap
      00524B 80 0F            [24]  543         sjmp    qp_next
      00524D 90 0E 01         [24]  544 qp_2:   mov     dptr,#FULL_REQ          ; 'U': alles, over de hele breedte
      005250 74 01            [12]  545         mov     a,#1
      005252 F0               [24]  546         movx    @dptr,a
      005253 90 0E 05         [24]  547         mov     dptr,#DIRTY_MIN
      005256 E4               [12]  548         clr     a
      005257 F0               [24]  549         movx    @dptr,a
      005258 A3               [24]  550         inc     dptr                    ; DIRTY_MAX
      005259 74 FE            [12]  551         mov     a,#0xFE
      00525B F0               [24]  552         movx    @dptr,a
      00525C                        553 qp_next:
      00525C 90 0E 08         [24]  554         mov     dptr,#CNT_ITEMS
      00525F 12r54r65         [24]  555         lcall   inc_x
      005262 ED               [12]  556         mov     a,r5
      005263 04               [12]  557         inc     a
      005264 54 03            [12]  558         anl     a,#3
      005266 90 0E 03         [24]  559         mov     dptr,#Q_TAIL
      005269 F0               [24]  560         movx    @dptr,a
      00526A 80 AB            [24]  561         sjmp    q_process
      00526C                        562 qp_end:
      00526C 22               [24]  563         ret
                                    564 
                                    565 ; ---------- aP: pixels in de schaduw ----------
      00526D                        566 do_pixels:
      00526D E0               [24]  567         movx    a,@dptr
      00526E B4 0D 01         [24]  568         cjne    a,#CR,px_go
      005271 22               [24]  569         ret
      005272                        570 px_go:
      005272 12r53rF7         [24]  571         lcall   getnum3
      005275 40 59            [24]  572         jc      px_end
      005277 12r55r21         [24]  573         lcall   add_xoff
      00527A FC               [12]  574         mov     r4,a                    ; x (+ verschuiving)
      00527B 12r53rE9         [24]  575         lcall   getdig
      00527E 40 50            [24]  576         jc      px_end
      005280 75 F0 0A         [24]  577         mov     b,#10
      005283 A4               [48]  578         mul     ab
      005284 FB               [12]  579         mov     r3,a
      005285 12r53rE9         [24]  580         lcall   getdig
      005288 40 46            [24]  581         jc      px_end
      00528A 2B               [12]  582         add     a,r3
      00528B FB               [12]  583         mov     r3,a                    ; y
      00528C E0               [24]  584         movx    a,@dptr
      00528D A3               [24]  585         inc     dptr
      00528E 64 30            [12]  586         xrl     a,#0x30                 ; '0' -> 0, '1' -> 1
      005290 FA               [12]  587         mov     r2,a
      005291 C3               [12]  588         clr     c
      005292 94 02            [12]  589         subb    a,#2
      005294 50 3A            [24]  590         jnc     px_end
      005296 C0 82            [24]  591         push    dpl
      005298 C0 83            [24]  592         push    dph
      00529A 12r53rD2         [24]  593         lcall   x_lt_width
      00529D 50 2B            [24]  594         jnc     px_skip                 ; x >= breedte
      00529F 90 05 5D         [24]  595         mov     dptr,#HEIGHT
      0052A2 E0               [24]  596         movx    a,@dptr
      0052A3 F9               [12]  597         mov     r1,a
      0052A4 EB               [12]  598         mov     a,r3
      0052A5 C3               [12]  599         clr     c
      0052A6 99               [12]  600         subb    a,r1
      0052A7 50 21            [24]  601         jnc     px_skip                 ; y >= hoogte
      0052A9 7E 0E            [12]  602         mov     r6,#>SH
      0052AB 7F 10            [12]  603         mov     r7,#<SH
      0052AD 12r53rDB         [24]  604         lcall   colptr                  ; dptr = SH + 2*x (hoge byte)
      0052B0 EB               [12]  605         mov     a,r3
      0052B1 C3               [12]  606         clr     c
      0052B2 94 08            [12]  607         subb    a,#8
      0052B4 50 02            [24]  608         jnc     px_bit                  ; y >= 8: hoge byte, bit y-8
      0052B6 A3               [24]  609         inc     dptr                    ; y < 8: lage byte, bit y
      0052B7 EB               [12]  610         mov     a,r3
      0052B8                        611 px_bit:
      0052B8 F9               [12]  612         mov     r1,a
      0052B9 09               [12]  613         inc     r1
      0052BA 74 80            [12]  614         mov     a,#0x80
      0052BC                        615 px_shift:
      0052BC 23               [12]  616         rl      a
      0052BD D9 FD            [24]  617         djnz    r1,px_shift             ; a = 1 << bit
      0052BF F9               [12]  618         mov     r1,a
      0052C0 E0               [24]  619         movx    a,@dptr
      0052C1 49               [12]  620         orl     a,r1
      0052C2 BA 00 01         [24]  621         cjne    r2,#0,px_store
      0052C5 69               [12]  622         xrl     a,r1                    ; kleur 0: bit wissen
      0052C6                        623 px_store:
      0052C6 F0               [24]  624         movx    @dptr,a
      0052C7 12r53rB0         [24]  625         lcall   mark_dirty
      0052CA                        626 px_skip:
