                                    494 ; voorbereiding zoals 0x0692 (0x0732-0x0766): 21h.7 = 'omgekeerd' uit tabel 0x4B33 per adres
                                    495 ; (XOR 20h.0), 10h:11h = rijmasker-pointer uit tabel 0x4B2B per adres (14 bytes per adres)
      0051FA                        496 fr_setup:
      0051FA 90 05 5B         [24]  497         mov     dptr,#ADDR
      0051FD E0               [24]  498         movx    a,@dptr
      0051FE 7F 0E            [12]  499         mov     r7,#0x0E
      005200 90 4B 33         [24]  500         mov     dptr,#0x4B33
      005203 12 4E 13         [24]  501         lcall   0x4E13                  ; dptr += a * r7
      005206 E4               [12]  502         clr     a
      005207 93               [24]  503         movc    a,@a+dptr
      005208 24 FF            [12]  504         add     a,#0xFF                 ; C = 1 als tabelwaarde <> 0
      00520A B3               [12]  505         cpl     c                       ; omgekeerd = (waarde == 0)
      00520B 30 00 01         [24]  506         jnb     0x00,fs_inv             ; 20h.0 keert om
      00520E B3               [12]  507         cpl     c
      00520F 92 0F            [24]  508 fs_inv: mov     B_INVERSE,c
      005211 90 05 5B         [24]  509         mov     dptr,#ADDR
      005214 E0               [24]  510         movx    a,@dptr
      005215 7F 0E            [12]  511         mov     r7,#0x0E
      005217 90 4B 2B         [24]  512         mov     dptr,#0x4B2B
      00521A 12 4E 13         [24]  513         lcall   0x4E13
      00521D 78 10            [12]  514         mov     r0,#ROWMASK_H
      00521F 02 4E B6         [24]  515         ljmp    0x4EB6                  ; 2 bytes uit de tabel naar @r0 (10h, 11h)
                                    516 
                                    517 ; alle wachtende telegrammen verwerken in de schaduw
      005222                        518 q_process:
      005222 90 0E 03         [24]  519         mov     dptr,#Q_TAIL
      005225 E0               [24]  520         movx    a,@dptr
      005226 54 03            [12]  521         anl     a,#3
      005228 FD               [12]  522         mov     r5,a                    ; tail
      005229 90 0E 02         [24]  523         mov     dptr,#Q_HEAD
      00522C E0               [24]  524         movx    a,@dptr
      00522D 54 03            [12]  525         anl     a,#3
      00522F 6D               [12]  526         xrl     a,r5
      005230 60 45            [24]  527         jz      qp_end
      005232 12r53r26         [24]  528         lcall   bm_enter                ; schaduw = getoond beeld (eerste keer)
      005235 ED               [12]  529         mov     a,r5
      005236 54 01            [12]  530         anl     a,#1                    ; slot
      005238 25 E0            [12]  531         add     a,acc
      00523A 24 09            [12]  532         add     a,#QBASE
      00523C F5 83            [12]  533         mov     dph,a
      00523E 75 82 01         [24]  534         mov     dpl,#1
      005241 E0               [24]  535         movx    a,@dptr                 ; commando
      005242 F5 F0            [12]  536         mov     b,a
      005244 A3               [24]  537         inc     dptr
      005245 A3               [24]  538         inc     dptr                    ; eerste dataveld
      005246 E5 F0            [12]  539         mov     a,b
      005248 B4 50 05         [24]  540         cjne    a,#0x50,qp_1
      00524B 12r52r78         [24]  541         lcall   do_pixels
      00524E 80 17            [24]  542         sjmp    qp_next
