      0054C3 EB               [12]  998         mov     a,r3
      0054C4 12r54rCA         [24]  999         lcall   hexch
      0054C7 02r54rD6         [24] 1000         ljmp    put_ch
                                   1001 
      0054CA 54 0F            [12] 1002 hexch:  anl     a,#0x0F
