      0052CC 49               [12]  622         orl     a,r1
      0052CD BA 00 01         [24]  623         cjne    r2,#0,px_store
      0052D0 69               [12]  624         xrl     a,r1                    ; kleur 0: bit wissen
      0052D1                        625 px_store:
