                                    674 ; ---------- bitmapmodus starten: schaduw := getoond beeld ----------
                                    675 ; blokkopie FB_OLD -> SH (2 * breedte bytes): bron via DPTR, doel via P2:R0 (MOVX @R0)
      005320                        676 bm_enter:
      005320 90 0E 00         [24]  677         mov     dptr,#BM_FLAG
      005323 E0               [24]  678         movx    a,@dptr
      005324 70 2D            [24]  679         jnz     be_done
      005326 74 01            [12]  680         mov     a,#1
      005328 F0               [24]  681         movx    @dptr,a
      005329 90 05 5C         [24]  682         mov     dptr,#WIDTH
      00532C E0               [24]  683         movx    a,@dptr
      00532D 60 24            [24]  684         jz      be_done
      00532F 25 E0            [12]  685         add     a,acc
      005331 FB               [12]  686         mov     r3,a                    ; aantal bytes, laag
      005332 E4               [12]  687         clr     a
      005333 33               [12]  688         rlc     a
      005334 FA               [12]  689         mov     r2,a                    ; aantal bytes, hoog
      005335 C0 A0            [24]  690         push    P2
      005337 75 A0 0E         [24]  691         mov     P2,#>SH
      00533A 78 10            [12]  692         mov     r0,#<SH
      00533C 90 07 AE         [24]  693         mov     dptr,#FB_OLD
      00533F                        694 be_copy:
      00533F E0               [24]  695         movx    a,@dptr
      005340 F2               [24]  696         movx    @r0,a
      005341 A3               [24]  697         inc     dptr
      005342 08               [12]  698         inc     r0
      005343 B8 00 02         [24]  699         cjne    r0,#0,be_cnt
      005346 05 A0            [12]  700         inc     P2
      005348 EB               [12]  701 be_cnt: mov     a,r3                    ; teller (r2:r3) - 1
      005349 70 01            [24]  702         jnz     be_lo
      00534B 1A               [12]  703         dec     r2
      00534C 1B               [12]  704 be_lo:  dec     r3
      00534D EB               [12]  705         mov     a,r3
