                                    628 ; ---------- aP: pixels in de schaduw ----------
      0052E1                        629 do_pixels:
      0052E1 E0               [24]  630         movx    a,@dptr
      0052E2 B4 0D 01         [24]  631         cjne    a,#CR,px_go
