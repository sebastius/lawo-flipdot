                                    369 ; ---------- snelle verversing (hoofdlus) ----------
                                    370 ; Vervangt 0x0692 voor de bitmapmodus. 0x0692 rekent voor elk van de (tot) 1792 dots
                                    371 ; apart het verschil uit (645 ms bij 6 MHz, ook als er niets verandert) en wacht bij
                                    372 ; wisseltekst eerst de paginatijd af. Deze routine vergelijkt per kolom de 16-bit woorden
                                    373 ; en vraagt alleen voor veranderde dots een puls aan, op dezelfde manier als 0x0692:
                                    374 ; 056B = rij, 056C = kolom, 21h.6 = kleur (XOR 21h.7 'omgekeerd'), 21h.4 = puls gevraagd;
                                    375 ; de timer-interrupt geeft de puls en wist 21h.4. Rijmaskers uit de ASFP-tabel (10h:11h);
                                    376 ; fr_setup laadt die pointer en 21h.7 zelf, zoals 0x0692 op 0x0732-0x0766 doet (10h:11h is
                                    377 ; elders in ASFP ook kladgeheugen).
                           000010   378 ROWMASK_H  = 0x10          ; iRAM: pointer naar rijmasker-tabel (code), hoog
                           000011   379 ROWMASK_L  = 0x11          ;                                        laag
                           00056B   380 DOT_ROW    = 0x056B
                           00056C   381 DOT_COL    = 0x056C
                           00000C   382 B_DOTREQ   = 0x0C          ; 21h.4
                           00000E   383 B_COLOR    = 0x0E          ; 21h.6
                           00000F   384 B_INVERSE  = 0x0F          ; 21h.7
                           000087   385 PCON       = 0x87
                           000554   386 DISP_BUSY  = 0x0554        ; 0x0692 zet deze op 0 na afloop
                                    387 
      00515D                        388 fast_refresh:
      00515D 12r51rFA         [24]  389         lcall   fr_setup                ; rijmasker-pointer en 'omgekeerd' zoals 0x0692
      005160 12r53rB5         [24]  390         lcall   dirty_start             ; alleen gewijzigde kolommen
      005163                        391 fr_col:
      005163 12r53rD0         [24]  392         lcall   in_range
      005166 40 03            [24]  393         jc      fr_col_go
      005168 02r51rF2         [24]  394         ljmp    fr_done
      00516B                        395 fr_col_go:
      00516B 7E 05            [12]  396         mov     r6,#>FB_NEW
      00516D 7F 7E            [12]  397         mov     r7,#<FB_NEW
      00516F 12r53rE6         [24]  398         lcall   colptr
      005172 E0               [24]  399         movx    a,@dptr
      005173 FB               [12]  400         mov     r3,a                    ; nieuw hoog
      005174 A3               [24]  401         inc     dptr
      005175 E0               [24]  402         movx    a,@dptr
      005176 FA               [12]  403         mov     r2,a                    ; nieuw laag
      005177 7E 07            [12]  404         mov     r6,#>FB_OLD
      005179 7F AE            [12]  405         mov     r7,#<FB_OLD
      00517B 12r53rE6         [24]  406         lcall   colptr
      00517E E0               [24]  407         movx    a,@dptr
      00517F 6B               [12]  408         xrl     a,r3
      005180 F5 F0            [12]  409         mov     b,a                     ; verschil hoog
      005182 A3               [24]  410         inc     dptr
      005183 E0               [24]  411         movx    a,@dptr
      005184 6A               [12]  412         xrl     a,r2
      005185 FD               [12]  413         mov     r5,a                    ; verschil laag
      005186 45 F0            [12]  414         orl     a,b
      005188 60 64            [24]  415         jz      fr_next                 ; kolom ongewijzigd
      00518A 7F 00            [12]  416         mov     r7,#0                   ; rij-index
      00518C                        417 fr_row:
      00518C 90 05 5D         [24]  418         mov     dptr,#HEIGHT
      00518F E0               [24]  419         movx    a,@dptr
      005190 F9               [12]  420         mov     r1,a
      005191 EF               [12]  421         mov     a,r7
      005192 C3               [12]  422         clr     c
      005193 99               [12]  423         subb    a,r1
      005194 50 4C            [24]  424         jnc     fr_store
      005196 EF               [12]  425         mov     a,r7                    ; dptr = rijmasker-tabel + 2*rij
      005197 2F               [12]  426         add     a,r7
      005198 25 11            [12]  427         add     a,ROWMASK_L
      00519A F5 82            [12]  428         mov     dpl,a
      00519C E4               [12]  429         clr     a
      00519D 35 10            [12]  430         addc    a,ROWMASK_H
      00519F F5 83            [12]  431         mov     dph,a
      0051A1 E4               [12]  432         clr     a
      0051A2 93               [24]  433         movc    a,@a+dptr
      0051A3 FE               [12]  434         mov     r6,a                    ; masker hoog
      0051A4 74 01            [12]  435         mov     a,#1
      0051A6 93               [24]  436         movc    a,@a+dptr
      0051A7 F9               [12]  437         mov     r1,a                    ; masker laag
      0051A8 EE               [12]  438         mov     a,r6
      0051A9 55 F0            [12]  439         anl     a,b
      0051AB 70 04            [24]  440         jnz     fr_flip
      0051AD E9               [12]  441         mov     a,r1
      0051AE 5D               [12]  442         anl     a,r5
      0051AF 60 2E            [24]  443         jz      fr_rnext
      0051B1                        444 fr_flip:
      0051B1 EE               [12]  445         mov     a,r6                    ; kleur = (nieuw AND masker) <> 0
      0051B2 5B               [12]  446         anl     a,r3
      0051B3 F8               [12]  447         mov     r0,a
      0051B4 E9               [12]  448         mov     a,r1
      0051B5 5A               [12]  449         anl     a,r2
      0051B6 48               [12]  450         orl     a,r0
      0051B7 24 FF            [12]  451         add     a,#0xFF                 ; C = 1 als a <> 0
      0051B9 30 0F 01         [24]  452         jnb     B_INVERSE,fr_col_ok
      0051BC B3               [12]  453         cpl     c
      0051BD                        454 fr_col_ok:
      0051BD 92 0E            [24]  455         mov     B_COLOR,c
      0051BF 90 05 6B         [24]  456         mov     dptr,#DOT_ROW
      0051C2 EF               [12]  457         mov     a,r7
      0051C3 F0               [24]  458         movx    @dptr,a
      0051C4 A3               [24]  459         inc     dptr                    ; DOT_COL
      0051C5 EC               [12]  460         mov     a,r4
      0051C6 F0               [24]  461         movx    @dptr,a
      0051C7 90 0E 0B         [24]  462         mov     dptr,#CNT_DOT_L
      0051CA 12r54r70         [24]  463         lcall   inc_x
      0051CD 70 06            [24]  464         jnz     fr_req
      0051CF 90 0E 0A         [24]  465         mov     dptr,#CNT_DOT_H
      0051D2 12r54r70         [24]  466         lcall   inc_x
      0051D5                        467 fr_req:
      0051D5 D2 0C            [12]  468         setb    B_DOTREQ
      0051D7                        469 fr_wait:
      0051D7 30 0C 05         [24]  470         jnb     B_DOTREQ,fr_rnext       ; wachten tot de timer-interrupt gepulst heeft
      0051DA 75 87 81         [24]  471         mov     PCON,#0x81              ; idle, SMOD blijft 1 (zoals ASFP)
      0051DD 80 F8            [24]  472         sjmp    fr_wait
      0051DF                        473 fr_rnext:
      0051DF 0F               [12]  474         inc     r7
      0051E0 80 AA            [24]  475         sjmp    fr_row
      0051E2                        476 fr_store:
      0051E2 7E 07            [12]  477         mov     r6,#>FB_OLD             ; getoond := nieuw voor deze kolom
      0051E4 7F AE            [12]  478         mov     r7,#<FB_OLD
      0051E6 12r53rE6         [24]  479         lcall   colptr
      0051E9 EB               [12]  480         mov     a,r3
      0051EA F0               [24]  481         movx    @dptr,a
      0051EB A3               [24]  482         inc     dptr
      0051EC EA               [12]  483         mov     a,r2
      0051ED F0               [24]  484         movx    @dptr,a
      0051EE                        485 fr_next:
      0051EE 0C               [12]  486         inc     r4
      0051EF 02r51r63         [24]  487         ljmp    fr_col
      0051F2                        488 fr_done:
      0051F2 90 05 54         [24]  489         mov     dptr,#DISP_BUSY
      0051F5 E4               [12]  490         clr     a
      0051F6 F0               [24]  491         movx    @dptr,a
      0051F7 02r53rAB         [24]  492         ljmp    dirty_clear
