                                    771 ; kolom r4 opnemen in het bereik (gebruikt a, dptr, r0)
      0053AA                        772 mark_dirty:
      0053AA 90 0E 05         [24]  773         mov     dptr,#DIRTY_MIN
      0053AD E0               [24]  774         movx    a,@dptr
