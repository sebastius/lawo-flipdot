                                   1105 ; ~3 ms wachten bij 6 MHz (~1,5 ms bij 12 MHz); gebruikt r0, r6
      005597                       1106 delay3:
      005597 78 03            [12] 1107         mov     r0,#3
      005599 7E FA            [12] 1108 dl_o:   mov     r6,#250
      00559B DE FE            [24] 1109 dl_i:   djnz    r6,dl_i                 ; 250 x 2 cycli x 2 us = 1 ms bij 6 MHz
      00559D D8 FA            [24] 1110         djnz    r0,dl_o
      00559F 22               [24] 1111         ret
