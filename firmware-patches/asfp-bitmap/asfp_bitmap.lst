                                    560 ; ---------- aP: pixels in de schaduw ----------
      005278                        561 do_pixels:
      005278 E0               [24]  562         movx    a,@dptr
      005279 B4 0D 01         [24]  563         cjne    a,#CR,px_go
      00527C 22               [24]  564         ret
      00527D                        565 px_go:
      00527D 12r53rFC         [24]  566         lcall   getnum3
      005280 40 56            [24]  567         jc      px_end
      005282 FC               [12]  568         mov     r4,a                    ; x
      005283 12r53rEE         [24]  569         lcall   getdig
      005286 40 50            [24]  570         jc      px_end
      005288 75 F0 0A         [24]  571         mov     b,#10
      00528B A4               [48]  572         mul     ab
      00528C FB               [12]  573         mov     r3,a
      00528D 12r53rEE         [24]  574         lcall   getdig
      005290 40 46            [24]  575         jc      px_end
      005292 2B               [12]  576         add     a,r3
      005293 FB               [12]  577         mov     r3,a                    ; y
      005294 E0               [24]  578         movx    a,@dptr
      005295 A3               [24]  579         inc     dptr
      005296 64 30            [12]  580         xrl     a,#0x30                 ; '0' -> 0, '1' -> 1
      005298 FA               [12]  581         mov     r2,a
      005299 C3               [12]  582         clr     c
      00529A 94 02            [12]  583         subb    a,#2
      00529C 50 3A            [24]  584         jnc     px_end
      00529E C0 82            [24]  585         push    dpl
      0052A0 C0 83            [24]  586         push    dph
      0052A2 12r53rD7         [24]  587         lcall   x_lt_width
      0052A5 50 2B            [24]  588         jnc     px_skip                 ; x >= breedte
      0052A7 90 05 5D         [24]  589         mov     dptr,#HEIGHT
      0052AA E0               [24]  590         movx    a,@dptr
      0052AB F9               [12]  591         mov     r1,a
      0052AC EB               [12]  592         mov     a,r3
      0052AD C3               [12]  593         clr     c
      0052AE 99               [12]  594         subb    a,r1
      0052AF 50 21            [24]  595         jnc     px_skip                 ; y >= hoogte
      0052B1 7E 0E            [12]  596         mov     r6,#>SH
      0052B3 7F 10            [12]  597         mov     r7,#<SH
      0052B5 12r53rE0         [24]  598         lcall   colptr                  ; dptr = SH + 2*x (hoge byte)
      0052B8 EB               [12]  599         mov     a,r3
      0052B9 C3               [12]  600         clr     c
      0052BA 94 08            [12]  601         subb    a,#8
      0052BC 50 02            [24]  602         jnc     px_bit                  ; y >= 8: hoge byte, bit y-8
      0052BE A3               [24]  603         inc     dptr                    ; y < 8: lage byte, bit y
      0052BF EB               [12]  604         mov     a,r3
      0052C0                        605 px_bit:
      0052C0 F9               [12]  606         mov     r1,a
      0052C1 09               [12]  607         inc     r1
      0052C2 74 80            [12]  608         mov     a,#0x80
      0052C4                        609 px_shift:
      0052C4 23               [12]  610         rl      a
      0052C5 D9 FD            [24]  611         djnz    r1,px_shift             ; a = 1 << bit
      0052C7 F9               [12]  612         mov     r1,a
      0052C8 E0               [24]  613         movx    a,@dptr
      0052C9 49               [12]  614         orl     a,r1
      0052CA BA 00 01         [24]  615         cjne    r2,#0,px_store
      0052CD 69               [12]  616         xrl     a,r1                    ; kleur 0: bit wissen
      0052CE                        617 px_store:
      0052CE F0               [24]  618         movx    @dptr,a
      0052CF 12r53rB5         [24]  619         lcall   mark_dirty
      0052D2                        620 px_skip:
      0052D2 D0 83            [24]  621         pop     dph
      0052D4 D0 82            [24]  622         pop     dpl
      0052D6 80 A0            [24]  623         sjmp    do_pixels
      0052D8                        624 px_end:
      0052D8 22               [24]  625         ret
