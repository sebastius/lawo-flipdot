                                   1086 ; volgorde van de 29 bytes in het aD-antwoord (zie README)
      00555B                       1087 diag_tab:
      00555B 0E 02 0E 03           1088         .db     >Q_HEAD, <Q_HEAD,       >Q_TAIL, <Q_TAIL
      00555F 0E 00 0E 01           1089         .db     >BM_FLAG, <BM_FLAG,     >FULL_REQ, <FULL_REQ
      005563 0E 05 0E 06           1090         .db     >DIRTY_MIN, <DIRTY_MIN, >DIRTY_MAX, <DIRTY_MAX
      005567 05 71 05 54           1091         .db     >REQ, <REQ,             >DISP_BUSY, <DISP_BUSY
      00556B 0E 07 0E 08           1092         .db     >CNT_POLL5, <CNT_POLL5, >CNT_ITEMS, <CNT_ITEMS
      00556F 0E 09 0E 0A 0E 0B     1093         .db     >CNT_FR, <CNT_FR,       >CNT_DOT_H, <CNT_DOT_H, >CNT_DOT_L, <CNT_DOT_L
      005575 FE 10 FE 11           1094         .db     0xFE, 0x10,  0xFE, 0x11                         ; rijmasker-pointer
      005579 FE 20 FE 21 FE 22     1095         .db     0xFE, 0x20,  0xFE, 0x21,  0xFE, 0x22            ; bitvariabelen
      00557F FD 00                 1096         .db     0xFD, 0x00                                      ; P1
      005581 05 5C 05 5D           1097         .db     >WIDTH, <WIDTH,         >HEIGHT, <HEIGHT
      005585 00 10                 1098         .db     0x00, 0x10                                      ; xdata 0x0010 (timer-isr)
      005587 05 88 05 89           1099         .db     >(FB_NEW+10), <(FB_NEW+10), >(FB_NEW+11), <(FB_NEW+11)   ; kolom 5
      00558B 07 B8 07 B9           1100         .db     >(FB_OLD+10), <(FB_OLD+10), >(FB_OLD+11), <(FB_OLD+11)
      00558F 0E 1A 0E 1B           1101         .db     >(SH+10), <(SH+10),     >(SH+11), <(SH+11)
      005593 0E 0C                 1102         .db     >RF_MODE, <RF_MODE                              ; byte 28: verversingsmodus
      005595 FF FF                 1103         .db     0xFF, 0xFF
