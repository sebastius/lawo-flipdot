                                      1 ; ASFP-bitmap: uitbreiding van ASFP.bin (LAWO AZR 802/24) met pixel-, bitmap- en
                                      2 ; ververs-telegrammen en gedeeltelijke verversing (partial update).
                                      3 ; Getest in de emulator (emulator/). Op hardware (17-11-2026): telegrammen worden aangenomen,
                                      4 ; maar er klapten nog geen dots om; daarom het diagnosetelegram aD.
                                      5 ;
                                      6 ; Nieuwe IBIS-telegrammen (CR + XOR-checksum zoals altijd):
                                      7 ;   aP<a><XXX><YY><C>[<XXX><YY><C>...]   pixels: kolom (3 cijfers), rij (2 cijfers, 0 = boven),
                                      8 ;                                        kleur 0 = zwart / 1 = geel
                                      9 ;   aB<a><XXX><HHHH>[<HHHH>...]          kolommen vanaf XXX; per kolom 16 bits hex,
                                     10 ;                                        bit y = rij y van boven (0001 = bovenste dot)
                                     11 ;   aU<a>                                alle dots opnieuw omzetten (tegen vastzittende dots)
                                     12 ;   aD<a>                                diagnose: antwoord "aD" + 28 bytes interne toestand in hex
                                     13 ;                                        (zie diag_tab); geen a0, beëindigt de bitmapmodus niet
                                     14 ; <a> = displayadres als teken ('1'..'?'); '0' = alle displays, dan geen antwoord.
                                     15 ; aB en aP mogen tot 500 tekens lang zijn (ASFP: 250), zodat een volledige bitmap van
                                     16 ; 112 x 16 (455 tekens) in één telegram past.
                                     17 ; Na elk geaccepteerd telegram antwoordt het display "a0"; daarna worden alleen de
                                     18 ; veranderde dots omgezet. Is de wachtrij vol, dan volgt geen antwoord (later opnieuw).
                                     19 ;
                                     20 ; Bitmapmodus: het eerste pixel/bitmap-telegram neemt het getoonde beeld over in een
                                     21 ; schaduwbuffer; daarna tekent alles in die schaduw. Een inhoudelijk ASFP-telegram
                                     22 ; (tekst, lijn, bestemming, testbeeld, ...) beëindigt de bitmapmodus; status- en
                                     23 ; versievragen (a<a>, aV<a>) niet.
                                     24 ;
                                     25 ; Werking in ASFP:
                                     26 ;   0x035F  ontvangstbuffer, index iRAM 2Dh (8 bit, max 0xF9); 0x0553 = ontvangststatus
                                     27 ;   0x057E  gewenst beeld, 2 bytes per kolom (hoog, laag); bit y = rij y van boven
                                     28 ;   0x07AE  getoond beeld (kopie na elke verversing)
                                     29 ;   0x0692  verversroutine; slaat onveranderde dots alleen over als 22h.0 = 1
                                     30 ;   22h.0   "wisseltekst actief": zolang gezet tekent de hoofdlus steeds de volgende pagina
                                     31 ;   0x0571  verzoek aan de hoofdlus (testbeeld aT gebruikt 1..4); 5 = verversen zonder vullen
                                     32 ;
                                     33 ; Opbouw van de patch:
                                     34 ;   - Ontvangst (interrupt): voor aB/aP telt de index door tot 500 (extra byte RX_HI).
                                     35 ;   - Herkenning (interrupt): adres controleren en het ruwe telegram in een wachtrij
                                     36 ;     kopiëren (2 x 512 bytes), "a0" antwoorden. Kort, zodat er geen tekens verloren gaan.
                                     37 ;   - Hoofdlus: zolang de wachtrij niet leeg is wordt 0x0571 = 5. Het omhulsel om de
                                     38 ;     verversing verwerkt dan alle telegrammen in de schaduw, kopieert die naar 0x057E en
                                     39 ;     ververst met een eigen snelle routine (alleen veranderde dots); 22h.0 = 0 (wisseltekst stopt).
                                     40 ;   - Reset: eigen variabelen wissen (het werk-RAM is batterijgebufferd).
                                     41 ;
                                     42 ; Haken in ASFP (origineel -> patch):
                                     43 ;   0x0000  LJMP 0x4EBF            -> LJMP init
                                     44 ;   0x001F  (opvulling 00 00 00)   -> LJMP ext_a
                                     45 ;   0x018B  SJMP 0x0204            -> AJMP 0x001F    (einde a-telegramherkenning)
                                     46 ;   0x0481  MOV 2Dh,#01h           -> LCALL rx_start (begin telegram)
                                     47 ;   0x04A9  MOV A,2Dh / SETB C     -> LJMP rx_store  (teken opslaan)
                                     48 ;   0x2FD9  MOV DPTR,#0571h        -> LJMP main_poll (hoofdlus)
                                     49 ;   0x30E0  LCALL 0x0692           -> LCALL refresh_wrap
                                     50 ; Nieuwe code vanaf 0x5000 (was 0xFF). Werk-RAM 0x0900-0x0F27 (ASFP gebruikt tot 0x08D0).
                                     51 ;
                                     52 ; Interruptcode draait in registerbank 1, hoofdluscode in bank 0. Gebruikt worden alleen
                                     53 ; R0-R7, ACC, B, DPTR en (tijdelijk, met herstel) P2, net als de ASFP-routines.
                                     54 
                                     55         .module asfp_bitmap
                                     56 
                                     57 ; 1 = eigen snelle verversing (alleen veranderde kolommen), 0 = originele routine 0x0692.
                                     58 ; Op hardware (17-11-2026) klappen met fast_refresh geen dots om, hoewel aD laat zien dat de
                                     59 ; pulsen worden aangevraagd en afgehandeld; in de emulator werkt het wel. Oorzaak onbekend.
                                     60 ; Met 0x0692 werkt het op hardware (getest op kolom >= 28). Daarom 0.
                           000000    61 USE_FAST_REFRESH = 0
                                     62 
                                     63 ; Kolomverschuiving voor aP en aB: byte op XOFF_ADDR (standaard 28). Op een display waarvan de
                                     64 ; eerste module (kolom 0-27) ontbreekt, valt x = 0 dan op de eerste zichtbare kolom.
                                     65 ; Zet het byte op 0 voor een volledig display (build.py --xoff, of met een hex-editor).
                           005FFF    66 XOFF_ADDR  = 0x5FFF
                                     67         .area   PATCH (ABS,CODE)
                                     68 
                                     69 ; ---------- ASFP ----------
                           00035F    70 BUF        = 0x035F        ; ontvangstbuffer, afgesloten met CR
                           00002E    71 RX_CS      = 0x002E        ; lopende checksum
                           000042    72 RAW_CH     = 0x42          ; iRAM: ontvangen byte incl. pariteit
                           000043    73 CH7        = 0x43          ; iRAM: ontvangen teken (7 bit)
                           00002D    74 RX_IDX     = 0x2D          ; iRAM: ontvangstindex (laag)
                           00055B    75 ADDR       = 0x055B        ; displayadres (binair)
                           00055C    76 WIDTH      = 0x055C        ; breedte in kolommen
                           00055D    77 HEIGHT     = 0x055D        ; hoogte in rijen
                           00057E    78 FB_NEW     = 0x057E        ; gewenst beeld
                           0007AE    79 FB_OLD     = 0x07AE        ; getoond beeld
                           000571    80 REQ        = 0x0571        ; verzoek aan hoofdlus
                           000005    81 REQ_REFRESH = 5
                           00031E    82 TXBUF      = 0x031E
                           00002F    83 TXLEN      = 0x002F
                           000555    84 TXIDX      = 0x0555
                           000038    85 TYPE       = 0x38          ; iRAM: telegramtype in de verdeler (0 = onbekend)
                           000007    86 T_STATUS   = 7
                           000008    87 T_VERSION  = 8
                           00003A    88 LEN_CS     = 0x3A          ; iRAM: lengte voor de checksumroutine
                           000204    89 DISPATCH_TAIL = 0x0204
                           0000B2    90 REPLY_CS   = 0x00B2
                           000692    91 REFRESH    = 0x0692
                           004EBF    92 RESET_ORIG = 0x4EBF
                           0004B0    93 RX_STORE_ORIG = 0x04B0     ; origineel: opslaan, aA-kopie, INC 2Dh
                           0004FB    94 RX_AFTER   = 0x04FB        ; origineel: CR-controle
                           002FDC    95 POLL_CONT  = 0x2FDC        ; origineel: MOVX A,@DPTR (DPTR = 0x0571)
                           000004    96 B_TXBUSY   = 0x04          ; 20h.4
                           000099    97 B_TI       = 0x99          ; SCON.1
                           000010    98 B_PARTIAL  = 0x10          ; 22h.0
                           0000A0    99 P2         = 0xA0
                                    100 
                                    101 ; ---------- eigen werk-RAM ----------
                           000009   102 QBASE      = 0x09          ; wachtrij: slot i op (QBASE + 2*i) * 256, 512 bytes per slot
                           000E00   103 BM_FLAG    = 0x0E00        ; 1 = bitmapmodus (schaduw geldig)
                           000E01   104 FULL_REQ   = 0x0E01        ; 1 = volgende verversing alles omzetten
                           000E02   105 Q_HEAD     = 0x0E02        ; aantal gevulde slots (modulo 4), alleen de interrupt schrijft
                           000E03   106 Q_TAIL     = 0x0E03        ; aantal verwerkte slots (modulo 4), alleen de hoofdlus schrijft
                           000E04   107 RX_HI      = 0x0E04        ; ontvangstindex (hoog) voor lange telegrammen
                           000E05   108 DIRTY_MIN  = 0x0E05        ; laagste gewijzigde kolom sinds de vorige verversing (0xFF = geen)
                           000E06   109 DIRTY_MAX  = 0x0E06        ; hoogste gewijzigde kolom
                           000E07   110 CNT_POLL5  = 0x0E07        ; tellers (diagnose, modulo 256): hoofdlus zette REQ = 5
                           000E08   111 CNT_ITEMS  = 0x0E08        ;   verwerkte telegrammen uit de wachtrij
                           000E09   112 CNT_FR     = 0x0E09        ;   aanroepen van fast_refresh
                           000E0A   113 CNT_DOT_H  = 0x0E0A        ;   aangevraagde dotpulsen (16 bit)
                           000E0B   114 CNT_DOT_L  = 0x0E0B
                           000E0C   115 VARS_END   = 0x0E0C
                           000E10   116 SH         = 0x0E10        ; schaduwbuffer, max 140 kolommen x 2 bytes
                           0001F4   117 RX_MAX     = 0x01F4        ; max. lengte aB/aP incl. CR (buffer tot vlak voor 0x0553)
                                    118 
                           00000D   119 CR         = 0x0D
                                    120 
                                    121 ; ---------- haken ----------
      000000                        122         .org    0x0000
      000000 02r50r00         [24]  123         ljmp    init
                                    124 
      00001F                        125         .org    0x001F
      00001F 02r50r6A         [24]  126         ljmp    ext_a
                                    127 
      00018B                        128         .org    0x018B
      00018B 00 1F            [12]  129         ajmp    0x001F
                                    130 
      000481                        131         .org    0x0481
      000481 12r50r11         [24]  132         lcall   rx_start
                                    133 
      0004A9                        134         .org    0x04A9
      0004A9 02r50r1A         [24]  135         ljmp    rx_store
                                    136 
      002FD9                        137         .org    0x2FD9
      002FD9 02r51r0E         [24]  138         ljmp    main_poll
                                    139 
      0030E0                        140         .org    0x30E0
      0030E0 12r51r31         [24]  141         lcall   refresh_wrap
                                    142 
      005000                        143         .org    0x5000
                                    144 
                                    145 ; ---------- reset ----------
      005000                        146 init:
      005000 E4               [12]  147         clr     a
      005001 90 0E 00         [24]  148         mov     dptr,#BM_FLAG           ; 0x0E00 .. VARS_END-1 wissen
      005004 F0               [24]  149 in_clr: movx    @dptr,a
      005005 A3               [24]  150         inc     dptr
      005006 AF 82            [24]  151         mov     r7,dpl
      005008 BF 0C F9         [24]  152         cjne    r7,#<VARS_END,in_clr
      00500B 12r53rAB         [24]  153         lcall   dirty_clear
      00500E 02 4E BF         [24]  154         ljmp    RESET_ORIG
                                    155 
                                    156 ; ---------- ontvangst (seriële interrupt) ----------
                                    157 ; begin van een telegram (vervangt MOV 2Dh,#01h; daarna laadt ASFP A en DPTR opnieuw)
      005011                        158 rx_start:
      005011 75 2D 01         [24]  159         mov     RX_IDX,#1
      005014 90 0E 04         [24]  160         mov     dptr,#RX_HI
      005017 E4               [12]  161         clr     a
      005018 F0               [24]  162         movx    @dptr,a
      005019 22               [24]  163         ret
                                    164 
                                    165 ; teken opslaan (vervangt MOV A,2Dh / SETB C op 0x04A9)
      00501A                        166 rx_store:
      00501A 90 0E 04         [24]  167         mov     dptr,#RX_HI
      00501D E0               [24]  168         movx    a,@dptr
      00501E FF               [12]  169         mov     r7,a                    ; index hoog
      00501F 70 0A            [24]  170         jnz     rs_long
      005021 E5 2D            [12]  171         mov     a,RX_IDX
      005023 D3               [12]  172         setb    c
      005024 94 F9            [12]  173         subb    a,#0xF9
      005026 50 03            [24]  174         jnc     rs_long                 ; index >= 0xFA: voorbij de ASFP-grens
      005028 02 04 B0         [24]  175         ljmp    RX_STORE_ORIG           ; normaal: originele code
      00502B                        176 rs_long:
      00502B 90 03 5F         [24]  177         mov     dptr,#BUF               ; alleen aB en aP mogen langer zijn
      00502E E0               [24]  178         movx    a,@dptr
      00502F B4 61 35         [24]  179         cjne    a,#0x61,rs_skip
      005032 A3               [24]  180         inc     dptr
      005033 E0               [24]  181         movx    a,@dptr
      005034 B4 42 02         [24]  182         cjne    a,#0x42,rs_p
      005037 80 03            [24]  183         sjmp    rs_ok
      005039 B4 50 2B         [24]  184 rs_p:   cjne    a,#0x50,rs_skip
      00503C                        185 rs_ok:
      00503C E5 2D            [12]  186         mov     a,RX_IDX                ; index < RX_MAX ?
      00503E C3               [12]  187         clr     c
      00503F 94 F4            [12]  188         subb    a,#<RX_MAX
      005041 EF               [12]  189         mov     a,r7
      005042 94 01            [12]  190         subb    a,#>RX_MAX
      005044 50 21            [24]  191         jnc     rs_skip
      005046 90 00 2E         [24]  192         mov     dptr,#RX_CS             ; checksum bijwerken
      005049 E0               [24]  193         movx    a,@dptr
      00504A 65 42            [12]  194         xrl     a,RAW_CH
      00504C F0               [24]  195         movx    @dptr,a
      00504D E5 2D            [12]  196         mov     a,RX_IDX                ; BUF[index] = teken
      00504F 24 5F            [12]  197         add     a,#<BUF
      005051 F5 82            [12]  198         mov     dpl,a
      005053 EF               [12]  199         mov     a,r7
      005054 34 03            [12]  200         addc    a,#>BUF
      005056 F5 83            [12]  201         mov     dph,a
      005058 E5 43            [12]  202         mov     a,CH7
      00505A F0               [24]  203         movx    @dptr,a
      00505B 05 2D            [12]  204         inc     RX_IDX                  ; index++ (16 bit)
      00505D E5 2D            [12]  205         mov     a,RX_IDX
      00505F 70 06            [24]  206         jnz     rs_skip
      005061 0F               [12]  207         inc     r7
      005062 90 0E 04         [24]  208         mov     dptr,#RX_HI
      005065 EF               [12]  209         mov     a,r7
      005066 F0               [24]  210         movx    @dptr,a
      005067                        211 rs_skip:
      005067 02 04 FB         [24]  212         ljmp    RX_AFTER                ; CR-controle zoals origineel
                                    213 
                                    214 ; ---------- telegramherkenning (seriële interrupt) ----------
      00506A                        215 ext_a:
      00506A E5 38            [12]  216         mov     a,TYPE
      00506C 60 11            [24]  217         jz      ext_ours
      00506E B4 07 02         [24]  218         cjne    a,#T_STATUS,ext_k1      ; ASFP-telegram: inhoud beëindigt bitmapmodus,
      005071 80 57            [24]  219         sjmp    ext_exit                ; status- en versievragen niet
      005073 B4 08 02         [24]  220 ext_k1: cjne    a,#T_VERSION,ext_k2
      005076 80 52            [24]  221         sjmp    ext_exit
      005078 90 0E 00         [24]  222 ext_k2: mov     dptr,#BM_FLAG
      00507B E4               [12]  223         clr     a
      00507C F0               [24]  224         movx    @dptr,a
      00507D 80 4B            [24]  225         sjmp    ext_exit
      00507F                        226 ext_ours:
      00507F 90 03 5F         [24]  227         mov     dptr,#BUF
      005082 E0               [24]  228         movx    a,@dptr
      005083 B4 61 44         [24]  229         cjne    a,#0x61,ext_exit        ; 'a'
      005086 A3               [24]  230         inc     dptr
      005087 E0               [24]  231         movx    a,@dptr
      005088 B4 50 02         [24]  232         cjne    a,#0x50,ext_c1          ; 'P'
      00508B 80 1E            [24]  233         sjmp    ext_addr
      00508D B4 42 02         [24]  234 ext_c1: cjne    a,#0x42,ext_c2          ; 'B'
      005090 80 19            [24]  235         sjmp    ext_addr
      005092 B4 55 02         [24]  236 ext_c2: cjne    a,#0x55,ext_c3          ; 'U'
      005095 80 14            [24]  237         sjmp    ext_addr
      005097 B4 44 30         [24]  238 ext_c3: cjne    a,#0x44,ext_exit        ; 'D': diagnose, alleen op het eigen adres
      00509A A3               [24]  239         inc     dptr
      00509B E0               [24]  240         movx    a,@dptr
      00509C FE               [12]  241         mov     r6,a
      00509D 90 05 5B         [24]  242         mov     dptr,#ADDR
      0050A0 E0               [24]  243         movx    a,@dptr
      0050A1 24 30            [12]  244         add     a,#0x30
      0050A3 6E               [12]  245         xrl     a,r6
      0050A4 70 24            [24]  246         jnz     ext_exit
      0050A6 12r54r74         [24]  247         lcall   reply_diag
      0050A9 80 1F            [24]  248         sjmp    ext_exit
      0050AB                        249 ext_addr:
      0050AB A3               [24]  250         inc     dptr
      0050AC E0               [24]  251         movx    a,@dptr
      0050AD FE               [12]  252         mov     r6,a                    ; adresteken
      0050AE 7D 00            [12]  253         mov     r5,#0                   ; 1 = rondzending, geen antwoord
      0050B0 90 05 5B         [24]  254         mov     dptr,#ADDR
      0050B3 E0               [24]  255         movx    a,@dptr
      0050B4 24 30            [12]  256         add     a,#0x30
      0050B6 6E               [12]  257         xrl     a,r6
      0050B7 60 06            [24]  258         jz      ext_go
      0050B9 EE               [12]  259         mov     a,r6
      0050BA B4 30 0D         [24]  260         cjne    a,#0x30,ext_exit
      0050BD 7D 01            [12]  261         mov     r5,#1
      0050BF                        262 ext_go:
      0050BF 12r50rCD         [24]  263         lcall   enqueue
      0050C2 40 06            [24]  264         jc      ext_exit                ; wachtrij vol: geen antwoord
      0050C4 ED               [12]  265         mov     a,r5
      0050C5 70 03            [24]  266         jnz     ext_exit
      0050C7 12r54r4C         [24]  267         lcall   reply_ok
      0050CA                        268 ext_exit:
      0050CA 02 02 04         [24]  269         ljmp    DISPATCH_TAIL
                                    270 
                                    271 ; ruw telegram (tot en met CR) naar slot Q_HEAD; C = 1 als de wachtrij vol is
                                    272 ; head en tail tellen modulo 4 (slot = teller AND 1); aantal = (head - tail) AND 3.
                                    273 ; Alleen de interrupt schrijft head, alleen de hoofdlus schrijft tail: geen vergrendeling nodig.
      0050CD                        274 enqueue:
      0050CD 90 0E 03         [24]  275         mov     dptr,#Q_TAIL
      0050D0 E0               [24]  276         movx    a,@dptr
      0050D1 FB               [12]  277         mov     r3,a                    ; tail
      0050D2 90 0E 02         [24]  278         mov     dptr,#Q_HEAD
      0050D5 E0               [24]  279         movx    a,@dptr
      0050D6 54 03            [12]  280         anl     a,#3
      0050D8 FA               [12]  281         mov     r2,a                    ; head
      0050D9 C3               [12]  282         clr     c
      0050DA 9B               [12]  283         subb    a,r3
      0050DB 54 03            [12]  284         anl     a,#3
      0050DD B4 02 00         [24]  285         cjne    a,#2,eq_room            ; C = 1 als aantal < 2
      0050E0                        286 eq_room:
      0050E0 50 2A            [24]  287         jnc     eq_full
      0050E2 EA               [12]  288         mov     a,r2
      0050E3 04               [12]  289         inc     a
      0050E4 54 03            [12]  290         anl     a,#3
      0050E6 FB               [12]  291         mov     r3,a                    ; nieuwe head
      0050E7 C0 A0            [24]  292         push    P2
      0050E9 EA               [12]  293         mov     a,r2
      0050EA 54 01            [12]  294         anl     a,#1                    ; slot
      0050EC 25 E0            [12]  295         add     a,acc
      0050EE 24 09            [12]  296         add     a,#QBASE
      0050F0 F5 A0            [12]  297         mov     P2,a                    ; doel via MOVX @R1 (P2 = hoge byte)
      0050F2 79 00            [12]  298         mov     r1,#0
      0050F4 90 03 5F         [24]  299         mov     dptr,#BUF
      0050F7                        300 eq_loop:
      0050F7 E0               [24]  301         movx    a,@dptr
      0050F8 F3               [24]  302         movx    @r1,a
      0050F9 A3               [24]  303         inc     dptr
      0050FA 09               [12]  304         inc     r1
      0050FB B9 00 02         [24]  305         cjne    r1,#0,eq_cr
      0050FE 05 A0            [12]  306         inc     P2
      005100 B4 0D F4         [24]  307 eq_cr:  cjne    a,#CR,eq_loop
      005103 D0 A0            [24]  308         pop     P2
      005105 90 0E 02         [24]  309         mov     dptr,#Q_HEAD
      005108 EB               [12]  310         mov     a,r3
      005109 F0               [24]  311         movx    @dptr,a
      00510A C3               [12]  312         clr     c
      00510B 22               [24]  313         ret
      00510C                        314 eq_full:
      00510C D3               [12]  315         setb    c
      00510D 22               [24]  316         ret
                                    317 
                                    318 ; ---------- hoofdlus ----------
                                    319 ; vervangt MOV DPTR,#0571h op 0x2FD9: wachtrij niet leeg en geen ander verzoek -> REQ = 5
      00510E                        320 main_poll:
      00510E 90 0E 03         [24]  321         mov     dptr,#Q_TAIL
      005111 E0               [24]  322         movx    a,@dptr
      005112 F5 F0            [12]  323         mov     b,a
      005114 90 0E 02         [24]  324         mov     dptr,#Q_HEAD
      005117 E0               [24]  325         movx    a,@dptr
      005118 65 F0            [12]  326         xrl     a,b
      00511A 60 0F            [24]  327         jz      mp_done
      00511C 90 05 71         [24]  328         mov     dptr,#REQ
      00511F E0               [24]  329         movx    a,@dptr
      005120 70 09            [24]  330         jnz     mp_done                 ; testbeeld eerst afhandelen
      005122 74 05            [12]  331         mov     a,#REQ_REFRESH
      005124 F0               [24]  332         movx    @dptr,a
      005125 90 0E 07         [24]  333         mov     dptr,#CNT_POLL5
      005128 12r54r70         [24]  334         lcall   inc_x
      00512B                        335 mp_done:
      00512B 90 05 71         [24]  336         mov     dptr,#REQ
      00512E 02 2F DC         [24]  337         ljmp    POLL_CONT
                                    338 
                                    339 ; omhulsel om de verversing (0x30E0)
      005131                        340 refresh_wrap:
      005131 90 05 71         [24]  341         mov     dptr,#REQ
      005134 E0               [24]  342         movx    a,@dptr
      005135 B4 05 22         [24]  343         cjne    a,#REQ_REFRESH,rw_plain
      005138 12r52r22         [24]  344         lcall   q_process
      00513B 90 0E 00         [24]  345         mov     dptr,#BM_FLAG
      00513E E0               [24]  346         movx    a,@dptr
      00513F 60 03            [24]  347         jz      rw_go                   ; bitmapmodus intussen beëindigd
      005141 12r53r5A         [24]  348         lcall   sh_to_fb
      005144                        349 rw_go:
      005144 90 0E 09         [24]  350         mov     dptr,#CNT_FR
      005147 12r54r70         [24]  351         lcall   inc_x
                           000000   352 .if USE_FAST_REFRESH
                                    353         clr     B_PARTIAL               ; wisseltekst stoppen
                                    354         ljmp    fast_refresh            ; alleen veranderde dots, zonder paginawachttijd
                           000001   355 .else
                                    356         ; originele verversroutine: met 22h.0 = 1 slaat 0x0692 onveranderde dots over; de
                                    357         ; paginatimer (32h/33h) op 0, anders wacht 0x0692 eerst de wisseltekst-paginatijd af.
                                    358         ; Daarna 22h.0 = 0, zodat de hoofdlus geen volgende tekstpagina over het beeld tekent.
      00514A 75 32 00         [24]  359         mov     0x32,#0
      00514D 75 33 00         [24]  360         mov     0x33,#0
      005150 D2 10            [12]  361         setb    B_PARTIAL
      005152 12 06 92         [24]  362         lcall   REFRESH
      005155 C2 10            [12]  363         clr     B_PARTIAL
      005157 02r53rAB         [24]  364         ljmp    dirty_clear
                                    365 .endif
      00515A                        366 rw_plain:
