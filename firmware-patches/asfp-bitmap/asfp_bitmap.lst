                                    863 ; hexteken op @dptr -> a (0..15), dptr++; C = 1 als ongeldig
      005415                        864 gethex:
      005415 E0               [24]  865         movx    a,@dptr
      005416 A3               [24]  866         inc     dptr
      005417 C3               [12]  867         clr     c
      005418 94 30            [12]  868         subb    a,#0x30
      00541A 40 1D            [24]  869         jc      gh_bad
      00541C B4 0A 00         [24]  870         cjne    a,#10,gh_c1
      00541F 40 16            [24]  871 gh_c1:  jc      gh_ok                   ; '0'..'9'
      005421 C3               [12]  872         clr     c
      005422 94 11            [12]  873         subb    a,#17                   ; 'A' -> 0
      005424 40 13            [24]  874         jc      gh_bad
      005426 B4 06 00         [24]  875         cjne    a,#6,gh_c2
      005429 40 0A            [24]  876 gh_c2:  jc      gh_let                  ; 'A'..'F'
      00542B C3               [12]  877         clr     c
      00542C 94 20            [12]  878         subb    a,#32                   ; 'a' -> 0
      00542E 40 09            [24]  879         jc      gh_bad
      005430 B4 06 00         [24]  880         cjne    a,#6,gh_c3
      005433 50 04            [24]  881 gh_c3:  jnc     gh_bad
      005435 24 0A            [12]  882 gh_let: add     a,#10
      005437 C3               [12]  883 gh_ok:  clr     c
      005438 22               [24]  884         ret
      005439 D3               [12]  885 gh_bad: setb    c
      00543A 22               [24]  886         ret
