                                    409 ; ---------- snelle verversing (hoofdlus) ----------
                                    410 ; Vervangt 0x0692 voor de bitmapmodus. 0x0692 rekent voor elk van de (tot) 1792 dots
                                    411 ; apart het verschil uit (645 ms bij 6 MHz, ook als er niets verandert) en wacht bij
                                    412 ; wisseltekst eerst de paginatijd af. Deze routine vergelijkt per kolom de 16-bit woorden
                                    413 ; en vraagt alleen voor veranderde dots een puls aan, op dezelfde manier als 0x0692:
                                    414 ; 056B = rij, 056C = kolom, 21h.6 = kleur (XOR 21h.7 'omgekeerd'), 21h.4 = puls gevraagd;
                                    415 ; de timer-interrupt geeft de puls en wist 21h.4. Rijmaskers uit de ASFP-tabel (10h:11h);
                                    416 ; fr_setup laadt die pointer en 21h.7 zelf, zoals 0x0692 op 0x0732-0x0766 doet (10h:11h is
                                    417 ; elders in ASFP ook kladgeheugen).
                           000010   418 ROWMASK_H  = 0x10          ; iRAM: pointer naar rijmasker-tabel (code), hoog
                           000011   419 ROWMASK_L  = 0x11          ;                                        laag
                           00056B   420 DOT_ROW    = 0x056B
                           00056C   421 DOT_COL    = 0x056C
                           00000C   422 B_DOTREQ   = 0x0C          ; 21h.4
                           00000E   423 B_COLOR    = 0x0E          ; 21h.6
                           00000F   424 B_INVERSE  = 0x0F          ; 21h.7
                           000087   425 PCON       = 0x87
                           000554   426 DISP_BUSY  = 0x0554        ; 0x0692 zet deze op 0 na afloop
                                    427 
      00519D                        428 fast_refresh:
      00519D 90 0E 0D         [24]  429         mov     dptr,#FR_FLAGS
      0051A0 E0               [24]  430         movx    a,@dptr
      0051A1 30 E3 0B         [24]  431         jnb     acc.3,fr_nopre          ; FRF_PRE: ~300 ms wachten
      0051A4 7F 64            [12]  432         mov     r7,#100
      0051A6 12r55r97         [24]  433 fr_pre: lcall   delay3
      0051A9 DF FB            [24]  434         djnz    r7,fr_pre
      0051AB 90 0E 0D         [24]  435         mov     dptr,#FR_FLAGS
      0051AE E0               [24]  436         movx    a,@dptr
      0051AF                        437 fr_nopre:
      0051AF 20 E0 03         [24]  438         jb      acc.0,fr_nosetup        ; FRF_NOSETUP
      0051B2 12r52r63         [24]  439         lcall   fr_setup                ; rijmasker-pointer en 'omgekeerd' zoals 0x0692
      0051B5                        440 fr_nosetup:
      0051B5 12r54r1E         [24]  441         lcall   dirty_start             ; alleen gewijzigde kolommen
      0051B8                        442 fr_col:
      0051B8 12r54r39         [24]  443         lcall   in_range
      0051BB 40 03            [24]  444         jc      fr_col_go
      0051BD 02r52r51         [24]  445         ljmp    fr_done
      0051C0                        446 fr_col_go:
      0051C0 7E 05            [12]  447         mov     r6,#>FB_NEW
      0051C2 7F 7E            [12]  448         mov     r7,#<FB_NEW
      0051C4 12r54r4F         [24]  449         lcall   colptr
      0051C7 E0               [24]  450         movx    a,@dptr
      0051C8 FB               [12]  451         mov     r3,a                    ; nieuw hoog
      0051C9 A3               [24]  452         inc     dptr
      0051CA E0               [24]  453         movx    a,@dptr
      0051CB FA               [12]  454         mov     r2,a                    ; nieuw laag
      0051CC 7E 07            [12]  455         mov     r6,#>FB_OLD
      0051CE 7F AE            [12]  456         mov     r7,#<FB_OLD
      0051D0 12r54r4F         [24]  457         lcall   colptr
      0051D3 E0               [24]  458         movx    a,@dptr
      0051D4 6B               [12]  459         xrl     a,r3
      0051D5 F5 F0            [12]  460         mov     b,a                     ; verschil hoog
      0051D7 A3               [24]  461         inc     dptr
      0051D8 E0               [24]  462         movx    a,@dptr
      0051D9 6A               [12]  463         xrl     a,r2
      0051DA FD               [12]  464         mov     r5,a                    ; verschil laag
      0051DB 45 F0            [12]  465         orl     a,b
      0051DD 60 6E            [24]  466         jz      fr_next                 ; kolom ongewijzigd
      0051DF 7F 00            [12]  467         mov     r7,#0                   ; rij-index
      0051E1                        468 fr_row:
      0051E1 90 05 5D         [24]  469         mov     dptr,#HEIGHT
      0051E4 E0               [24]  470         movx    a,@dptr
      0051E5 F9               [12]  471         mov     r1,a
      0051E6 EF               [12]  472         mov     a,r7
      0051E7 C3               [12]  473         clr     c
      0051E8 99               [12]  474         subb    a,r1
      0051E9 50 56            [24]  475         jnc     fr_store
      0051EB EF               [12]  476         mov     a,r7                    ; dptr = rijmasker-tabel + 2*rij
      0051EC 2F               [12]  477         add     a,r7
      0051ED 25 11            [12]  478         add     a,ROWMASK_L
      0051EF F5 82            [12]  479         mov     dpl,a
      0051F1 E4               [12]  480         clr     a
      0051F2 35 10            [12]  481         addc    a,ROWMASK_H
      0051F4 F5 83            [12]  482         mov     dph,a
      0051F6 E4               [12]  483         clr     a
      0051F7 93               [24]  484         movc    a,@a+dptr
      0051F8 FE               [12]  485         mov     r6,a                    ; masker hoog
      0051F9 74 01            [12]  486         mov     a,#1
      0051FB 93               [24]  487         movc    a,@a+dptr
      0051FC F9               [12]  488         mov     r1,a                    ; masker laag
      0051FD EE               [12]  489         mov     a,r6
      0051FE 55 F0            [12]  490         anl     a,b
      005200 70 04            [24]  491         jnz     fr_flip
      005202 E9               [12]  492         mov     a,r1
      005203 5D               [12]  493         anl     a,r5
      005204 60 38            [24]  494         jz      fr_rnext
      005206                        495 fr_flip:
      005206 EE               [12]  496         mov     a,r6                    ; kleur = (nieuw AND masker) <> 0
      005207 5B               [12]  497         anl     a,r3
      005208 F8               [12]  498         mov     r0,a
      005209 E9               [12]  499         mov     a,r1
      00520A 5A               [12]  500         anl     a,r2
      00520B 48               [12]  501         orl     a,r0
      00520C 24 FF            [12]  502         add     a,#0xFF                 ; C = 1 als a <> 0
      00520E 30 0F 01         [24]  503         jnb     B_INVERSE,fr_col_ok
      005211 B3               [12]  504         cpl     c
      005212                        505 fr_col_ok:
      005212 92 0E            [24]  506         mov     B_COLOR,c
      005214 90 05 6B         [24]  507         mov     dptr,#DOT_ROW
      005217 EF               [12]  508         mov     a,r7
      005218 F0               [24]  509         movx    @dptr,a
      005219 A3               [24]  510         inc     dptr                    ; DOT_COL
      00521A EC               [12]  511         mov     a,r4
      00521B F0               [24]  512         movx    @dptr,a
      00521C 90 0E 0B         [24]  513         mov     dptr,#CNT_DOT_L
      00521F 12r54rD9         [24]  514         lcall   inc_x
      005222 70 06            [24]  515         jnz     fr_req
      005224 90 0E 0A         [24]  516         mov     dptr,#CNT_DOT_H
      005227 12r54rD9         [24]  517         lcall   inc_x
      00522A                        518 fr_req:
      00522A D2 0C            [12]  519         setb    B_DOTREQ
      00522C                        520 fr_wait:
      00522C 30 0C 05         [24]  521         jnb     B_DOTREQ,fr_pulsed      ; wachten tot de timer-interrupt gepulst heeft
      00522F 75 87 81         [24]  522         mov     PCON,#0x81              ; idle, SMOD blijft 1 (zoals ASFP)
      005232 80 F8            [24]  523         sjmp    fr_wait
      005234                        524 fr_pulsed:
      005234 90 0E 0D         [24]  525         mov     dptr,#FR_FLAGS
      005237 E0               [24]  526         movx    a,@dptr
      005238 30 E2 03         [24]  527         jnb     acc.2,fr_rnext          ; FRF_GAP
      00523B 12r55r97         [24]  528         lcall   delay3                  ; gebruikt r0, r6 (r6 wordt per rij opnieuw geladen)
      00523E                        529 fr_rnext:
      00523E 0F               [12]  530         inc     r7
      00523F 80 A0            [24]  531         sjmp    fr_row
      005241                        532 fr_store:
      005241 7E 07            [12]  533         mov     r6,#>FB_OLD             ; getoond := nieuw voor deze kolom
      005243 7F AE            [12]  534         mov     r7,#<FB_OLD
      005245 12r54r4F         [24]  535         lcall   colptr
      005248 EB               [12]  536         mov     a,r3
      005249 F0               [24]  537         movx    @dptr,a
      00524A A3               [24]  538         inc     dptr
      00524B EA               [12]  539         mov     a,r2
      00524C F0               [24]  540         movx    @dptr,a
      00524D                        541 fr_next:
      00524D 0C               [12]  542         inc     r4
      00524E 02r51rB8         [24]  543         ljmp    fr_col
      005251                        544 fr_done:
      005251 90 0E 0D         [24]  545         mov     dptr,#FR_FLAGS
      005254 E0               [24]  546         movx    a,@dptr
      005255 30 E1 03         [24]  547         jnb     acc.1,fr_done2          ; FRF_ENDWAIT
      005258 12r55r97         [24]  548         lcall   delay3
      00525B                        549 fr_done2:
      00525B 90 05 54         [24]  550         mov     dptr,#DISP_BUSY
      00525E E4               [12]  551         clr     a
      00525F F0               [24]  552         movx    @dptr,a
      005260 02r54r14         [24]  553         ljmp    dirty_clear
