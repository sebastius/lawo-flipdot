      0052B8 12r53rE6         [24]  606         lcall   colptr                  ; dptr = SH + 2*x (hoge byte)
      0052BB EB               [12]  607         mov     a,r3
      0052BC C3               [12]  608         clr     c
      0052BD 94 08            [12]  609         subb    a,#8
      0052BF 50 02            [24]  610         jnc     px_bit                  ; y >= 8: hoge byte, bit y-8
      0052C1 A3               [24]  611         inc     dptr                    ; y < 8: lage byte, bit y
      0052C2 EB               [12]  612         mov     a,r3
