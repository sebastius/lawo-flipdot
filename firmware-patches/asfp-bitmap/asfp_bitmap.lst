                                    398         ; paginatimer (32h/33h) op 0, anders wacht 0x0692 eerst de wisseltekst-paginatijd af.
                                    399         ; Daarna 22h.0 = 0, zodat de hoofdlus geen volgende tekstpagina over het beeld tekent.
      00518A 75 32 00         [24]  400         mov     0x32,#0
      00518D 75 33 00         [24]  401         mov     0x33,#0
