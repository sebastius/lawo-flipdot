      00553B 02r55r4A         [24] 1063         ljmp    put_ch
                                   1064 
      00553E 54 0F            [12] 1065 hexch:  anl     a,#0x0F
      005540 B4 0A 00         [24] 1066         cjne    a,#10,hx_c
      005543 40 02            [24] 1067 hx_c:   jc      hx_d
