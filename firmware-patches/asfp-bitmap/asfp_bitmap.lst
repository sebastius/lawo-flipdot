      00528F FB               [12]  581         mov     r3,a
      005290 12r53rF4         [24]  582         lcall   getdig
      005293 40 46            [24]  583         jc      px_end
      005295 2B               [12]  584         add     a,r3
      005296 FB               [12]  585         mov     r3,a                    ; y
      005297 E0               [24]  586         movx    a,@dptr
      005298 A3               [24]  587         inc     dptr
      005299 64 30            [12]  588         xrl     a,#0x30                 ; '0' -> 0, '1' -> 1
      00529B FA               [12]  589         mov     r2,a
      00529C C3               [12]  590         clr     c
      00529D 94 02            [12]  591         subb    a,#2
      00529F 50 3A            [24]  592         jnc     px_end
      0052A1 C0 82            [24]  593         push    dpl
      0052A3 C0 83            [24]  594         push    dph
      0052A5 12r53rDD         [24]  595         lcall   x_lt_width
