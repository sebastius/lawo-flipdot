                                    843 ; cijfer op @dptr -> a (0..9), dptr++; C = 1 als geen cijfer
      0053EE                        844 getdig:
      0053EE E0               [24]  845         movx    a,@dptr
      0053EF A3               [24]  846         inc     dptr
      0053F0 C3               [12]  847         clr     c
      0053F1 94 30            [12]  848         subb    a,#0x30
      0053F3 40 05            [24]  849         jc      gd_bad
      0053F5 B4 0A 00         [24]  850         cjne    a,#10,gd_cmp
      0053F8 B3               [12]  851 gd_cmp: cpl     c                       ; C was 1 als a < 10
      0053F9 22               [24]  852         ret
      0053FA D3               [12]  853 gd_bad: setb    c
      0053FB 22               [24]  854         ret
