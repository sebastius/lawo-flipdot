                                   1016 ; volgorde van de 28 bytes in het aD-antwoord (zie README)
      0054EC                       1017 diag_tab:
      0054EC 0E 02 0E 03           1018         .db     >Q_HEAD, <Q_HEAD,       >Q_TAIL, <Q_TAIL
      0054F0 0E 00 0E 01           1019         .db     >BM_FLAG, <BM_FLAG,     >FULL_REQ, <FULL_REQ
      0054F4 0E 05 0E 06           1020         .db     >DIRTY_MIN, <DIRTY_MIN, >DIRTY_MAX, <DIRTY_MAX
      0054F8 05 71 05 54           1021         .db     >REQ, <REQ,             >DISP_BUSY, <DISP_BUSY
      0054FC 0E 07 0E 08           1022         .db     >CNT_POLL5, <CNT_POLL5, >CNT_ITEMS, <CNT_ITEMS
      005500 0E 09 0E 0A 0E 0B     1023         .db     >CNT_FR, <CNT_FR,       >CNT_DOT_H, <CNT_DOT_H, >CNT_DOT_L, <CNT_DOT_L
      005506 FE 10 FE 11           1024         .db     0xFE, 0x10,  0xFE, 0x11                         ; rijmasker-pointer
      00550A FE 20 FE 21 FE 22     1025         .db     0xFE, 0x20,  0xFE, 0x21,  0xFE, 0x22            ; bitvariabelen
      005510 FD 00                 1026         .db     0xFD, 0x00                                      ; P1
      005512 05 5C 05 5D           1027         .db     >WIDTH, <WIDTH,         >HEIGHT, <HEIGHT
      005516 00 10                 1028         .db     0x00, 0x10                                      ; xdata 0x0010 (timer-isr)
      005518 05 88 05 89           1029         .db     >(FB_NEW+10), <(FB_NEW+10), >(FB_NEW+11), <(FB_NEW+11)   ; kolom 5
      00551C 07 B8 07 B9           1030         .db     >(FB_OLD+10), <(FB_OLD+10), >(FB_OLD+11), <(FB_OLD+11)
      005520 0E 1A 0E 1B           1031         .db     >(SH+10), <(SH+10),     >(SH+11), <(SH+11)
      005524 FF FF                 1032         .db     0xFF, 0xFF
