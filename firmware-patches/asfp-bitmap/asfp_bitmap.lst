      005420 40 1D            [24]  892         jc      gh_bad
      005422 B4 0A 00         [24]  893         cjne    a,#10,gh_c1
      005425 40 16            [24]  894 gh_c1:  jc      gh_ok                   ; '0'..'9'
      005427 C3               [12]  895         clr     c
      005428 94 11            [12]  896         subb    a,#17                   ; 'A' -> 0
      00542A 40 13            [24]  897         jc      gh_bad
      00542C B4 06 00         [24]  898         cjne    a,#6,gh_c2
      00542F 40 0A            [24]  899 gh_c2:  jc      gh_let                  ; 'A'..'F'
      005431 C3               [12]  900         clr     c
      005432 94 20            [12]  901         subb    a,#32                   ; 'a' -> 0
      005434 40 09            [24]  902         jc      gh_bad
      005436 B4 06 00         [24]  903         cjne    a,#6,gh_c3
      005439 50 04            [24]  904 gh_c3:  jnc     gh_bad
      00543B 24 0A            [12]  905 gh_let: add     a,#10
      00543D C3               [12]  906 gh_ok:  clr     c
      00543E 22               [24]  907         ret
      00543F D3               [12]  908 gh_bad: setb    c
      005440 22               [24]  909         ret
