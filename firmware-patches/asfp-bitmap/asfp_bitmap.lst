      0054CF 40 02            [24] 1004 hx_c:   jc      hx_d
      0054D1 24 07            [12] 1005         add     a,#7
      0054D3 24 30            [12] 1006 hx_d:   add     a,#0x30
      0054D5 22               [24] 1007         ret
