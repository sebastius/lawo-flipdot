      005429 EC               [12]  862         mov     a,r4
      00542A C3               [12]  863         clr     c
      00542B 98               [12]  864         subb    a,r0
      00542C 50 02            [24]  865         jnc     md_max                  ; r4 >= min
      00542E EC               [12]  866         mov     a,r4
      00542F F0               [24]  867         movx    @dptr,a
      005430 A3               [24]  868 md_max: inc     dptr                    ; DIRTY_MAX
      005431 E0               [24]  869         movx    a,@dptr
      005432 C3               [12]  870         clr     c
      005433 9C               [12]  871         subb    a,r4
      005434 50 02            [24]  872         jnc     md_end                  ; max >= r4
      005436 EC               [12]  873         mov     a,r4
      005437 F0               [24]  874         movx    @dptr,a
      005438 22               [24]  875 md_end: ret
                                    876 
                                    877 ; C = 1 als r4 <= DIRTY_MAX en r4 < breedte
