      0053BA EC               [12]  792         mov     a,r4
      0053BB C3               [12]  793         clr     c
      0053BC 98               [12]  794         subb    a,r0
      0053BD 50 02            [24]  795         jnc     md_max                  ; r4 >= min
      0053BF EC               [12]  796         mov     a,r4
      0053C0 F0               [24]  797         movx    @dptr,a
      0053C1 A3               [24]  798 md_max: inc     dptr                    ; DIRTY_MAX
      0053C2 E0               [24]  799         movx    a,@dptr
      0053C3 C3               [12]  800         clr     c
      0053C4 9C               [12]  801         subb    a,r4
      0053C5 50 02            [24]  802         jnc     md_end                  ; max >= r4
      0053C7 EC               [12]  803         mov     a,r4
      0053C8 F0               [24]  804         movx    @dptr,a
      0053C9 22               [24]  805 md_end: ret
                                    806 
                                    807 ; C = 1 als r4 <= DIRTY_MAX en r4 < breedte
      0053CA                        808 in_range:
