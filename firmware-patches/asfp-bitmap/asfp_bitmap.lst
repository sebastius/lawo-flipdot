                                    934 ; ---------- diagnose: "aD" + hex van de bytes uit diag_tab (seriële interrupt) ----------
                                    935 ; tabel: 2 bytes per regel; hoog = 0xFE: iRAM (laag = adres), 0xFD: P1, 0xFF: einde, anders xdata
      00546E                        936 reply_diag:
      00546E 7A 00            [12]  937         mov     r2,#0                   ; schrijfpositie in TXBUF
      005470 74 61            [12]  938         mov     a,#0x61
      005472 12r54rDB         [24]  939         lcall   put_ch
      005475 74 44            [12]  940         mov     a,#0x44
      005477 12r54rDB         [24]  941         lcall   put_ch
      00547A 7C 00            [12]  942         mov     r4,#0                   ; tabelindex
      00547C                        943 rd_loop:
      00547C 90r54rEC         [24]  944         mov     dptr,#diag_tab
      00547F EC               [12]  945         mov     a,r4
      005480 93               [24]  946         movc    a,@a+dptr
      005481 FD               [12]  947         mov     r5,a
      005482 0C               [12]  948         inc     r4
      005483 EC               [12]  949         mov     a,r4
      005484 93               [24]  950         movc    a,@a+dptr
      005485 FE               [12]  951         mov     r6,a
      005486 0C               [12]  952         inc     r4
      005487 ED               [12]  953         mov     a,r5
      005488 B4 FF 02         [24]  954         cjne    a,#0xFF,rd_x1
      00548B 80 19            [24]  955         sjmp    rd_end
      00548D B4 FE 05         [24]  956 rd_x1:  cjne    a,#0xFE,rd_x2
      005490 EE               [12]  957         mov     a,r6
      005491 F8               [12]  958         mov     r0,a
      005492 E6               [12]  959         mov     a,@r0
      005493 80 0C            [24]  960         sjmp    rd_put
      005495 B4 FD 04         [24]  961 rd_x2:  cjne    a,#0xFD,rd_x3
      005498 E5 90            [12]  962         mov     a,0x90                  ; P1
      00549A 80 05            [24]  963         sjmp    rd_put
      00549C 8D 83            [24]  964 rd_x3:  mov     dph,r5
      00549E 8E 82            [24]  965         mov     dpl,r6
      0054A0 E0               [24]  966         movx    a,@dptr
      0054A1 12r54rC0         [24]  967 rd_put: lcall   put_hex
      0054A4 80 D6            [24]  968         sjmp    rd_loop
      0054A6                        969 rd_end:
      0054A6 74 0D            [12]  970         mov     a,#CR
      0054A8 12r54rDB         [24]  971         lcall   put_ch
      0054AB EA               [12]  972         mov     a,r2                    ; r2 = lengte incl. CR
      0054AC F5 3A            [12]  973         mov     LEN_CS,a
      0054AE 04               [12]  974         inc     a                       ; + checksum
      0054AF 90 00 2F         [24]  975         mov     dptr,#TXLEN
      0054B2 F0               [24]  976         movx    @dptr,a
      0054B3 12 00 B2         [24]  977         lcall   REPLY_CS
      0054B6 D2 04            [12]  978         setb    B_TXBUSY
      0054B8 90 05 55         [24]  979         mov     dptr,#TXIDX
      0054BB E4               [12]  980         clr     a
      0054BC F0               [24]  981         movx    @dptr,a
      0054BD D2 99            [12]  982         setb    B_TI
      0054BF 22               [24]  983         ret
