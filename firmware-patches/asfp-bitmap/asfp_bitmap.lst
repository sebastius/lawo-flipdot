                                    696 ; schaduw -> gewenst beeld; bij FULL_REQ: getoond := NOT gewenst (alles verschilt)
      005349                        697 sh_to_fb:
      005349 12r53rA4         [24]  698         lcall   dirty_start
      00534C                        699 sf_loop:
      00534C 12r53rBF         [24]  700         lcall   in_range
      00534F 50 1B            [24]  701         jnc     sf_full
      005351 7E 0E            [12]  702         mov     r6,#>SH
      005353 7F 10            [12]  703         mov     r7,#<SH
      005355 12r53rD5         [24]  704         lcall   colptr
      005358 E0               [24]  705         movx    a,@dptr
      005359 FB               [12]  706         mov     r3,a
