                                    856 
                                    857 ; kolom r4 opnemen in het bereik (gebruikt a, dptr, r0)
      005424                        858 mark_dirty:
      005424 90 0E 05         [24]  859         mov     dptr,#DIRTY_MIN
      005427 E0               [24]  860         movx    a,@dptr
