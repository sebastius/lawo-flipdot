      005451 74 0D            [12]  913         mov     a,#CR
      005453 F0               [24]  914         movx    @dptr,a
      005454 75 3A 03         [24]  915         mov     LEN_CS,#3
      005457 12 00 B2         [24]  916         lcall   REPLY_CS
      00545A 90 00 2F         [24]  917         mov     dptr,#TXLEN
      00545D 74 04            [12]  918         mov     a,#4
      00545F F0               [24]  919         movx    @dptr,a
      005460 D2 04            [12]  920         setb    B_TXBUSY
      005462 90 05 55         [24]  921         mov     dptr,#TXIDX
      005465 E4               [12]  922         clr     a
      005466 F0               [24]  923         movx    @dptr,a
      005467 D2 99            [12]  924         setb    B_TI
      005469 22               [24]  925         ret
