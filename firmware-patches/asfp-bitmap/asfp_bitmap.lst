                                    771 ; cijfer op @dptr -> a (0..9), dptr++; C = 1 als geen cijfer
      005380                        772 getdig:
      005380 E0               [24]  773         movx    a,@dptr
      005381 A3               [24]  774         inc     dptr
      005382 C3               [12]  775         clr     c
      005383 94 30            [12]  776         subb    a,#0x30
      005385 40 05            [24]  777         jc      gd_bad
      005387 B4 0A 00         [24]  778         cjne    a,#10,gd_cmp
      00538A B3               [12]  779 gd_cmp: cpl     c                       ; C was 1 als a < 10
      00538B 22               [24]  780         ret
      00538C D3               [12]  781 gd_bad: setb    c
      00538D 22               [24]  782         ret
                                    783 
                                    784 ; drie cijfers -> a (0..255); C = 1 bij fout of > 255
      00538E                        785 getnum3:
      00538E 12r53r80         [24]  786         lcall   getdig
      005391 40 1D            [24]  787         jc      gn_bad
      005393 75 F0 64         [24]  788         mov     b,#100
      005396 A4               [48]  789         mul     ab
      005397 F8               [12]  790         mov     r0,a
      005398 E5 F0            [12]  791         mov     a,b
      00539A 70 14            [24]  792         jnz     gn_bad
      00539C 12r53r80         [24]  793         lcall   getdig
      00539F 40 0F            [24]  794         jc      gn_bad
      0053A1 75 F0 0A         [24]  795         mov     b,#10
      0053A4 A4               [48]  796         mul     ab
      0053A5 28               [12]  797         add     a,r0
      0053A6 40 08            [24]  798         jc      gn_bad
      0053A8 F8               [12]  799         mov     r0,a
      0053A9 12r53r80         [24]  800         lcall   getdig
      0053AC 40 02            [24]  801         jc      gn_bad
      0053AE 28               [12]  802         add     a,r0
      0053AF 22               [24]  803         ret                             ; C uit add: 1 bij overloop
      0053B0 D3               [12]  804 gn_bad: setb    c
      0053B1 22               [24]  805         ret
