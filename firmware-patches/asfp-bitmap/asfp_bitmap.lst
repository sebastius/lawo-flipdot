      005473 A4               [48]  931         mul     ab
      005474 F8               [12]  932         mov     r0,a
      005475 E5 F0            [12]  933         mov     a,b
      005477 70 14            [24]  934         jnz     gn_bad
      005479 12r54r5D         [24]  935         lcall   getdig
      00547C 40 0F            [24]  936         jc      gn_bad
      00547E 75 F0 0A         [24]  937         mov     b,#10
      005481 A4               [48]  938         mul     ab
      005482 28               [12]  939         add     a,r0
      005483 40 08            [24]  940         jc      gn_bad
      005485 F8               [12]  941         mov     r0,a
      005486 12r54r5D         [24]  942         lcall   getdig
      005489 40 02            [24]  943         jc      gn_bad
      00548B 28               [12]  944         add     a,r0
      00548C 22               [24]  945         ret                             ; C uit add: 1 bij overloop
      00548D D3               [12]  946 gn_bad: setb    c
      00548E 22               [24]  947         ret
                                    948 
                                    949 ; hexteken op @dptr -> a (0..15), dptr++; C = 1 als ongeldig
      00548F                        950 gethex:
      00548F E0               [24]  951         movx    a,@dptr
      005490 A3               [24]  952         inc     dptr
      005491 C3               [12]  953         clr     c
      005492 94 30            [12]  954         subb    a,#0x30
      005494 40 1D            [24]  955         jc      gh_bad
      005496 B4 0A 00         [24]  956         cjne    a,#10,gh_c1
      005499 40 16            [24]  957 gh_c1:  jc      gh_ok                   ; '0'..'9'
      00549B C3               [12]  958         clr     c
      00549C 94 11            [12]  959         subb    a,#17                   ; 'A' -> 0
      00549E 40 13            [24]  960         jc      gh_bad
      0054A0 B4 06 00         [24]  961         cjne    a,#6,gh_c2
      0054A3 40 0A            [24]  962 gh_c2:  jc      gh_let                  ; 'A'..'F'
      0054A5 C3               [12]  963         clr     c
      0054A6 94 20            [12]  964         subb    a,#32                   ; 'a' -> 0
      0054A8 40 09            [24]  965         jc      gh_bad
      0054AA B4 06 00         [24]  966         cjne    a,#6,gh_c3
      0054AD 50 04            [24]  967 gh_c3:  jnc     gh_bad
      0054AF 24 0A            [12]  968 gh_let: add     a,#10
      0054B1 C3               [12]  969 gh_ok:  clr     c
      0054B2 22               [24]  970         ret
      0054B3 D3               [12]  971 gh_bad: setb    c
      0054B4 22               [24]  972         ret
