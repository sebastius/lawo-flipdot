                                   1072 ; a naar TXBUF[r2], r2++
      00554A                       1073 put_ch:
      00554A C0 E0            [24] 1074         push    acc
      00554C EA               [12] 1075         mov     a,r2
      00554D 24 1E            [12] 1076         add     a,#<TXBUF
      00554F F5 82            [12] 1077         mov     dpl,a
      005551 E4               [12] 1078         clr     a
      005552 34 03            [12] 1079         addc    a,#>TXBUF
      005554 F5 83            [12] 1080         mov     dph,a
      005556 D0 E0            [24] 1081         pop     acc
      005558 F0               [24] 1082         movx    @dptr,a
      005559 0A               [12] 1083         inc     r2
      00555A 22               [24] 1084         ret
