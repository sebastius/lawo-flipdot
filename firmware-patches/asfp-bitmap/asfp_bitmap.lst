      00543F 40 09            [24]  904         jc      gh_bad
      005441 B4 06 00         [24]  905         cjne    a,#6,gh_c3
      005444 50 04            [24]  906 gh_c3:  jnc     gh_bad
      005446 24 0A            [12]  907 gh_let: add     a,#10
      005448 C3               [12]  908 gh_ok:  clr     c
      005449 22               [24]  909         ret
      00544A D3               [12]  910 gh_bad: setb    c
      00544B 22               [24]  911         ret
