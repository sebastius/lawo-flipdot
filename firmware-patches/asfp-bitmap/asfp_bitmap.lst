                                    807 ; hexteken op @dptr -> a (0..15), dptr++; C = 1 als ongeldig
      0053B2                        808 gethex:
      0053B2 E0               [24]  809         movx    a,@dptr
      0053B3 A3               [24]  810         inc     dptr
      0053B4 C3               [12]  811         clr     c
      0053B5 94 30            [12]  812         subb    a,#0x30
      0053B7 40 1D            [24]  813         jc      gh_bad
      0053B9 B4 0A 00         [24]  814         cjne    a,#10,gh_c1
      0053BC 40 16            [24]  815 gh_c1:  jc      gh_ok                   ; '0'..'9'
      0053BE C3               [12]  816         clr     c
      0053BF 94 11            [12]  817         subb    a,#17                   ; 'A' -> 0
      0053C1 40 13            [24]  818         jc      gh_bad
      0053C3 B4 06 00         [24]  819         cjne    a,#6,gh_c2
      0053C6 40 0A            [24]  820 gh_c2:  jc      gh_let                  ; 'A'..'F'
      0053C8 C3               [12]  821         clr     c
      0053C9 94 20            [12]  822         subb    a,#32                   ; 'a' -> 0
      0053CB 40 09            [24]  823         jc      gh_bad
      0053CD B4 06 00         [24]  824         cjne    a,#6,gh_c3
      0053D0 50 04            [24]  825 gh_c3:  jnc     gh_bad
      0053D2 24 0A            [12]  826 gh_let: add     a,#10
      0053D4 C3               [12]  827 gh_ok:  clr     c
      0053D5 22               [24]  828         ret
      0053D6 D3               [12]  829 gh_bad: setb    c
      0053D7 22               [24]  830         ret
