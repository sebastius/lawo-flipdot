                                    840 ; drie cijfers -> a (0..255); C = 1 bij fout of > 255
      0053F1                        841 getnum3:
      0053F1 12r53rE3         [24]  842         lcall   getdig
      0053F4 40 1D            [24]  843         jc      gn_bad
      0053F6 75 F0 64         [24]  844         mov     b,#100
      0053F9 A4               [48]  845         mul     ab
      0053FA F8               [12]  846         mov     r0,a
      0053FB E5 F0            [12]  847         mov     a,b
      0053FD 70 14            [24]  848         jnz     gn_bad
      0053FF 12r53rE3         [24]  849         lcall   getdig
      005402 40 0F            [24]  850         jc      gn_bad
      005404 75 F0 0A         [24]  851         mov     b,#10
      005407 A4               [48]  852         mul     ab
      005408 28               [12]  853         add     a,r0
      005409 40 08            [24]  854         jc      gn_bad
      00540B F8               [12]  855         mov     r0,a
      00540C 12r53rE3         [24]  856         lcall   getdig
      00540F 40 02            [24]  857         jc      gn_bad
      005411 28               [12]  858         add     a,r0
      005412 22               [24]  859         ret                             ; C uit add: 1 bij overloop
      005413 D3               [12]  860 gn_bad: setb    c
      005414 22               [24]  861         ret
