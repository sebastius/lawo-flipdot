                                    943 ; ---------- diagnose: "aD" + hex van de bytes uit diag_tab (seriële interrupt) ----------
                                    944 ; tabel: 2 bytes per regel; hoog = 0xFE: iRAM (laag = adres), 0xFD: P1, 0xFF: einde, anders xdata
      005474                        945 reply_diag:
      005474 7A 00            [12]  946         mov     r2,#0                   ; schrijfpositie in TXBUF
      005476 74 61            [12]  947         mov     a,#0x61
      005478 12r54rE1         [24]  948         lcall   put_ch
      00547B 74 44            [12]  949         mov     a,#0x44
      00547D 12r54rE1         [24]  950         lcall   put_ch
      005480 7C 00            [12]  951         mov     r4,#0                   ; tabelindex
      005482                        952 rd_loop:
      005482 90r54rF2         [24]  953         mov     dptr,#diag_tab
      005485 EC               [12]  954         mov     a,r4
      005486 93               [24]  955         movc    a,@a+dptr
      005487 FD               [12]  956         mov     r5,a
      005488 0C               [12]  957         inc     r4
      005489 EC               [12]  958         mov     a,r4
      00548A 93               [24]  959         movc    a,@a+dptr
      00548B FE               [12]  960         mov     r6,a
      00548C 0C               [12]  961         inc     r4
      00548D ED               [12]  962         mov     a,r5
      00548E B4 FF 02         [24]  963         cjne    a,#0xFF,rd_x1
      005491 80 19            [24]  964         sjmp    rd_end
      005493 B4 FE 05         [24]  965 rd_x1:  cjne    a,#0xFE,rd_x2
      005496 EE               [12]  966         mov     a,r6
      005497 F8               [12]  967         mov     r0,a
      005498 E6               [12]  968         mov     a,@r0
      005499 80 0C            [24]  969         sjmp    rd_put
      00549B B4 FD 04         [24]  970 rd_x2:  cjne    a,#0xFD,rd_x3
      00549E E5 90            [12]  971         mov     a,0x90                  ; P1
      0054A0 80 05            [24]  972         sjmp    rd_put
      0054A2 8D 83            [24]  973 rd_x3:  mov     dph,r5
      0054A4 8E 82            [24]  974         mov     dpl,r6
      0054A6 E0               [24]  975         movx    a,@dptr
      0054A7 12r54rC6         [24]  976 rd_put: lcall   put_hex
      0054AA 80 D6            [24]  977         sjmp    rd_loop
      0054AC                        978 rd_end:
      0054AC 74 0D            [12]  979         mov     a,#CR
      0054AE 12r54rE1         [24]  980         lcall   put_ch
      0054B1 EA               [12]  981         mov     a,r2                    ; r2 = lengte incl. CR
      0054B2 F5 3A            [12]  982         mov     LEN_CS,a
      0054B4 04               [12]  983         inc     a                       ; + checksum
      0054B5 90 00 2F         [24]  984         mov     dptr,#TXLEN
      0054B8 F0               [24]  985         movx    @dptr,a
      0054B9 12 00 B2         [24]  986         lcall   REPLY_CS
      0054BC D2 04            [12]  987         setb    B_TXBUSY
      0054BE 90 05 55         [24]  988         mov     dptr,#TXIDX
      0054C1 E4               [12]  989         clr     a
      0054C2 F0               [24]  990         movx    @dptr,a
      0054C3 D2 99            [12]  991         setb    B_TI
      0054C5 22               [24]  992         ret
