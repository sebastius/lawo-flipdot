                                    559 ; ---------- hulproutines ----------
                                    560 ; C = 1 als r4 < breedte (gebruikt dptr, r1)
      00528A                        561 x_lt_width:
      00528A 90 05 5C         [24]  562         mov     dptr,#WIDTH
      00528D E0               [24]  563         movx    a,@dptr
      00528E F9               [12]  564         mov     r1,a
      00528F EC               [12]  565         mov     a,r4
      005290 C3               [12]  566         clr     c
      005291 99               [12]  567         subb    a,r1
      005292 22               [24]  568         ret
                                    569 
                                    570 ; dptr = (r6:r7) + 2*r4
      005293                        571 colptr:
      005293 EC               [12]  572         mov     a,r4
      005294 2C               [12]  573         add     a,r4
      005295 F8               [12]  574         mov     r0,a
      005296 E4               [12]  575         clr     a
      005297 33               [12]  576         rlc     a
      005298 C8               [12]  577         xch     a,r0                    ; a = laag, r0 = hoog
      005299 2F               [12]  578         add     a,r7
      00529A F5 82            [12]  579         mov     dpl,a
      00529C E8               [12]  580         mov     a,r0
      00529D 3E               [12]  581         addc    a,r6
      00529E F5 83            [12]  582         mov     dph,a
      0052A0 22               [24]  583         ret
                                    584 
                                    585 ; cijfer op @dptr -> a (0..9), dptr++; C = 1 als geen cijfer
      0052A1                        586 getdig:
      0052A1 E0               [24]  587         movx    a,@dptr
      0052A2 A3               [24]  588         inc     dptr
      0052A3 C3               [12]  589         clr     c
      0052A4 94 30            [12]  590         subb    a,#0x30
      0052A6 40 05            [24]  591         jc      gd_bad
      0052A8 B4 0A 00         [24]  592         cjne    a,#10,gd_cmp
      0052AB B3               [12]  593 gd_cmp: cpl     c                       ; C was 1 als a < 10
      0052AC 22               [24]  594         ret
      0052AD D3               [12]  595 gd_bad: setb    c
      0052AE 22               [24]  596         ret
                                    597 
                                    598 ; drie cijfers -> a (0..255); C = 1 bij fout of > 255
      0052AF                        599 getnum3:
      0052AF 12r52rA1         [24]  600         lcall   getdig
      0052B2 40 1D            [24]  601         jc      gn_bad
      0052B4 75 F0 64         [24]  602         mov     b,#100
      0052B7 A4               [48]  603         mul     ab
      0052B8 F8               [12]  604         mov     r0,a
      0052B9 E5 F0            [12]  605         mov     a,b
      0052BB 70 14            [24]  606         jnz     gn_bad
      0052BD 12r52rA1         [24]  607         lcall   getdig
      0052C0 40 0F            [24]  608         jc      gn_bad
      0052C2 75 F0 0A         [24]  609         mov     b,#10
      0052C5 A4               [48]  610         mul     ab
      0052C6 28               [12]  611         add     a,r0
      0052C7 40 08            [24]  612         jc      gn_bad
      0052C9 F8               [12]  613         mov     r0,a
      0052CA 12r52rA1         [24]  614         lcall   getdig
      0052CD 40 02            [24]  615         jc      gn_bad
      0052CF 28               [12]  616         add     a,r0
      0052D0 22               [24]  617         ret                             ; C uit add: 1 bij overloop
      0052D1 D3               [12]  618 gn_bad: setb    c
      0052D2 22               [24]  619         ret
                                    620 
                                    621 ; hexteken op @dptr -> a (0..15), dptr++; C = 1 als ongeldig
      0052D3                        622 gethex:
      0052D3 E0               [24]  623         movx    a,@dptr
      0052D4 A3               [24]  624         inc     dptr
      0052D5 C3               [12]  625         clr     c
      0052D6 94 30            [12]  626         subb    a,#0x30
      0052D8 40 1D            [24]  627         jc      gh_bad
      0052DA B4 0A 00         [24]  628         cjne    a,#10,gh_c1
      0052DD 40 16            [24]  629 gh_c1:  jc      gh_ok                   ; '0'..'9'
      0052DF C3               [12]  630         clr     c
      0052E0 94 11            [12]  631         subb    a,#17                   ; 'A' -> 0
      0052E2 40 13            [24]  632         jc      gh_bad
      0052E4 B4 06 00         [24]  633         cjne    a,#6,gh_c2
      0052E7 40 0A            [24]  634 gh_c2:  jc      gh_let                  ; 'A'..'F'
      0052E9 C3               [12]  635         clr     c
      0052EA 94 20            [12]  636         subb    a,#32                   ; 'a' -> 0
      0052EC 40 09            [24]  637         jc      gh_bad
      0052EE B4 06 00         [24]  638         cjne    a,#6,gh_c3
      0052F1 50 04            [24]  639 gh_c3:  jnc     gh_bad
      0052F3 24 0A            [12]  640 gh_let: add     a,#10
      0052F5 C3               [12]  641 gh_ok:  clr     c
      0052F6 22               [24]  642         ret
      0052F7 D3               [12]  643 gh_bad: setb    c
      0052F8 22               [24]  644         ret
