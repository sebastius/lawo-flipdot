                                    918 ; ---------- diagnose: "aD" + hex van de bytes uit diag_tab (seriële interrupt) ----------
                                    919 ; tabel: 2 bytes per regel; hoog = 0xFE: iRAM (laag = adres), 0xFD: P1, 0xFF: einde, anders xdata
      005463                        920 reply_diag:
      005463 7A 00            [12]  921         mov     r2,#0                   ; schrijfpositie in TXBUF
      005465 74 61            [12]  922         mov     a,#0x61
      005467 12r54rD0         [24]  923         lcall   put_ch
      00546A 74 44            [12]  924         mov     a,#0x44
      00546C 12r54rD0         [24]  925         lcall   put_ch
      00546F 7C 00            [12]  926         mov     r4,#0                   ; tabelindex
      005471                        927 rd_loop:
      005471 90r54rE1         [24]  928         mov     dptr,#diag_tab
      005474 EC               [12]  929         mov     a,r4
      005475 93               [24]  930         movc    a,@a+dptr
      005476 FD               [12]  931         mov     r5,a
      005477 0C               [12]  932         inc     r4
      005478 EC               [12]  933         mov     a,r4
      005479 93               [24]  934         movc    a,@a+dptr
      00547A FE               [12]  935         mov     r6,a
      00547B 0C               [12]  936         inc     r4
      00547C ED               [12]  937         mov     a,r5
      00547D B4 FF 02         [24]  938         cjne    a,#0xFF,rd_x1
      005480 80 19            [24]  939         sjmp    rd_end
      005482 B4 FE 05         [24]  940 rd_x1:  cjne    a,#0xFE,rd_x2
      005485 EE               [12]  941         mov     a,r6
      005486 F8               [12]  942         mov     r0,a
      005487 E6               [12]  943         mov     a,@r0
      005488 80 0C            [24]  944         sjmp    rd_put
      00548A B4 FD 04         [24]  945 rd_x2:  cjne    a,#0xFD,rd_x3
      00548D E5 90            [12]  946         mov     a,0x90                  ; P1
      00548F 80 05            [24]  947         sjmp    rd_put
      005491 8D 83            [24]  948 rd_x3:  mov     dph,r5
      005493 8E 82            [24]  949         mov     dpl,r6
      005495 E0               [24]  950         movx    a,@dptr
      005496 12r54rB5         [24]  951 rd_put: lcall   put_hex
      005499 80 D6            [24]  952         sjmp    rd_loop
      00549B                        953 rd_end:
      00549B 74 0D            [12]  954         mov     a,#CR
      00549D 12r54rD0         [24]  955         lcall   put_ch
      0054A0 EA               [12]  956         mov     a,r2                    ; r2 = lengte incl. CR
      0054A1 F5 3A            [12]  957         mov     LEN_CS,a
      0054A3 04               [12]  958         inc     a                       ; + checksum
      0054A4 90 00 2F         [24]  959         mov     dptr,#TXLEN
      0054A7 F0               [24]  960         movx    @dptr,a
      0054A8 12 00 B2         [24]  961         lcall   REPLY_CS
      0054AB D2 04            [12]  962         setb    B_TXBUSY
      0054AD 90 05 55         [24]  963         mov     dptr,#TXIDX
      0054B0 E4               [12]  964         clr     a
      0054B1 F0               [24]  965         movx    @dptr,a
      0054B2 D2 99            [12]  966         setb    B_TI
      0054B4 22               [24]  967         ret
