                                    994 ; a als twee hextekens naar TXBUF (gebruikt r3)
      0054C6                        995 put_hex:
      0054C6 FB               [12]  996         mov     r3,a
      0054C7 C4               [12]  997         swap    a
      0054C8 12r54rD5         [24]  998         lcall   hexch
      0054CB 12r54rE1         [24]  999         lcall   put_ch
      0054CE EB               [12] 1000         mov     a,r3
      0054CF 12r54rD5         [24] 1001         lcall   hexch
      0054D2 02r54rE1         [24] 1002         ljmp    put_ch
                                   1003 
      0054D5 54 0F            [12] 1004 hexch:  anl     a,#0x0F
      0054D7 B4 0A 00         [24] 1005         cjne    a,#10,hx_c
      0054DA 40 02            [24] 1006 hx_c:   jc      hx_d
      0054DC 24 07            [12] 1007         add     a,#7
      0054DE 24 30            [12] 1008 hx_d:   add     a,#0x30
      0054E0 22               [24] 1009         ret
