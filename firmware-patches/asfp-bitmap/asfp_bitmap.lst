      005444 F0               [24]  895         movx    @dptr,a
      005445 A3               [24]  896         inc     dptr
      005446 74 0D            [12]  897         mov     a,#CR
      005448 F0               [24]  898         movx    @dptr,a
      005449 75 3A 03         [24]  899         mov     LEN_CS,#3
      00544C 12 00 B2         [24]  900         lcall   REPLY_CS
      00544F 90 00 2F         [24]  901         mov     dptr,#TXLEN
      005452 74 04            [12]  902         mov     a,#4
      005454 F0               [24]  903         movx    @dptr,a
      005455 D2 04            [12]  904         setb    B_TXBUSY
      005457 90 05 55         [24]  905         mov     dptr,#TXIDX
      00545A E4               [12]  906         clr     a
      00545B F0               [24]  907         movx    @dptr,a
      00545C D2 99            [12]  908         setb    B_TI
      00545E 22               [24]  909         ret
