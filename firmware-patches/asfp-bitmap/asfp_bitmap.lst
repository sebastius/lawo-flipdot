      0054DF 74 61            [12] 1008         mov     a,#0x61
      0054E1 12r55r4A         [24] 1009         lcall   put_ch
      0054E4 74 44            [12] 1010         mov     a,#0x44
      0054E6 12r55r4A         [24] 1011         lcall   put_ch
      0054E9 7C 00            [12] 1012         mov     r4,#0                   ; tabelindex
      0054EB                       1013 rd_loop:
      0054EB 90r55r5B         [24] 1014         mov     dptr,#diag_tab
      0054EE EC               [12] 1015         mov     a,r4
      0054EF 93               [24] 1016         movc    a,@a+dptr
      0054F0 FD               [12] 1017         mov     r5,a
      0054F1 0C               [12] 1018         inc     r4
      0054F2 EC               [12] 1019         mov     a,r4
      0054F3 93               [24] 1020         movc    a,@a+dptr
      0054F4 FE               [12] 1021         mov     r6,a
      0054F5 0C               [12] 1022         inc     r4
      0054F6 ED               [12] 1023         mov     a,r5
      0054F7 B4 FF 02         [24] 1024         cjne    a,#0xFF,rd_x1
      0054FA 80 19            [24] 1025         sjmp    rd_end
      0054FC B4 FE 05         [24] 1026 rd_x1:  cjne    a,#0xFE,rd_x2
      0054FF EE               [12] 1027         mov     a,r6
      005500 F8               [12] 1028         mov     r0,a
      005501 E6               [12] 1029         mov     a,@r0
      005502 80 0C            [24] 1030         sjmp    rd_put
      005504 B4 FD 04         [24] 1031 rd_x2:  cjne    a,#0xFD,rd_x3
      005507 E5 90            [12] 1032         mov     a,0x90                  ; P1
      005509 80 05            [24] 1033         sjmp    rd_put
      00550B 8D 83            [24] 1034 rd_x3:  mov     dph,r5
      00550D 8E 82            [24] 1035         mov     dpl,r6
      00550F E0               [24] 1036         movx    a,@dptr
      005510 12r55r2F         [24] 1037 rd_put: lcall   put_hex
      005513 80 D6            [24] 1038         sjmp    rd_loop
      005515                       1039 rd_end:
      005515 74 0D            [12] 1040         mov     a,#CR
      005517 12r55r4A         [24] 1041         lcall   put_ch
      00551A EA               [12] 1042         mov     a,r2                    ; r2 = lengte incl. CR
      00551B F5 3A            [12] 1043         mov     LEN_CS,a
      00551D 04               [12] 1044         inc     a                       ; + checksum
      00551E 90 00 2F         [24] 1045         mov     dptr,#TXLEN
      005521 F0               [24] 1046         movx    @dptr,a
      005522 12 00 B2         [24] 1047         lcall   REPLY_CS
      005525 D2 04            [12] 1048         setb    B_TXBUSY
      005527 90 05 55         [24] 1049         mov     dptr,#TXIDX
      00552A E4               [12] 1050         clr     a
      00552B F0               [24] 1051         movx    @dptr,a
      00552C D2 99            [12] 1052         setb    B_TI
      00552E 22               [24] 1053         ret
