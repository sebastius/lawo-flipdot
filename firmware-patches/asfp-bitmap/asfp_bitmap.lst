                                    611 ; ---------- aB: kolommen in de schaduw ----------
      0052CE                        612 do_bitmap:
      0052CE 12r53rF1         [24]  613         lcall   getnum3
      0052D1 40 41            [24]  614         jc      bm_end
      0052D3 FC               [12]  615         mov     r4,a                    ; startkolom
      0052D4                        616 bm_loop:
      0052D4 E0               [24]  617         movx    a,@dptr
      0052D5 B4 0D 01         [24]  618         cjne    a,#CR,bm_go
      0052D8 22               [24]  619         ret
      0052D9                        620 bm_go:
      0052D9 12r54r15         [24]  621         lcall   gethex
      0052DC 40 36            [24]  622         jc      bm_end
